/build/
build/

# ctest output directory. Not under build/ -- created when running ctest
# directly in a source directory, so build/ rules do not cover it.
#
# No leading slash: `/Testing/` only matches the repo root and misses
# `layout/Testing/`. Unanchored `Testing/` matches at any depth.
Testing/

# ── Rust ─────────────────────────────────────────────
*target/

# ── Common compiled artifacts ────────────────────────
*.o
*.a
*.lib
bench/iops/.run/

