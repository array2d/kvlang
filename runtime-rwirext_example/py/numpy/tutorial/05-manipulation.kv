// numpy 第五类：manipulation（形状变换）
// extern: 需 numpy 扩展引擎驱动
//   python runtime-rwirext_example/py/numpy/numpy.py tutorial/14-numpy/05-manipulation.kv
// 期望输出:
//   m: [[0, 1, 2], [3, 4, 5]]
//   transpose: [[0, 3], [1, 4], [2, 5]]
//   ravel: [0, 3, 1, 4, 2, 5]
//   concatenate: [1, 2, 3, 4, 5, 6]
//   stack: [[1, 2, 3], [4, 5, 6]]
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> r
		numpy.reshape(r, [2, 3]) -> m
		numpy.print("m:", m)
		numpy.transpose(m) -> t
		numpy.print("transpose:", t)
		numpy.ravel(t) -> f
		numpy.print("ravel:", f)
		a:[]int64 = [1, 2, 3]
		b:[]int64 = [4, 5, 6]
		numpy.concatenate(a, b) -> c
		numpy.print("concatenate:", c)
		numpy.stack(a, b) -> s
		numpy.print("stack:", s)
	}
}
demo.main()
