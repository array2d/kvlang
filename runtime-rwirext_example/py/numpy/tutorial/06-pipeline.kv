# numpy 综合：一个线性层 y = relu(W·x + b)，串起五大类算子
# extern: 需 numpy 扩展引擎驱动
#   python runtime-rwirext_example/py/numpy/numpy.py tutorial/14-numpy/06-pipeline.kv
# 创建(arange/reshape/ones/zeros) → matmul → elementwise(add/maximum) → reduce(sum/mean)
# 期望输出:
#   W: [[0, 1, 2], [3, 4, 5]]
#   x: [0, 1, 2]
#   W.x: [5, 14]
#   z = W.x + b: [6.0, 15.0]
#   y = relu(z): [6.0, 15.0]
#   sum(y): 21.0
#   mean(y): 10.5
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> a
		numpy.reshape(a, [2, 3]) -> w
		numpy.print("W:", w)
		numpy.arange(3) -> x
		numpy.print("x:", x)
		numpy.matmul(w, x) -> wx
		numpy.print("W.x:", wx)
		numpy.ones([2]) -> b
		numpy.add(wx, b) -> z
		numpy.print("z = W.x + b:", z)
		numpy.zeros([2]) -> zero
		numpy.maximum(z, zero) -> y
		numpy.print("y = relu(z):", y)
		numpy.sum(y) -> total
		numpy.print("sum(y):", total)
		numpy.mean(y) -> avg
		numpy.print("mean(y):", avg)
	}
}
demo.main()
