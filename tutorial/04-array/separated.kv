# separated: 分离数组 <>int64（scatter 拆成 arr<0>..arr<N-1> 各自 key）
# 语义: <> = 分离数组，元素分散在 key；scatter/compact 在 [] 与 <> 之间转换
# 期望输出:
#   len after scatter = 0
#   len after compact = 3
#   a[0] = 10
#   a[2] = 30
rwfunc main() -> () {
	a:[]int64 = [10, 20, 30]
	scatter(a)
	len(a) -> n1
	println("len after scatter =", n1)
	compact(a)
	len(a) -> n2
	println("len after compact =", n2)
	println("a[0] =", a[0])
	println("a[2] =", a[2])
}

main()
