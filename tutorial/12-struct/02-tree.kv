# 二叉树：非表意指针 + dict
# 待实现：需隐式 ·hex 子 key
# wip: 需要 ·hex 隐式创建实现
# 语义: t 是容器；t·root = {} 隐式建根节点 ·1，left/right 各隐式建子节点
# 期望输出:
#   root=5 left=3 right=8

t = {}
t·root = {}
t·root·val = 5

t·root·left = {}
t·root·left·val = 3

t·root·right = {}
t·root·right·val = 8

t·root·val -> a
t·root·left·val -> b
t·root·right·val -> c
println("root=", a, " left=", b, " right=", c)
