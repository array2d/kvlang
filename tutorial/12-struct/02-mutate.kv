# mutate: 实例成员可读可写
# 语义: p·field 是普通 KV 成员，创建后可用 val -> p·field 改写。
# 期望输出:
#   before x= 1  y= 2
#   after x= 5  y= 2
struct P {
	x:int64=0
	y:int64=0
}

rwfunc test() -> () {
	p = P{x=1 y=2}
	p·x -> a
	p·y -> b
	println("before x=", a, " y=", b)
	5 -> p·x
	p·x -> c
	p·y -> d
	println("after x=", c, " y=", d)
}
