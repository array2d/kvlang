// tree: 二叉树存进 map（int 键、struct 值），左右孩子用 *TNode 指针
// 语义: /tree 是 [int64]·TNode 的 map；left/right 是 *TNode（None=空指针）；
//       inorder 递归中序遍历，node 是指针，node·field 经指针解引用。
// 期望输出:
//   3
//   5
//   8
struct TNode {
	val:int64=0
	left:*TNode=None
	right:*TNode=None
}

rwfunc inorder(node:TNode) -> () {
	if (node != None) {
		node·left -> l
		inorder(l)
		node·val -> v
		println(v)
		node·right -> r
		inorder(r)
	}
}

rwfunc test() -> () {
	/tree:[int64]·TNode = {}
	/tree·1:TNode = {val=5}
	/tree·2:TNode = {val=3}
	/tree·3:TNode = {val=8}
	&/tree·2 -> /tree·1·left
	&/tree·3 -> /tree·1·right
	inorder(&/tree·1)
}
