// fields: 多类型字段 + 默认值 + 部分覆盖
// 语义: 字段声明 name:kindexpr=default；实例化只写给定字段，其余取默认；
//       类型不符或字段不存在均在 runtime 报 TypeError。
// 期望输出:
//   alice 30 true
//   anon 0 false
struct User {
	name:[]char/utf32="anon"
	age:int64=0
	active:bool=false
}

rwfunc test() -> () {
	u = User{name="alice" age=30 active=true}
	u·name -> n
	u·age -> a
	u·active -> ac
	println(n, a, ac)
	d = User{}
	d·name -> dn
	d·age -> da
	d·active -> dac
	println(dn, da, dac)
}
