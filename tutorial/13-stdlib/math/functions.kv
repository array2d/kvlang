// 期望输出:
//   sin0= 0.0
//   cos0= 1.0
//   tan0= 0.0
//   atan2= 0.7853981633974483
//   sinh0= 0.0
//   cosh0= 1.0
//   tanh0= 0.0
//   floor= 3.0
//   ceil= 4.0
//   round= 4.0
//   trunc= -3.0
//   log2= 3.0
//   log10= 2.0
//   hypot= 5.0
//   finite= true false false
//   clamp= 10 0 5
//   fclamp= 1.0 0.0 0.5
//   gcd= 6 6
//   lcm= 12 0
//   fact= 1 120
//   isqrt= 0 1 3 10
//   lerp= 15.0
//   deg_rad= 180.0
rwfunc test() -> () {
	println("sin0=", math·sin(0.0))
	println("cos0=", math·cos(0.0))
	println("tan0=", math·tan(0.0))
	println("atan2=", math·atan2(1.0, 1.0))
	println("sinh0=", math·sinh(0.0))
	println("cosh0=", math·cosh(0.0))
	println("tanh0=", math·tanh(0.0))
	println("floor=", math·floor(3.7))
	println("ceil=", math·ceil(3.2))
	println("round=", math·round(3.6))
	println("trunc=", math·trunc(-3.9))
	println("log2=", math·log2(8.0))
	println("log10=", math·log10(100.0))
	println("hypot=", math·hypot(3.0, 4.0))
	println("finite=", math·isfinite(1.5), math·isnan(1.5), math·isinf(1.5))
	println("clamp=", math·clamp(15, 0, 10), math·clamp(-5, 0, 10), math·clamp(5, 0, 10))
	println("fclamp=", math·fclamp(1.5, 0.0, 1.0), math·fclamp(-0.5, 0.0, 1.0), math·fclamp(0.5, 0.0, 1.0))
	println("gcd=", math·gcd(12, 18), math·gcd(-12, 18))
	println("lcm=", math·lcm(4, 6), math·lcm(0, 6))
	println("fact=", math·factorial(0), math·factorial(5))
	println("isqrt=", math·isqrt(0), math·isqrt(1), math·isqrt(15), math·isqrt(100))
	println("lerp=", math·lerp(10.0, 20.0, 0.5))
	/lib/math·Pi -> pi
	math·rad2deg(math·deg2rad(180.0)) -> deg
	println("deg_rad=", math·round(deg))
}
