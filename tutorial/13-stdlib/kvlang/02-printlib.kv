// kvlang·printlib：把 /lib 子树重建为可运行 kvlang —— **只看 layout 结果，不读 `.src`**
//   验法：dump 一次 → 删掉该函数的源码副本 `.src` → 再 dump，两次输出必须一致
// 期望输出:
//   before-has-fn= true
//   after-has-fn= true
//   stable= 0
lib pl_probe {
	rwfunc add(a:int64, b:int64) -> (c:int64) {
		a + b -> c
	}
}

rwfunc test() -> () {
	kvlang·printlib("/lib/pl_probe") -> before
	string·contains(before, "rwfunc add") -> h1
	println("before-has-fn=", h1)
	kvspace·del("/lib/pl_probe·add.src") -> _
	kvlang·printlib("/lib/pl_probe") -> after
	string·contains(after, "rwfunc add") -> h2
	println("after-has-fn=", h2)
	string·cmp(before, after) -> same
	println("stable=", same)
}
