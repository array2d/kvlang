// kvspace·cp：拷贝单 key，之后改 src 不影响 dst
// 期望输出:
//   dst: 10
//   src after: 20
//   dst after: 10

rwfunc test() -> () {
	10 -> "/cp_src"
	kvspace·cp("/cp_src", "/cp_dst")
	d1 = /cp_dst
	println("dst:", d1)
	20 -> "/cp_src"
	s2 = /cp_src
	d2 = /cp_dst
	println("src after:", s2)
	println("dst after:", d2)
}
