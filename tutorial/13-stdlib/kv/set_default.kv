// set_default：路径不存在时写入，已存在则保留原值（if 条件写）
// 期望输出:
//   set_default new: first_val
//   set_default existing: first_val

rwfunc test() -> () {
	if (/sd_key == None) {
		"first_val" -> "/sd_key"
	}
	sd1 = /sd_key
	println("set_default new:", sd1)
	if (/sd_key == None) {
		"second_val" -> "/sd_key"
	}
	sd2 = /sd_key
	println("set_default existing:", sd2)
}
