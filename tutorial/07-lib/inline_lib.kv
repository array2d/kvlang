# 期望输出:
#   mylib·add(10,20) = 30
#   double(mylib·add(10,20)) = 60
lib mylib {
	rwfunc add(A:int64, B:int64) -> (C:int64) {
		A + B -> C
	}
}

rwfunc double(x:int64) -> (y:int64) {
	y <- x × 2
	y_m <- x × 2
}

rwfunc test() -> () {
	a = mylib·add(10, 20)  # = 等价于 <-
	println("mylib·add(10,20) =", a)
	double(a) -> b
	println("double(mylib·add(10,20)) =", b)
}
