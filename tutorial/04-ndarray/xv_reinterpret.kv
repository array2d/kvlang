// 期望输出:
//   before: [3]int64 24
//   as-bytes: [24]uint8 24
// compactarray·newreinterpret 原样保留 body 字节（bodylen 不变），只替换 kindexpr；
// 3 个 int64（24 字节）重解释为 24 个 uint8。
rwfunc test() -> () {
	a:[]int64 = [1, 2, 3]
	compactarray·langtype(a) -> k0
	compactarray·bodylen(a) -> b0
	println("before:", k0, b0)
	compactarray·newreinterpret(a, "[]uint8") -> raw
	compactarray·langtype(raw) -> k1
	compactarray·bodylen(raw) -> b1
	println("as-bytes:", k1, b1)
}
