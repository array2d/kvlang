// separated: 散 key 数组（元素分散在 b·[0]..b·[N-1] 各自 key，按坐标段寻址）
// 语义: 字面量初始化默认 compact；scatterarray·newscatter 把 compact 转散 key，scatterarray·newcompact 反向
// 散 key 元素访问用 b·[i]（走 kvspace·get），compact 用 b[i]（走 compactarray·at）
// 期望输出:
//   kvspace·listlen(b) = 3
//   b[0] = 10
//   b[2] = 30
//   compactarray·numel(c) = 3
//   c[0] = 10
rwfunc test() -> () {
	a:[]int64 = [10, 20, 30]       // 字面量初始化 → compact
	b = scatterarray·newscatter(a)          // 显式 scatter：compact a → 散 key b（b·[0]..b·[2]）
	kvspace·listlen(b) -> n1
	println("kvspace·listlen(b) =", n1)
	println("b[0] =", b·[0])       // 散 key 元素访问 ·[i]
	println("b[2] =", b·[2])
	c = scatterarray·newcompact(b)          // 显式 compact：散 key b → compact c
	compactarray·numel(c) -> n2
	println("compactarray·numel(c) =", n2)
	println("c[0] =", c[0])        // compact 元素访问 [i]
}
