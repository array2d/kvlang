# 经纬度坐标：二维散 key 数组，坐标段 [lat,lng] 带小数点
# 语义: 成员分隔符是 ·（middot），小数点仍是 .（dot）；geo·[39.9,116.4] 是带小数的数组 key
# 期望输出:
#   [39.9,116.4] -> Beijing
#   [31.23,121.47] -> Shanghai
rwfunc main() -> () {
	geo·[39.9,116.4] <- "Beijing"
	geo·[31.23,121.47] <- "Shanghai"
	geo·[39.9,116.4] -> bj
	geo·[31.23,121.47] -> sh
	println("[39.9,116.4] ->", bj)
	println("[31.23,121.47] ->", sh)
}
main()
