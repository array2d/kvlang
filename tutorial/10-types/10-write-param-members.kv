// 容器写参 + 成员写：静态键与动态键都必须落在调用方实例
// 期望输出:
//   s 1 2 3
//   d 0 1 2
rwfunc fill_static() -> (h:*[int64]·int64) {
    1 -> h·0
    2 -> h·1
    3 -> h·2
}
rwfunc fill_dynamic(n:int64) -> (h:*[int64]·int64) {
    i:int64 = 0
    while (i < n) {
        i -> h·*i
        i + 1 -> i
    }
}
rwfunc test() -> () {
    fill_static() -> a
    fill_dynamic(3) -> b
    println("s", a·0, a·1, a·2)
    println("d", b·0, b·1, b·2)
}
