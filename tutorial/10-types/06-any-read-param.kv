//   3
//   42
rwfunc size_of(a:any) -> (n:int64) {
	kv·listlen(a) -> n
}
rwfunc print_any(a:any) -> () {
	println(a)
}
rwfunc test() -> () {
	m:[int64]·[]char/utf32 = {"a", "b", "c"}
	size_of(m) -> n
	println(n)
	print_any(42)
}
