# 语义: stringkeymap 作返回类型 —— rwfunc 返回槽 head 存 []char/utf8·int64。
#       = Go map[string]int64。用 dict 字面量 { … } 构造并返回；缺失键得 None。
# 期望输出:
#   n = 42
#   x = 7
#   miss = true
rwfunc build() -> (m:[]char/utf8·int64) {
	{n=42; x=7} -> m
}
rwfunc test() -> () {
	build() -> r
	kv·get(r, "n") -> n
	println("n =", n)
	kv·get(r, "x") -> x
	println("x =", x)
	kv·get(r, "none") == None -> miss
	println("miss =", miss)
}
