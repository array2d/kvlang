
rwfunc file_exists(*[]char/utf32 #p) -> (*bool #b) {
	networld/fs·exists(*p) -> *b
}

rwfunc test() -> () {
	p:[]char/utf32 = "/tmp/pathlang_fs_exists.txt"
	noenv:'[int64]'[]char/utf32 = {}
	rm:'[int64]'[]char/utf32 = {"rm", "-f", "/tmp/pathlang_fs_exists.txt"}
	networld/proc·exec(rm, noenv) -> rc:uint8
	file_exists(p) -> b0:bool
	println("before=", b0)
	networld/fs·write(p, compactarray·newreinterpret("x", "[]uint8")) -> w:int64
	file_exists(p) -> b1:bool
	println("after_write=", b1)
	networld/fs·del(p) -> dc:int64
	file_exists(p) -> b2:bool
	println("after_del=", b2)
}
