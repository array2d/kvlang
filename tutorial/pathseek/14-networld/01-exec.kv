
rwfunc run_proc(*'[int64]'[]char/utf32 #args,
		*'[int64]'[]char/utf32 #envs) -> (*uint8 #code) {
	networld/proc·exec(*args, *envs) -> *code
}

rwfunc test() -> () {
	noenv:'[int64]'[]char/utf32 = {}
	echoargs:'[int64]'[]char/utf32 = {"sh", "-c", "echo hello from child"}
	run_proc(echoargs, noenv) -> ok:uint8
	println("ok=", ok)
	failargs:'[int64]'[]char/utf32 = {"sh", "-c", "exit 7"}
	run_proc(failargs, noenv) -> seven:uint8
	println("seven=", seven)
	badargs:'[int64]'[]char/utf32 = {"/no/such/program"}
	run_proc(badargs, noenv) -> missing:uint8
	println("missing=", missing)
	envargs:'[int64]'[]char/utf32 = {"sh", "-c", "echo FOO=$FOO"}
	envs:'[int64]'[]char/utf32 = {"FOO=bar123"}
	run_proc(envargs, envs) -> withenv:uint8
	println("withenv=", withenv)
}
