
rwfunc read_text(*[]char/utf32 #p) -> (*[]char/utf8 #s, *int64 #n) {
	networld/fs·size(*p) -> *n
	networld/fs·read(*p, 0, *n) -> raw:[]uint8
	compactarray·newreinterpret(raw, "[]char/utf8") -> *s
}

rwfunc test() -> () {
	p:[]char/utf32 = "/tmp/pathlangfs_demo.txt"
	noenv:'[int64]'[]char/utf32 = {}
	w:'[int64]'[]char/utf32 = {"sh", "-c", "printf 'hello pathlang' > /tmp/pathlangfs_demo.txt"}
	networld/proc·exec(w, noenv) -> wc:uint8
	read_text(p) -> (s:[]char/utf8, n:int64)
	println("size=", n)
	println("text=", s)
}
