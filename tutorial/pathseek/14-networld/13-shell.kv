
rwfunc test() -> () {
	networld/shell·run("echo hello shell") -> o:[]char/utf32
	println("out=", o)
	networld/shell·run("x=42; echo $x") -> v:[]char/utf32
	println("vars=", v)
	networld/shell·exec("printf ok; printf warn >&2; exit 3") -> (c:uint8, eo:[]char/utf32, ee:[]char/utf32)
	println("exec=", c, eo, ee)
}
