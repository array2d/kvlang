// networld/proc·exec：捕获子进程 stdout/stderr
//   exec(args, envs) -> code, out, err。绑定 out/err 写槽即捕获（未绑定则继承父终端）
//   out/err are @[]uint8 ext handles pointing to /networld/{host}/proc/{pid}-{n}/{stdout,stderr}
//   (stored under per-user private /tmp/byteseek-{uid}/, with {n} disambiguating PID reuse)
//   读该句柄时按 body 前缀路由回 /lib/networld/proc 兑现物理字节
// 期望输出:
//   code= 0
//   out= hi
//   err= oops
// run_capture 把 code/out/err 三个结果一并带回调用方；
// 捕获句柄无 kindexpr 类型，写参声明为空 kindexp（`out:`/`err:`，不约束）
rwfunc run_capture(args:*[int64]·[]char/utf32,
		envs:*[int64]·[]char/utf32) -> (code:uint8, out:, err:) {
	networld/proc·exec(args, envs) -> code, out, err
}

rwfunc test() -> () {
	noenv:[int64]·[]char/utf32 = {}
	a:[int64]·[]char/utf32 = {"sh", "-c", "echo hi; echo oops 1>&2"}
	run_capture(a, noenv) -> (code, out, err)
	println("code=", code)
	println("out=", out)
	println("err=", err)
}
