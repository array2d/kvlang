// networld/proc·exec 启动 kvlang 自身：子进程继承 KVSPACE，与父共享同一 redis
//   父作为子的父进程，同步等待并取回退出码
// 期望输出:
//   kvlang in kvlang
//   exit= 0
rwfunc run_proc(args:*[int64]·[]char/utf32,
		envs:*[int64]·[]char/utf32) -> (code:uint8) {
	networld/proc·exec(args, envs) -> code
}

rwfunc test() -> () {
	noenv:[int64]·[]char/utf32 = {}
	args:[int64]·[]char/utf32 = {"kvlang", "-c", "print(\"kvlang in kvlang\")"}
	run_proc(args, noenv) -> code
	println("exit=", code)
}
