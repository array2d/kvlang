// networld/proc·exec 启动 python3：执行一行脚本，取退出码
// 期望输出:
//   python 1024
//   exit= 0
rwfunc run_proc(args:[int64]·[]char/utf32,
		envs:[int64]·[]char/utf32) -> (code:uint8) {
	networld/proc·exec(args, envs) -> code
}

rwfunc test() -> () {
	noenv:[int64]·[]char/utf32 = {}
	args:[int64]·[]char/utf32 = {"python3", "-c", "print('python', 2**10)"}
	run_proc(args, noenv) -> code
	println("exit=", code)
}
