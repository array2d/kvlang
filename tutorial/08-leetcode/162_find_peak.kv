// 162: Find Peak Element — 二分找峰值
// 来源: LeetCode #162
// 期望输出:
//   2
rwfunc find_peak() -> () {
	a:[]int64 = [1, 2, 3, 1]
	n = ndarray·numel(a)
	0 -> lo
	hi = n - 1
	while (lo < hi) {
		s = lo + hi
		s ÷ 2 -> mid
		s ÷ 2 -> mid_m
		mv = a[mid]
		nv = a[mid + 1]
		mv < nv -> up

		if (up) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	println(lo)
}

rwfunc test() -> () {

	find_peak()
}
