// 062: Unique Paths — DP 机器人路径数
// 来源: LeetCode #62
// 期望输出:
//   28
//   3
rwfunc dp(*int64 $m, *int64 $n) -> (*int64 $result) {
	/tmp/up:[int64]·int64 = {}
	i = 0
	while (i < *n) {
		1 -> "/tmp/up"·*i
		i + 1 -> i
	}
	j = 1
	while (j < *m) {
		k = 1
		while (k < *n) {
			"/tmp/up"·*k -> v
			k - 1 -> km1
			"/tmp/up"·*km1 -> prev
			prev + v -> "/tmp/up"·*k
			k + 1 -> k
		}
		j + 1 -> j
	}
	*n - 1 -> last
	"/tmp/up"·*last -> *result
}

rwfunc test() -> () {
	r1 = dp(3, 7)
	println(r1)
	r2 = dp(3, 2)
	println(r2)
}
