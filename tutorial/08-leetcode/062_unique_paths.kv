// 062: Unique Paths — DP 机器人路径数
// 来源: LeetCode #62
// 期望输出:
//   28
//   3
rwfunc dp(m:int64, n:int64) -> (result:int64) {
	i = 0
	while (i < n) {
		_ = kv·set("/tmp/up", i, 1)
		i + 1 -> i
	}
	j = 1
	while (j < m) {
		k = 1
		while (k < n) {
			/tmp/up[k] -> v
			/tmp/up[k-1] -> prev
			_ = kv·set("/tmp/up", k, prev + v)
			k + 1 -> k
		}
		j + 1 -> j
	}
	/tmp/up[n-1] -> result
}

rwfunc test() -> () {
	r1 = dp(3, 7)
	println(r1)
	r2 = dp(3, 2)
	println(r2)
}
