// 206: Reverse Linked List
// 来源: LeetCode #206
// 期望输出:
//   5
//   4
//   3
//   2
//   1
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

rwfunc reverse(head:[]char/utf32) -> () {
	prev = ""
	head -> cur
	while (cur != "") {
		nxt = cur·next
		cur·next = prev
		cur -> prev
		cur = nxt
	}
	p = prev
	while (p != "") {
		p·val -> v
		println(v)
		p = p·next
	}
}

rwfunc test() -> () {
	n:[int64]·/lib/Node = {}
	kv·abs(n) -> nb
	nb + "·2" -> p2
	nb + "·3" -> p3
	nb + "·4" -> p4
	nb + "·5" -> p5
	Node{val=1 next=p2} -> n·1
	Node{val=2 next=p3} -> n·2
	Node{val=3 next=p4} -> n·3
	Node{val=4 next=p5} -> n·4
	Node{val=5 next=""} -> n·5
	nb + "·1" -> h
	reverse(h)
}
