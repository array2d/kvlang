# 349: Intersection of Two Arrays — O(n²) 暴力
# 来源: LeetCode #349
# 期望输出:
#   2
rwfunc intersection() -> () {
	a:[]int64 = [1, 2, 2, 1]  # = 等价于 <-
	xv.numel(a) -> na
	b:[]int64 <- [2, 2]
	nb = xv.numel(b)  # = 等价于 <-
	[0, 0] -> r:[]int64
	idx <- 0
	count = 0  # = 等价于 <-
	0 -> i
	while (i < na) {
		av <- a[i]
		j = 0  # = 等价于 <-
		false -> found
		while (j < nb) {
			bv <- b[j]
			match = av == bv  # = 等价于 <-

			if (match) {
				true -> found
				j <- nb
			} else {
				j = j + 1  # = 等价于 <-
			}
		}

		if (found) {
			r[idx] <- av
			idx + 1 -> idx
			count <- count + 1
		}

		i = i + 1  # = 等价于 <-
	}
	r[0] -> v
	println(v)
}

intersection()
