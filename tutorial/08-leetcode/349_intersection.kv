// 349: Intersection of Two Arrays — O(n²) 暴力
// 来源: LeetCode #349
// 期望输出:
//   2
rwfunc intersection() -> () {
	a:[]int64 = [1, 2, 2, 1]
	ndarray·numel(a) -> na
	b:[]int64 = [2, 2]
	nb = ndarray·numel(b)
	[0, 0] -> r:[]int64
	idx = 0
	count = 0
	0 -> i
	while (i < na) {
		av = a[i]
		j = 0
		false -> found
		while (j < nb) {
			bv = b[j]
			match = av == bv

			if (match) {
				true -> found
				j = nb
			} else {
				j = j + 1
			}
		}

		if (found) {
			r[idx] = av
			idx + 1 -> idx
			count = count + 1
		}

		i = i + 1
	}
	r[0] -> v
	println(v)
}

rwfunc test() -> () {

	intersection()
}
