// 234: Palindrome Linked List — 链表复制到键族数组 + 双指针
// 来源: LeetCode #234
// 期望输出:
//   true
//   false
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc is_pal(head:Node) -> () {
	arr:[int64]·int64 = {}
	0 -> n
	head -> p
	while (p != None) {
		p·val -> v
		kv·set(arr, n, v) -> _
		n = n + 1
		p·next -> p
	}
	ok = true
	0 -> l
	r = n - 1
	while (l < r) {
		kv·get(arr, l) -> x
		kv·get(arr, r) -> y

		if (x != y) {
			false -> ok
			r -> l
		}
		l = l + 1
		r = r - 1
	}
	if (ok) {
		println("true")
	} else {
		println("false")
	}
}

rwfunc test() -> () {
	p4:Node = {val=1}
	p3:Node = {val=2 next=&p4}
	p2:Node = {val=2 next=&p3}
	p1:Node = {val=1 next=&p2}
	&p1 -> hp
	is_pal(hp)

	q2:Node = {val=2}
	q1:Node = {val=1 next=&q2}
	&q1 -> hq
	is_pal(hq)
}
