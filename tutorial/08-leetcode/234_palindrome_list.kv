// 234: Palindrome Linked List — 链表复制到键族数组 + 双指针
// 来源: LeetCode #234
// 期望输出:
//   true
//   false
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

rwfunc is_pal(head:[]char/utf32) -> () {
	arr:[int64]·int64 = {}
	0 -> n
	head -> p
	while (p != "") {
		p·val -> v
		kv·set(arr, n, v) -> _
		n = n + 1
		p·next -> p
	}
	ok = true
	0 -> l
	r = n - 1
	while (l < r) {
		kv·get(arr, l) -> x
		kv·get(arr, r) -> y

		if (x != y) {
			false -> ok
			r -> l
		}
		l = l + 1
		r = r - 1
	}
	if (ok) {
		println("true")
	} else {
		println("false")
	}
}

rwfunc test() -> () {
	p:[int64]·/lib/Node = {}
	kv·abs(p) -> pb
	pb + "·2" -> p2
	pb + "·3" -> p3
	pb + "·4" -> p4
	Node{val=1 next=p2} -> p·1
	Node{val=2 next=p3} -> p·2
	Node{val=2 next=p4} -> p·3
	Node{val=1 next=""} -> p·4
	pb + "·1" -> hp
	is_pal(hp)

	q:[int64]·/lib/Node = {}
	kv·abs(q) -> qb
	qb + "·2" -> q2
	Node{val=1 next=q2} -> q·1
	Node{val=2 next=""} -> q·2
	qb + "·1" -> hq
	is_pal(hq)
}
