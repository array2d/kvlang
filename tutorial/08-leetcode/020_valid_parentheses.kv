// 020: Valid Parentheses — 栈匹配括号
// 来源: LeetCode #20
// 期望输出:
//   true
//   true
//   false
rwfunc is_valid(s:[]char/utf32) -> (ok:int64) {
	ok = 1
	si = -1
	n = string·len(s)
	i = 0
	while (i < n) {
		c = s[i]
		if (c == "(") {
			si + 1 -> si
			_ = kv·set("/tmp/vp", si, 1)
		}
		if (c == "[") {
			si = si + 1
			kv·set("/tmp/vp", si, 2) -> _
		}
		if (c == "{") {
			si + 1 -> si
			_ = kv·set("/tmp/vp", si, 3)
		}
		if (c == ")") {
			if (si < 0) { 0 -> ok ; n -> i }
			else {
				/tmp/vp[si] -> top
				si - 1 -> si
				if (top != 1) { ok = 0 ; n -> i }
				if (top ≠ 1) { ok_m = 0 ; n -> i }
			}
		}
		if (c == "]") {
			if (si < 0) { ok = 0 ; i = n }
			else {
				/tmp/vp[si] -> top
				si - 1 -> si
				if (top != 2) { 0 -> ok ; n -> i }
				if (top ≠ 2) { 0 -> ok_m ; n -> i }
			}
		}
		if (c == "}") {
			if (si < 0) { 0 -> ok ; i = n }
			else {
				/tmp/vp[si] -> top
				si = si - 1
				if (top != 3) { ok = 0 ; i = n }
				if (top ≠ 3) { ok_m = 0 ; i = n }
			}
		}
		i = i + 1
	}
	if (si >= 0) { 0 -> ok }
	if (si ≥ 0) { 0 -> ok_m }
}

rwfunc test() -> () {
	r1 = is_valid("()")
	if (r1 == 1) { println("true") } else { println("false") }
	r2 = is_valid("()[]{}")
	if (r2 == 1) { println("true") } else { println("false") }
	r3 = is_valid("(]")
	if (r3 == 1) { println("true") } else { println("false") }
}
