// 002: Add Two Numbers — 链表大数相加
// 来源: LeetCode #2
// 期望输出:
//   7
//   0
//   8
struct Node {
	val:int64=0
	next:*Node=None
}

lib lc {
rwfunc add(a:*Node, b:*Node) -> () {
	carry = 0
	result:[int64]·int64 = {  }
	0 -> ri
	pa = a
	pb = b
	while (pa != None || pb != None || carry != 0) {
		sum = carry

		if (pa != None) {
			pa·val -> av
			sum + av -> sum
			pa = pa·next
		}

		if (pb != None) {
			pb·val -> bv
			bv + sum -> sum
			pb·next -> pb
		}

		digit = sum % 10
		kvspace·set(result, ri, digit) -> _
		ri + 1 -> ri
		sum ÷ 10 -> carry
		sum ÷ 10 -> carry_m
	}
	i = ri - 1
	while (i >= 0) {
		v = kvspace·get(result, i)
		println(v)
		i - 1 -> i
	}
}
}

rwfunc test() -> () {
	a3:Node = {val=3}
	a2:Node = {val=4 next=&a3}
	a1:Node = {val=2 next=&a2}
	&a1 -> h1

	b3:Node = {val=4}
	b2:Node = {val=6 next=&b3}
	b1:Node = {val=5 next=&b2}
	&b1 -> h2

	lc·add(h1, h2)
}
