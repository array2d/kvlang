// 002: Add Two Numbers — 链表大数相加
// 来源: LeetCode #2
// 期望输出:
//   7
//   0
//   8
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

lib lc {
rwfunc add(a:[]char/utf32, b:[]char/utf32) -> () {
	carry = 0
	result:[int64]·int64 = {  }
	0 -> ri
	pa = a
	pb = b
	while (pa != "" || pb != "" || carry != 0) {
		sum = carry

		if (pa != "") {
			pa·val -> av
			sum + av -> sum
			pa = pa·next
		}

		if (pb != "") {
			pb·val -> bv
			bv + sum -> sum
			pb·next -> pb
		}

		digit = sum % 10
		kv·set(result, ri, digit) -> _
		ri + 1 -> ri
		sum ÷ 10 -> carry
		sum ÷ 10 -> carry_m
	}
	i = ri - 1
	while (i >= 0) {
		v = kv·get(result, i)
		println(v)
		i - 1 -> i
	}
}
}

rwfunc test() -> () {
	l1:[int64]·Node = {}
	kv·abs(l1) -> b1
	b1 + "·2" -> a2
	b1 + "·3" -> a3
	l1·1:Node = {val=2 next=a2}
	l1·2:Node = {val=4 next=a3}
	l1·3:Node = {val=3 next=""}
	b1 + "·1" -> h1

	l2:[int64]·Node = {}
	kv·abs(l2) -> b2
	b2 + "·2" -> c2
	b2 + "·3" -> c3
	l2·1:Node = {val=5 next=c2}
	l2·2:Node = {val=6 next=c3}
	l2·3:Node = {val=4 next=""}
	b2 + "·1" -> h2

	lc·add(h1, h2)
}
