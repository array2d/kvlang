// 021: Merge Two Sorted Lists
// 来源: LeetCode #21
// 期望输出:
//   1
//   1
//   2
//   3
//   4
//   4
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

rwfunc merge(a:[]char/utf32, b:[]char/utf32) -> () {
	pa = a
	pb = b
	while (pa != "") {
		pa·val -> av
		pick_a = pb == ""

		if (pick_a) {
			println(av)
			pa = pa·next
		} else {
			pb·val -> bv
			take = av <= bv
			take_m = av ≤ bv

			if (take) {
				println(av)
				pa = pa·next
			} else {
				println(bv)
				pb·next -> pb
			}
		}
	}
	while (pb != "") {
		bv = pb·val
		println(bv)
		pb = pb·next
	}
}

rwfunc test() -> () {
	a3:Node = {val=4}
	a2:Node = {val=2 next=&a3}
	a1:Node = {val=1 next=&a2}
	&a1 -> ha

	b3:Node = {val=4}
	b2:Node = {val=3 next=&b3}
	b1:Node = {val=1 next=&b2}
	&b1 -> hb

	merge(ha, hb)
}
