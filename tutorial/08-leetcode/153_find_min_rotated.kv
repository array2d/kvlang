// 153: Find Minimum in Rotated Sorted Array
// 来源: LeetCode #153
// 期望输出:
//   0
rwfunc find_min() -> () {
	a:[]int64 = [4, 5, 6, 7, 0, 1, 2]
	n = ndarray·numel(a)
	0 -> lo
	hi = n - 1
	while (lo < hi) {
		s = lo + hi
		s ÷ 2 -> mid
		mv = a[mid]
		rv = a[hi]
		mv < rv -> ok

		if (ok) {
			hi = mid
		} else {
			lo = mid + 1
		}
	}
	a[lo] -> ans
	println(ans)
}

rwfunc test() -> () {

	find_min()
}
