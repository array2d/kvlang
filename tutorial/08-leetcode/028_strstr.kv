// 028: strStr — 暴力子串查找
// 来源: LeetCode #28
// 期望输出:
//   2
//   2
rwfunc str_str(hay:[]char/utf32, needle:[]char/utf32) -> () {
	string·len(hay) -> nh
	nn = string·len(needle)
	i = 0
	-1 -> ans
	limit = nh - nn
	while (i <= limit) {
		match = true
		0 -> j
		while (j < nn) {
			hc = string·char(hay, i + j)
			nc = string·char(needle, j)
			hc == nc -> eq

			if (eq) {
				j = j + 1
			} else {
				match = false
				nn -> j
			}
		}

		if (match) {
			ans = i
			i = limit + 1
		} else {
			i + 1 -> i
		}
	}
	println(ans)
}

rwfunc test() -> () {

	str_str("hello", "ll")
}
