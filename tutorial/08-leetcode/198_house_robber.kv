// 198: House Robber — DP 打家劫舍
// 来源: LeetCode #198
// 期望输出:
//   4
rwfunc rob() -> () {
	[1, 2, 3, 1] -> a:[]int64
	n = ndarray·numel(a)
	one = n == 1
	n == 2 -> two

	if (one) {
		ans = a[0]
		println(ans)
	} else {
		p1 = a[0]
		a[1] -> p2
		bigger = p1 > p2

		if (bigger) {
			p2 = p1
		}

		2 -> i
		while (i < n) {
			cur = a[i]
			take = p1 + cur
			take > p2 -> better

			if (better) {
				tmp = take
			} else {
				tmp = p2
			}

			p2 -> p1
			p2 = tmp
			i = i + 1
		}
		println(p2)
	}
}

rwfunc test() -> () {

	rob()
}
