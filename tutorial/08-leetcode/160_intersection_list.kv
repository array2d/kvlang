// 160: Intersection of Two Linked Lists — 找两个链表的交点
// 来源: LeetCode #160
// 双指针法: pA 走完走 B, pB 走完走 A, 相遇即交点
// 期望输出:
//   8
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc get_intersection(ha:Node, hb:Node) -> () {
	pa = ha
	pb = hb
	switch_a = 0
	switch_b = 0
	while (pa != pb) {
		pa·next -> nxt
		if (nxt == None) {
			if (switch_a == 0) {
				hb -> pa
				1 -> switch_a
			} else {
				None -> pa
			}
		} else {
			nxt -> pa
		}
		pb·next -> nxt2
		if (nxt2 == None) {
			if (switch_b == 0) {
				ha -> pb
				switch_b = 1
			} else {
				None -> pb
			}
		} else {
			nxt2 -> pb
		}
	}
	if (pa != None) {
		pa·val -> v
		println(v)
	}
}

rwfunc test() -> () {
	// common tail: 8→4→5
	t5:Node = {val=5}
	t4:Node = {val=4 next=&t5}
	t8:Node = {val=8 next=&t4}

	// list A: 4→1→t8
	a2:Node = {val=1 next=&t8}
	a1:Node = {val=4 next=&a2}
	&a1 -> ha

	// list B: 5→6→1→t8
	b3:Node = {val=1 next=&t8}
	b2:Node = {val=6 next=&b3}
	b1:Node = {val=5 next=&b2}
	&b1 -> hb

	get_intersection(ha, hb)
}
