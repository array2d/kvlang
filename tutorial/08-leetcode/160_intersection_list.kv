// 160: Intersection of Two Linked Lists — 找两个链表的交点
// 来源: LeetCode #160
// 双指针法: pA 走完走 B, pB 走完走 A, 相遇即交点
// 期望输出:
//   8
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

rwfunc get_intersection(ha:[]char/utf32, hb:[]char/utf32) -> () {
	pa = ha
	pb = hb
	switch_a = 0
	switch_b = 0
	while (pa != pb) {
		pa·next -> nxt
		if (nxt == "") {
			if (switch_a == 0) {
				hb -> pa
				1 -> switch_a
			} else {
				"" -> pa
			}
		} else {
			nxt -> pa
		}
		pb·next -> nxt2
		if (nxt2 == "") {
			if (switch_b == 0) {
				ha -> pb
				switch_b = 1
			} else {
				"" -> pb
			}
		} else {
			nxt2 -> pb
		}
	}
	if (pa != "") {
		pa·val -> v
		println(v)
	}
}

rwfunc test() -> () {
	// common tail: 8→4→5
	t:[int64]·Node = {}
	kv·abs(t) -> tb
	tb + "·1" -> t8
	tb + "·2" -> t4
	tb + "·3" -> t5
	t·1:Node = {val=8 next=t4}
	t·2:Node = {val=4 next=t5}
	t·3:Node = {val=5 next=""}

	// list A: 4→1→t8
	a:[int64]·Node = {}
	kv·abs(a) -> ab
	ab + "·2" -> a2
	a·1:Node = {val=4 next=a2}
	a·2:Node = {val=1 next=t8}
	ab + "·1" -> ha

	// list B: 5→6→1→t8
	b:[int64]·Node = {}
	kv·abs(b) -> bb
	bb + "·2" -> b2
	bb + "·3" -> b3
	b·1:Node = {val=5 next=b2}
	b·2:Node = {val=6 next=b3}
	b·3:Node = {val=1 next=t8}
	bb + "·1" -> hb

	get_intersection(ha, hb)
}
