// 125: Valid Palindrome — 用 char 双指针
// 来源: LeetCode #125
// 期望输出:
//   1
//   0
rwfunc is_pal(s:[]char/utf32) -> () {
	n = string·len(s)
	0 -> l
	r = n - 1
	ok = 1
	while (l < r) {
		string·char(s, l) -> lc
		rc = string·char(s, r)
		match = lc == rc

		if (match) {
			l + 1 -> l
			r = r - 1
		} else {
			ok = 0
			n -> l
		}
	}
	println(ok)
}

rwfunc test() -> () {

	is_pal("aba")
	is_pal("ab")
}
