# 003: Longest Substring Without Repeating Characters — 滑动窗口
# 来源: LeetCode #3
# 期望输出:
#   3
#   1
#   5
rwfunc length_of_longest(s:[]char/utf32) -> (max_len:int64) {
	n <- string.len(s)
	last = {}  # = 等价于 <-
	max_len = 0  # = 等价于 <-
	left = 0  # = 等价于 <-
	right <- 0
	while (right < n) {
		s[right] -> c
		exists <- kv.get(last, c) != None
		if (exists) {
			prev = last[c]  # = 等价于 <-
			cand <- prev + 1
			if (cand > left) { left <- cand }
		}
		_ = kv.set(last, c, right)  # = 等价于 <-
		cur <- right - left + 1
		if (cur > max_len) { cur -> max_len }
		right + 1 -> right
	}
}

rwfunc main() -> () {
	r1 = length_of_longest("abcabcbb")  # = 等价于 <-
	println(r1)
	println(length_of_longest("bbbbb"))
	r3 <- length_of_longest("abcde")
	println(r3)
}
main()
