// 003: Longest Substring Without Repeating Characters — 滑动窗口
// 来源: LeetCode #3
// 期望输出:
//   3
//   1
//   5
rwfunc length_of_longest(s:[]char/utf32) -> (max_len:int64) {
	n = string·len(s)
	last:[]char/utf8·int64 = {}
	max_len = 0
	left = 0
	right = 0
	while (right < n) {
		s[right] -> c
		exists = kvspace·get(last, c) != None
		if (exists) {
			prev = kvspace·get(last, c)
			cand = prev + 1
			if (cand > left) { left = cand }
		}
		_ = kvspace·set(last, c, right)
		cur = right - left + 1
		if (cur > max_len) { cur -> max_len }
		right + 1 -> right
	}
}

rwfunc test() -> () {
	r1 = length_of_longest("abcabcbb")
	println(r1)
	println(length_of_longest("bbbbb"))
	r3 = length_of_longest("abcde")
	println(r3)
}
