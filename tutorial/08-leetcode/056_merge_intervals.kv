// 056: Merge Intervals — 合并重叠区间
// 来源: LeetCode #56
// 用冒泡排序 + 贪心合并
// 期望输出:
//   [1,6]
//   [8,10]
//   [15,18]
rwfunc bubble_sort(n:int64) -> () {
	i = 0
	while (i < n - 1) {
		j = 0
		while (j < n - 1 - i) {
			/tmp/mi·*j -> ta
			j + 1 -> jp
			/tmp/mi·*jp -> tb
			ta[0] -> a
			tb[0] -> b
			if (a > b) {
				ta[1] -> a1
				tb[1] -> b1
				j + 1 -> j1
				[b, b1] -> /tmp/mi·*j
				[a, a1] -> /tmp/mi·*j1
			}
			j + 1 -> j
		}
		i + 1 -> i
	}
}

rwfunc merge(n:int64) -> (m:int64) {
	bubble_sort(n)
	ki = 0
	/tmp/mi·*0 -> cur
	idx = 1
	while (idx < n) {
		/tmp/mi·*idx -> nxt
		cur[1] -> cur_end
		nxt[0] -> nxt_start
		nxt[1] -> nxt_end
		if (cur_end >= nxt_start) {
			if (nxt_end > cur_end) {
				/tmp/mr:[int64]·[2]int64 = {}
				[cur[0], nxt_end] -> /tmp/mr·*ki
				/tmp/mr·*ki -> cur
			}
		} else {
			cur -> /tmp/mr·*ki
			ki = ki + 1
			nxt -> cur
		}
		idx + 1 -> idx
	}
	cur -> /tmp/mr·*ki
	ki + 1 -> m
}

rwfunc test() -> () {
	// init intervals in tmp storage
	/tmp/mi:[int64]·[2]int64 = {}
	0 -> i0
	[1, 3] -> /tmp/mi·*i0
	1 -> i1
	[2, 6] -> /tmp/mi·*i1
	2 -> i2
	[8, 10] -> /tmp/mi·*i2
	3 -> i3
	[15, 18] -> /tmp/mi·*i3
	/tmp/mr:[int64]·[2]int64 = {}
	cnt = merge(4)
	i = 0
	while (i < cnt) {
		/tmp/mr·*i -> iv
		print("[", iv[0], ",", iv[1], "]"); println()
		i + 1 -> i
	}
}