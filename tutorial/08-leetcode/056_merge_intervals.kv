// 056: Merge Intervals — 合并重叠区间
// 来源: LeetCode #56
// 用冒泡排序 + 贪心合并
// 期望输出:
//   [1,6]
//   [8,10]
//   [15,18]
rwfunc bubble_sort(n:int64) -> () {
	i = 0
	while (i < n - 1) {
		j = 0
		while (j < n - 1 - i) {
			kv·get("/tmp/mi", j) -> ta
			kv·get("/tmp/mi", j+1) -> tb
			ta[0] -> a
			tb[0] -> b
			if (a > b) {
				ta[1] -> a1
				tb[1] -> b1
				_ = kv·set("/tmp/mi", j, [b, b1])
				_ = kv·set("/tmp/mi", j+1, [a, a1])
			}
			j + 1 -> j
		}
		i + 1 -> i
	}
}

rwfunc merge(n:int64) -> (m:int64) {
	bubble_sort(n)
	ki = 0
	kv·get("/tmp/mi", 0) -> cur
	idx = 1
	while (idx < n) {
		kv·get("/tmp/mi", idx) -> nxt
		cur[1] -> cur_end
		nxt[0] -> nxt_start
		nxt[1] -> nxt_end
		if (cur_end >= nxt_start) {
			if (nxt_end > cur_end) {
				/tmp/mr:[int64]·[2]int64 = {}
				_ = kv·set("/tmp/mr", ki, [cur[0], nxt_end])
				kv·get("/tmp/mr", ki) -> cur
			}
		} else {
			_ = kv·set("/tmp/mr", ki, cur)
			ki = ki + 1
			nxt -> cur
		}
		idx + 1 -> idx
	}
	_ = kv·set("/tmp/mr", ki, cur)
	ki + 1 -> m
}

rwfunc test() -> () {
	// init intervals in tmp storage
	/tmp/mi:[int64]·[2]int64 = {}
	_ = kv·set("/tmp/mi", 0, [1, 3])
	_ = kv·set("/tmp/mi", 1, [2, 6])
	_ = kv·set("/tmp/mi", 2, [8, 10])
	_ = kv·set("/tmp/mi", 3, [15, 18])
	/tmp/mr:[int64]·[2]int64 = {}
	cnt = merge(4)
	i = 0
	while (i < cnt) {
		kv·get("/tmp/mr", i) -> iv
		print("[", iv[0], ",", iv[1], "]"); println()
		i + 1 -> i
	}
}