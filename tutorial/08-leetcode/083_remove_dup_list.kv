// 083: Remove Duplicates from Sorted List — 链表去重（局部 map 建表 + next 改写）
// 来源: LeetCode #83
// 期望输出:
//   1
//   2
//   1
//   2
//   3
struct Node {
	val:int64=0
	next:[]char/utf32=""
}

rwfunc dedup(head:[]char/utf32) -> () {
	head -> cur
	while (cur != "") {
		cur·next -> nxt
		advance = true

		if (nxt != "") {
			cur·val -> v
			nxt·val -> nv

			if (nv == v) {
				nxt·next -> nn
				cur·next = nn
				false -> advance
			}
		}
		if (advance) {
			cur·next -> cur
		}
	}
}

rwfunc show(head:[]char/utf32) -> () {
	head -> p
	while (p != "") {
		p·val -> v
		println(v)
		p·next -> p
	}
}

rwfunc test() -> () {
	e3:Node = {val=2}
	e2:Node = {val=1 next=&e3}
	e1:Node = {val=1 next=&e2}
	&e1 -> eh
	dedup(eh)
	show(eh)

	f5:Node = {val=3}
	f4:Node = {val=3 next=&f5}
	f3:Node = {val=2 next=&f4}
	f2:Node = {val=1 next=&f3}
	f1:Node = {val=1 next=&f2}
	&f1 -> fh
	dedup(fh)
	show(fh)
}
