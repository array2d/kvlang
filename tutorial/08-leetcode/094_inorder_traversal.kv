// 094: Binary Tree Inorder Traversal — 二叉树中序遍历 (迭代栈)
// 来源: LeetCode #94
// 期望输出:
//   2
//   1
//   3
struct TNode {
	val:int64=0
	left:[]char/utf32=""
	right:[]char/utf32=""
}

rwfunc inorder(root:[]char/utf32) -> () {
	// iterative stack simulation
	si = 0
	stack:[int64]·[]char/utf32 = {}
	cur = root
	while (cur != "" || si > 0) {
		while (cur != "") {
			_ = kv·set(stack, si, cur)
			si + 1 -> si
			cur·left -> cur
		}
		si - 1 -> si
		kv·get(stack, si) -> node
		node·val -> v
		println(v)
		node·right -> cur
	}
}

rwfunc test() -> () {
	t:[int64]·/lib/TNode = {}
	kv·abs(t) -> tb
	tb + "·2" -> t1
	tb + "·3" -> t2
	TNode{val=1 left=t1 right=t2} -> t·1
	TNode{val=2} -> t·2
	TNode{val=3} -> t·3
	tb + "·1" -> root
	inorder(root)
}
