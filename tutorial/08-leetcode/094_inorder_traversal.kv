// 094: Binary Tree Inorder Traversal — 二叉树中序遍历 (迭代栈)
// 来源: LeetCode #94
// 期望输出:
//   2
//   1
//   3
struct TNode {
	val:int64=0
	left:[]char/utf32=""
	right:[]char/utf32=""
}

rwfunc inorder(root:[]char/utf32) -> () {
	// iterative stack simulation
	si = 0
	stack:[int64]·[]char/utf32 = {}
	cur = root
	while (cur != "" || si > 0) {
		while (cur != "") {
			_ = kv·set(stack, si, cur)
			si + 1 -> si
			cur·left -> cur
		}
		si - 1 -> si
		kv·get(stack, si) -> node
		node·val -> v
		println(v)
		node·right -> cur
	}
}

rwfunc test() -> () {
	n2:TNode = {val=2}
	n3:TNode = {val=3}
	n1:TNode = {val=1 left=&n2 right=&n3}
	&n1 -> root
	inorder(root)
}