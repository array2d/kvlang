// 033: Search in Rotated Sorted Array
// 算法: 二分查找 + 半区判断
// 来源: LeetCode #33
// 期望输出:
//   4
rwfunc search() -> () {
	a:[]int64 = [4, 5, 6, 7, 0, 1, 2]
	n = ndarray·numel(a)
	0 -> target
	lo = 0
	hi = n - 1
	-1 -> result
	while (lo <= hi) {
		s = lo + hi
		mid = s ÷ 2
		mid_m = s ÷ 2
		a[mid] -> mv
		eq = mv == target

		if (eq) {
			result = mid
			hi + 1 -> lo
		} else {
			lv = a[lo]
			rv = a[hi]
			lv <= mv -> left_sorted
			lv ≤ mv -> left_sorted_m

			if (left_sorted) {
				t1 = lv <= target
				t1_m = lv ≤ target
				t2 = target < mv

				if (t1 && t2) {
					mid - 1 -> hi
				} else {
					lo = mid + 1
				}
			} else {
				t3 = mv <= target
				t3_m = mv ≤ target
				target <= rv -> t4
				target ≤ rv -> t4_m

				if (t3 && t4) {
					lo = mid + 1
				} else {
					hi = mid - 1
				}
			}
		}
	}
	println(result)
}

rwfunc test() -> () {

	search()
}
