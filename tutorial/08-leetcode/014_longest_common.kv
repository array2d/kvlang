// 014: Longest Common Prefix — 逐字符比较
// 来源: LeetCode #14
// 期望输出:
//   fl
rwfunc lcp() -> () {
	"flower" -> a
	b = "flow"
	c = "flight"
	string·len(a) -> na
	nb = string·len(b)
	nc = string·len(c)
	0 -> i
	ok = true
	while (ok) {
		ca = i < na
		i < nb -> cb
		cc = i < nc
		all_ok = ca && cb && cc

		if (all_ok) {
			string·char(a, i) -> va
			vb = string·char(b, i)
			vc = string·char(c, i)
			va == vb -> ab
			bc = vb == vc
			match = ab && bc

			if (match) {
				i + 1 -> i
			} else {
				ok = false
			}
		} else {
			ok = false
		}
	}
	string·slice(a, 0, i) -> ans
	println(ans)
}

rwfunc test() -> () {

	lcp()
}
