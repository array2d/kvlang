// 067: Add Binary — 二进制字符串加法
// 来源: LeetCode #67
// 期望输出:
//   100
//   10101
rwfunc add_binary(a:[]char/utf32, b:[]char/utf32) -> () {
	na = string·len(a)
	nb = string·len(b)
	carry = 0
	i = na - 1
	j = nb - 1
	result = ""
	while (i >= 0 || j >= 0 || carry > 0) {
		sum = carry
		if (i >= 0) {
			if (a[i] == "1") { sum + 1 -> sum }
			i = i - 1
		}
		if (j >= 0) {
			if (b[j] == "1") { 1 + sum -> sum }
			j - 1 -> j
		}
		if (sum % 2 == 1) {
			result = "1" + result
		} else {
			"0" + result -> result
		}
		sum ÷ 2 -> carry
		sum ÷ 2 -> carry_m
	}
	println(result)
}

rwfunc test() -> () {
	add_binary("11", "1")
	add_binary("1010", "1011")
}
