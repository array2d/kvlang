// 278: First Bad Version — 二分查找第一个坏版本
// 来源: LeetCode #278
// 期望输出:
//   4
rwfunc first_bad(n:int64) -> () {
	// isBadVersion(i) = i >= 4
	1 -> lo
	hi = n
	while (lo < hi) {
		s = lo + hi
		s ÷ 2 -> mid
		s ÷ 2 -> mid_m
		bad = mid >= 4
		bad_m = mid ≥ 4

		if (bad) {
			hi = mid
		} else {
			mid + 1 -> lo
		}
	}
	println(lo)
}

rwfunc test() -> () {

	first_bad(5)
}
