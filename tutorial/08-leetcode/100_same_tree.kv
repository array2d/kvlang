// 100: Same Tree — 判断两棵二叉树是否相同
// 来源: LeetCode #100
// 期望输出:
//   true
//   false
struct TNode {
	val:int64=0
	left:[]char/utf32=""
	right:[]char/utf32=""
}

rwfunc same(a:[]char/utf32, b:[]char/utf32) -> (ok:int64) {
	if (a == "" || b == "") {
		if (a == b) { 1 -> ok } else { 0 -> ok }
	} else {
		if (a·val == b·val) {
			same(a·left, b·left) -> ok
			if (ok == 1) {
				same(a·right, b·right) -> ok
			}
		} else { 0 -> ok }
	}
}

rwfunc test() -> () {
	t:[int64]·/lib/TNode = {}
	kv·abs(t) -> tb
	tb + "·2" -> t1
	tb + "·3" -> t2
	TNode{val=1 left=t1 right=t2} -> t·1
	TNode{val=2} -> t·2
	TNode{val=3} -> t·3
	tb + "·1" -> rt

	v:[int64]·/lib/TNode = {}
	kv·abs(v) -> vb
	vb + "·2" -> v1
	vb + "·3" -> v2
	TNode{val=1 left=v1 right=v2} -> v·1
	TNode{val=2} -> v·2
	TNode{val=4} -> v·3
	vb + "·1" -> rv

	same(rt, rt) -> r1
	if (r1 == 1) { println("true") } else { println("false") }
	same(rt, rv) -> r2
	if (r2 == 1) { println("true") } else { println("false") }
}
