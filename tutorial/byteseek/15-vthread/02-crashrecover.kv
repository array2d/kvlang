
rwfunc run_steps(*int64 #limit) -> (*int64 #final) {
	0 -> i:int64
	while (i < *limit) {
		i + 1 -> i
		i -> /crashtest/step
		println("step", i)
		noenv:'[int64]'[]char/utf32 = {}
		a:'[int64]'[]char/utf32 = {"sleep", "0.2"}
		networld/proc·exec(a, noenv) -> code:uint8
	}
	i -> *final
}

rwfunc test() -> () {
	run_steps(5) -> i:int64
	1 -> /crashtest/done
	println("complete final=", i)
}
