
rwfunc print_dir(*[]char/utf32 #d) -> () {
	networld/fs·list(*d) -> names:'[int64]'[]char/utf32
	kvspace·listlen(names) -> nc:int64
	println("count=", nc)
	i:int64 = 0
	while (i < nc) {
		kvspace·listat(names, i) -> key:[int64]
		names·*key -> nm:[]char/utf32
		println("name=", nm)
		i = i + 1
	}
}

rwfunc test() -> () {
	d:[]char/utf32 = "/tmp/kvlang_fs_dir"
	da:[]char/utf32 = "/tmp/kvlang_fs_dir/a.txt"
	db:[]char/utf32 = "/tmp/kvlang_fs_dir/b.txt"
	noenv:'[int64]'[]char/utf32 = {}
	clean:'[int64]'[]char/utf32 = {"rm", "-rf", "/tmp/kvlang_fs_dir"}
	networld/proc·exec(clean, noenv) -> rc:uint8
	networld/fs·mkdir(d) -> mc:int64
	networld/fs·write(da, compactarray·newreinterpret("A", "[]uint8")) -> w1:int64
	networld/fs·write(db, compactarray·newreinterpret("B", "[]uint8")) -> w2:int64
	print_dir(d)
	networld/fs·del(da) -> d1:int64
	networld/fs·del(db) -> d2:int64
	networld/fs·del(d) -> dd:int64
	println("delfile=", d1)
	println("deldir=", dd)
}
