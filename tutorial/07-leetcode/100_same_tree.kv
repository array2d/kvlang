# 100: Same Tree — 判断两棵二叉树是否相同
# 来源: LeetCode #100
# 期望输出:
#   true
#   false
rwfunc build() -> () {
	/t0 <- { val=1; left="/t1"; right="/t2" }
	{ val=2; left=""; right="" } -> /t1
	/t2 <- { val=3; left=""; right="" }
	/v0 <- { val=1; left="/v1"; right="/v2" }
	/v1 <- { val=2; left=""; right="" }
	{ val=4; left=""; right="" } -> /v2
}

rwfunc same(a:string, b:string) -> (ok:int64) {
	if (a == "" || b == "") {
		if (a == b) { 1 -> ok } else { 0 -> ok }
	} else {
		if (a.val == b.val) {
			same(a.left, b.left) -> ok
			if (ok == 1) {
				same(a.right, b.right) -> ok
			}
		} else { 0 -> ok }
	}
}

rwfunc main() -> () {
	build()
	same("/t0", "/t0") -> r1
	if (r1 == 1) { println("true") } else { println("false") }
	same("/t0", "/v0") -> r2
	if (r2 == 1) { println("true") } else { println("false") }
}
main()
