# 100: Same Tree — 判断两棵二叉树是否相同
# 来源: LeetCode #100
# 期望输出:
#   true
#   false
def build() -> () {
	/t0 <- { val=1; left="/t1"; right="/t2" }
	{ val=2; left=""; right="" } -> /t1
	/t2 <- { val=3; left=""; right="" }
	/v0 <- { val=1; left="/v1"; right="/v2" }
	/v1 <- { val=2; left=""; right="" }
	{ val=4; left=""; right="" } -> /v2
}

def same(a:string, b:string) -> (ok:int64) {
	1 -> ok
	if (a == "") {
		if (b != "") { 0 -> ok }
	}
	if (ok == 1 && a != "") {
		if (a.val != b.val) { 0 -> ok }
		else {
			same(a.left, b.left) -> l
			if (l == 0) { ok <- 0 }
		}
	}
	if (ok == 1 && a != "") {
		same(a.right, b.right) -> r
		if (r == 0) { 0 -> ok }
	}
}

def main() -> () {
	build()
	same("/t0", "/t0") -> r1
	if (r1 == 1) { print("true") } else { print("false") }
	same("/t0", "/v0") -> r2
	if (r2 == 1) { print("true") } else { print("false") }
}
main()
