# 048: Rotate Image — 原地旋转矩阵 90° 顺时针
# 来源: LeetCode #48
# 期望输出:
#   7
#   4
#   1
#   8
#   5
#   2
#   9
#   6
#   3
rwfunc rotate(N:int64) -> () {
	mat:int64 = [1, 2, 3, 4, 5, 6, 7, 8, 9]
	# transpose
	i = 0  # = 等价于 <-
	while (i < N) {
		j = i + 1  # = 等价于 <-
		while (j < N) {
			ri <- i × N + j
			ri_m <- i × N + j
			rj = j × N + i  # = 等价于 <-
			rj_m = j × N + i  # = 等价于 <-
			mat[ri] -> t
			mat[rj] -> u
			mat[ri] <- u
			mat[rj] <- t
			j + 1 -> j
		}
		i + 1 -> i
	}
	# reverse each row
	r = 0  # = 等价于 <-
	while (r < N) {
		l <- r × N
		l_m <- r × N
		h = l + N - 1  # = 等价于 <-
		while (l < h) {
			mat[l] -> v1
			mat[h] -> v2
			mat[l] <- v2
			mat[h] <- v1
			l + 1 -> l
			h - 1 -> h
		}
		r + 1 -> r
	}
	# print
	row = 0  # = 等价于 <-
	while (row < N) {
		col = 0  # = 等价于 <-
		while (col < N) {
			idx = row × N + col  # = 等价于 <-
			idx_m = row × N + col  # = 等价于 <-
			v <- mat[idx]
			println(v)
			col + 1 -> col
		}
		row + 1 -> row
	}
}

rwfunc main() -> () {
	rotate(3)
}
main()
