// abs_dynamic_key: dynamic member writes on absolute paths (`/tmp/m·*k = v` and `v -> "/tmp/m"·*k`)
// evaluate `k` at runtime instead of writing the literal key `/tmp/m·*k`.
// Expected output:
//   a0= 0 a1= 10 a2= 20
//   b1= 101 b2= 102
//   s= 5
rwfunc test() -> () {
	/tmp/adk:int64·int64 = {}
	i = 0
	while (i < 3) {
		v = i × 10
		/tmp/adk·*i = v
		i = i + 1
	}
	j = 0
	/tmp/adk·*j -> a0
	j = 1
	"/tmp/adk"·*j -> a1
	j = 2
	/tmp/adk·*j -> a2
	println("a0=", a0, "a1=", a1, "a2=", a2)
	/tmp/adb:int64·int64 = {}
	k = 1
	while (k < 3) {
		k + 100 -> /tmp/adb·*k
		k = k + 1
	}
	/tmp/adb·1 -> b1
	/tmp/adb·2 -> b2
	println("b1=", b1, "b2=", b2)
	/tmp/ads:[]char/utf32·int64 = {}
	name = "x"
	5 -> /tmp/ads·*name
	/tmp/ads·x -> s
	println("s=", s)
}
