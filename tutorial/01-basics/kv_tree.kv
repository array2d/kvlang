// 期望输出:
//   v= 42
//   has_data= true
//   x= 42
//   n= 2
//   numel= 3 dim= 1
//   shape0= 3

// path 下是否存在字段 key
rwfunc has_field(path:[]char/utf32, key:[]char/utf32) -> (ok:bool) {
	path·*key != None -> ok
}

// 列出 prefix 下的子键并计数（成员数查 memindex，非 ndarray 形状）
rwfunc count_children(prefix:[]char/utf32) -> (n:int64) {
	kvspace·listlen(prefix) -> n
}

rwfunc test() -> () {
	/tmp/kvt:int64·int64 = {}
	42 -> "/tmp/kvt·data"
	"/tmp/kvt·data" -> v
	println("v=", v)
	has_field("/tmp/kvt", "data") -> h
	println("has_data=", h)
	"/tmp/kvt"·*"data" -> x
	println("x=", x)
	kvspace·mkindex("/tmp/kvt/")
	1 -> "/tmp/kvt/a"
	2 -> "/tmp/kvt/b"
	count_children("/tmp/kvt/") -> n
	println("n=", n)
	compactarray·numel([10,20,30]) -> m
	compactarray·dim([10,20,30]) -> d
	println("numel=", m, "dim=", d)
	compactarray·shape([10,20,30]) -> s
	println("shape0=", s[0])
}
