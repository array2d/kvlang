# precision: 数字精度与类型提升
# 语义: int64 与 float64 是数值运算域；int64 op int64 → 原生 int64 运算与比较，绝不经 float64 中转（fix-020，对齐 C/Go/Rust）；
#       任一侧 float → float64 提升（混合比较为 C 式 double 提升）
# 期望输出:
#   5
#   5.5
#   3.0
#   3.0
#   3
#   3
#   -4
#   -4
#   3.5
#   3.5
#   1
#   3
#   7.0
#   1000.0
#   0.025
#   0.30000000000000004
#   true
#   9223372036854775807
#   9223372036854775806
#   9007199254740993
#   false
rwfunc main() -> () {
	a = 2 + 3  # = 等价于 <-
	println(a)
	b <- 2 + 3.5
	println(b)
	1.5 × 2 -> c
	1.5 × 2 -> c_m
	println(c_m)
	println(c)

	q = 7 ÷ 2  # = 等价于 <-（整除：两侧均 int）
	q_m = 7 ÷ 2  # = 等价于 <-（整除：两侧均 int）
	println(q_m)
	println(q)
	-9 ÷ 2 -> qz
	-9 ÷ 2 -> qz_m
	println(qz_m)
	println(qz)
	fq <- 7.0 ÷ 2
	fq_m <- 7.0 ÷ 2
	println(fq_m)
	println(fq)
	r = 7 % 3  # = 等价于 <-
	println(r)

	ti <- int64(3.99)
	println(ti)
	float64(7) -> tf
	println(tf)

	sci = 1e3  # = 等价于 <-（科学计数法字面量恒为 float）
	println(sci)
	small <- 2.5e-2
	println(small)

	0.1 + 0.2 -> sum
	println(sum)

	eq = 3 == 3.0  # = 等价于 <-（跨类型数值比较：值提升后相等）
	println(eq)

	big <- 9223372036854775807
	println(big)

	big - 1 -> bm
	println(bm)
	precise = 9007199254740993 + 0  # = 等价于 <-（2^53+1：int 算术不经 float，精度保真）
	println(precise)
	same <- big == 9223372036854775806
	println(same)
}

main()
