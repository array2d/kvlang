// 期望输出:
//   n= 3

// 列出 prefix 下的子键并计数
rwfunc count_children(prefix:[]char/utf32) -> (n:int64) {
	kvspace·listlen(prefix) -> n
}

rwfunc test() -> () {
	kvspace·mkindex("/tmp/kvtc/", 8)
	1 -> "/tmp/kvtc/a"
	2 -> "/tmp/kvtc/bb"
	3 -> "/tmp/kvtc/ccc"
	count_children("/tmp/kvtc/") -> n
	println("n=", n)
}
