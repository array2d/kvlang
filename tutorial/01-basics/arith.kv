# 期望输出:
#   add: 13
#   sub: 7
#   mul: 30
#   mul(×): 30
#   div: 3
#   div(÷): 3
#   mod: 1
#   pow: 32.0
#   sqrt: 12.0
#   sqrt(√): 12.0
rwfunc test() -> () {
	t0 <- time·now()
	10 + 3 -> add_r
	println("add:", add_r)

	10 - 3 -> sub_r
	println("sub:", sub_r)

	mul_r = 10 × 3  # = 等价于 <-
	println("mul:", mul_r)
	mul_r2 = 10 × 3  # = 等价于 <-
	println("mul(×):", mul_r2)

	10 ÷ 3 -> div_r
	println("div:", div_r)
	10 ÷ 3 -> div_r2
	println("div(÷):", div_r2)

	10 % 3 -> mod_r
	println("mod:", mod_r)

	pow_r <- pow(2, 5)
	println("pow:", pow_r)

	sqrt_r = sqrt(144)  # = 等价于 <-
	println("sqrt:", sqrt_r)
	sqrt_r2 = √(144)  # = 等价于 <-
	println("sqrt(√):", sqrt_r2)

	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
}
