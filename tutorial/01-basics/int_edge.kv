// int_edge: two's-complement wraparound, truncating integer division (INT64_MIN / -1 wraps,
// INT64_MIN % -1 == 0 without SIGFPE), and unsigned uint64 arithmetic/comparison for >= 2^63.
// Expected output:
//   a/b = -9223372036854775808
//   a%b = 0
//   loop q = -9223372036854775808
//   loop r = 0
//   max+1 = -9223372036854775808
//   min-1 = 9223372036854775807
//   min*-1 = -9223372036854775808
//   neg min = -9223372036854775808
//   abs min = -9223372036854775808
//   i32 min/-1 = -2147483648
//   i8 min/-1 = -128
//   -7/2 = -3
//   -7%2 = -1
//   u64 3+4 = 7
//   u64 3-4 = 18446744073709551615
//   u64max*3 = 18446744073709551613
//   u64max/2 = 9223372036854775807
//   u64max%10 = 5
//   u64max>>60 = 15
//   u64 1<<63 = 9223372036854775808
//   u64 max(big,3) = 18446744073709551615
//   u64 min(big,3) = 3
//   u64 big>3 = true
//   u64 big<3 = false
//   u8 200+100 = 44
//   u8 200/3 = 66
rwfunc divmod_loop(*int64 $n) -> (*int64 $q) {
	// Exercise int64 div/mod inside a loop (fast kernel hot path).
	*q = 0
	m = -9223372036854775807 - 1
	i = 0
	while (i < *n) {
		*q = m ÷ -1
		i = i + 1
	}
}
rwfunc mod_loop(*int64 $n) -> (*int64 $r) {
	*r = 7
	m = -9223372036854775807 - 1
	i = 0
	while (i < *n) {
		*r = m % -1
		i = i + 1
	}
}
rwfunc test() -> () {
	a = -9223372036854775807 - 1
	b = -1
	a ÷ b -> c
	println("a/b =", c)
	a % b -> d
	println("a%b =", d)
	println("loop q =", divmod_loop(3))
	println("loop r =", mod_loop(3))
	mx = 9223372036854775807
	mx + 1 -> e
	println("max+1 =", e)
	a - 1 -> f
	println("min-1 =", f)
	a × b -> g
	println("min*-1 =", g)
	-a -> h
	println("neg min =", h)
	abs(a) -> k
	println("abs min =", k)
	int32(-2147483648) ÷ int32(-1) -> i32
	println("i32 min/-1 =", i32)
	int8(-128) ÷ int8(-1) -> i8
	println("i8 min/-1 =", i8)
	-7 ÷ 2 -> t1
	println("-7/2 =", t1)
	-7 % 2 -> t2
	println("-7%2 =", t2)
	big = uint64(18446744073709551615)
	u3 = uint64(3)
	u4 = uint64(4)
	u3 + u4 -> s1
	println("u64 3+4 =", s1)
	u3 - u4 -> s2
	println("u64 3-4 =", s2)
	big × u3 -> s3
	println("u64max*3 =", s3)
	big ÷ uint64(2) -> s4
	println("u64max/2 =", s4)
	big % uint64(10) -> s5
	println("u64max%10 =", s5)
	big >> uint64(60) -> s6
	println("u64max>>60 =", s6)
	uint64(1) << uint64(63) -> s7
	println("u64 1<<63 =", s7)
	max(big, u3) -> s8
	println("u64 max(big,3) =", s8)
	min(big, u3) -> s9
	println("u64 min(big,3) =", s9)
	big > u3 -> c1
	println("u64 big>3 =", c1)
	big < u3 -> c2
	println("u64 big<3 =", c2)
	uint8(200) + uint8(100) -> b1
	println("u8 200+100 =", b1)
	uint8(200) ÷ uint8(3) -> b2
	println("u8 200/3 =", b2)
}
