
rwfunc sleep_at_least(*int64 #ms) -> (*bool #ok) {
	time/duration·millis(*ms) -> d:time/duration
	time·now() -> t0:time
	vthread·sleep(d)
	time·elapsed_ns(t0) -> ns:int64
	time/duration·as_nanos(d) -> want:int64
	ns >= want -> *ok
}

rwfunc test() -> () {
	sleep_at_least(10) -> ok:bool
	print("slept >= 10ms: ")
	println(ok)
}
