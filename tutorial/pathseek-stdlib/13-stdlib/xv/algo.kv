
rwfunc test() -> () {
	a:[]int64 = [10, 40, 5, 15, 20]
	println("last=", xv·last(a))
	println("sum=", xv·sum(a))
	println("min_max=", xv·min(a), xv·max(a))
	println("argmin_max=", xv·argmin(a), xv·argmax(a))
	b:[]int64 = [10, 20, 5, 15, 20, 40]
	println("find=", xv·find(b, 20), xv·rfind(b, 20), xv·find(b, 99))
	println("contains=", xv·contains(b, 15), xv·contains(b, 99))
	println("count=", xv·count(b, 20), xv·count(b, 99))
	c:[]int64 = [10, 40, 5, 15, 20]
	println("eq=", xv·eq(a, c), xv·eq(a, b))
	println("sorted_before=", xv·is_sorted(b))
	s:[]int64 = xv·sort(b)
	println("sorted_after=", xv·is_sorted(s))
	println("sorted_elems=", s[0], s[1], s[2], s[3], s[4], s[5])
	u:[]int64 = xv·sort(a)
	println("bsearch=", xv·binary_search(u, 20), xv·binary_search(u, 99))
	rev:[]int64 = xv·reverse(u)
	println("rev_ends=", xv·first(rev), xv·last(rev))
	f:[]int64 = xv·fill(a, 7)
	println("filled=", xv·first(f), xv·last(f))
}
