
rwfunc test() -> () {
	a1:bool = string·isalpha("ab")
	a2:bool = string·isalpha("ab1")
	a3:bool = string·isalpha("")
	println("isalpha", a1, a2, a3)
	println("isdigit", string·isdigit("123"), string·isdigit("12a"))
	println("isalnum", string·isalnum("ab1"), string·isalnum("a b"))
	println("isspace", string·isspace(" \t"), string·isspace(""))
	u1:bool = string·isupper("AB1")
	u2:bool = string·isupper("Ab")
	u3:bool = string·isupper("1")
	println("isupper", u1, u2, u3)
	println("islower", string·islower("ab1"), string·islower("aB"))
	println("isxdigit", string·isxdigit("1aF"), string·isxdigit("1g"))
	println("ispunct", string·ispunct("!?,."), string·ispunct("a!"))
}
