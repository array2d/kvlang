# array_scatter_compact: 数组压缩/解压
# 期望输出:
#   len after scatter = 0
#   len after compact = 3
#   a[0] = 10
#   a[2] = 30
rwfunc main() -> () {
	a:int64 = [10, 20, 30]
	scatter(a)
	len(a) -> n1
	println("len after scatter =", n1)
	compact(a)
	len(a) -> n2
	println("len after compact =", n2)
	println("a[0] =", a[0])
	println("a[2] =", a[2])
}

main()
