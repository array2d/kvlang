# 期望输出:
#   abs(-5) = 5
#   false
rwfunc abs(x:int64) -> (r:int64) {
	if (x < 0) {
		-x -> r
	} else {
		r <- x
	}
}

a = abs(-5)  # = 等价于 <-
println("abs(-5) =", a)
abs(3) -> b
println("abs(3) =", b)
c <- abs(-10)
println("abs(-10) =", c)
d = b >= 90  # = 等价于 <-
d_m = b ≥ 90  # = 等价于 <-
println(d_m)
println(d)
a -> /last_abs
