
rwfunc print_sum(*'[int64]'int64 #nums) -> (*int64 #total) {
	*total = 0
	pathspace·listlen(*nums) -> n:int64
	0 -> i:int64
	while (i < n) {
		pathspace·listat(*nums, i) -> k:int64
		(*nums)·*k -> x:int64
		println(x)
		*total = *total + x
		i = i + 1
	}
}

rwfunc test() -> () {
	nums:'[int64]'int64 = {10, 20, 30, 40}
	print_sum(nums) -> total:int64
	println("sum =", total)
}
