
rwfunc test() -> () {
    compactarray·fill("[0]int64") -> empty:[0]int64
    a:'[int64]'int64 = {1, 2, 3}
    scatterarray·newscatter(empty) -> a
    pathspace·listlen(a) -> n:int64
    println(n)
    b:[]int64 = [8, 9]
    scatterarray·newscatter(b) -> a
    pathspace·listlen(a) -> m:int64
    println(m)
}
