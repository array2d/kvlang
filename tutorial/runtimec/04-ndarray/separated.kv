
rwfunc test() -> () {
	a:[]int64 = [10, 20, 30]       
	b:'[int64]'int64 = scatterarray·newscatter(a)          
	pathspace·listlen(b) -> n1:int64
	println("pathspace·listlen(b) =", n1)
	println("b[0] =", b·[0])       
	println("b[2] =", b·[2])
	c:[]int64 = scatterarray·newcompact(b)          
	compactarray·numel(c) -> n2:int64
	println("compactarray·numel(c) =", n2)
	println("c[0] =", c[0])        
}
