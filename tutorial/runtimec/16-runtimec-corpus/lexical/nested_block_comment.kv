// Criterion: block comments nest; an inner `*/` does not close the outer comment.
// Without nesting, the comment would end at the inner `*/` and `still_in_comment` would be parsed as code.
// Reference: 01-lexical/03-comments.kv.
// Expected output:
//   7

rwfunc test() -> () {
	/* outer /* inner */ still_in_comment */
	val:int64 = 7
	println(val)
}
