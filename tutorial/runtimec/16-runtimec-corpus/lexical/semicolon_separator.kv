// Criterion: `;` is equivalent to a newline, and consecutive separators collapse into a single `Newline`.
// Without `;` as a statement separator, three statements on one line would parse as a single malformed expression.
// Reference: 01-lexical/01-source-structure.kv.
// Expected output:
//   3
//   7

rwfunc test() -> () {
	a:int64 = 1; b:int64 = 2; println(a + b)
	c:int64 = 3; d:int64 = 4; println(c + d)
}
