// Criterion: `r"…"` performs zero escape processing; `r#"…"#` may contain unescaped double quotes.
// Treating raw strings as escaped strings would turn `\n` into a newline on the first line.
// Reference: 01-lexical/07-string-null-bool-literals.kv.
// Expected output:
//   raw\nliteral
//   he said "hi"

rwfunc test() -> () {
	println(r"raw\nliteral")
	println(r#"he said "hi""#)
}
