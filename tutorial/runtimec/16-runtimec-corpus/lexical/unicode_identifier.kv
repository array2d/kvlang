// Criterion: identifiers allow Unicode letters; if the lexer only recognized ASCII,
// `λ`/`α`/`β`/`δ` would be split or rejected as unknown identifiers.
// Reference: 01-lexical/04-identifiers.kv (`letter` includes `unicode_letter`).
// Expected output:
//   42

rwfunc λ(*int64 #α) -> (*int64 #β) {
	*α × 2 -> *β
}

rwfunc test() -> () {
	δ:int64 = 21
	println(λ(δ))
}
