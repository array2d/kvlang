// Criterion: `[]` is compact (single contiguous XValue), whereas `{}` is scatter-keyed.
// Element access syntax differs accordingly: `a[i]` for compact, `a·[i]` for scatter.
// Treating `{}` as compact would raise a TypeError on `scatter·[1]`.
// Reference: 03-type-system/09-array-forms.kv, 10-compact-form.kv.
// Expected output:
//   20
//   20

rwfunc test() -> () {
	compact:[3]int64 = [10, 20, 30]
	scatter:'[int64]'int64 = {10, 20, 30}
	println(compact[1])
	println(scatter·[1])
}
