// Criterion: functions have no return-value expression; outputs land in caller keys via write-parameter mapping.
// Misinterpreting `->` as return-value assignment would fail to populate `v` in the caller.
// Reference: 04-layout-semantics/03-functions.kv, 05-runtime-semantics/01-execution-model.kv.
// Expected output:
//   42

rwfunc add1(*int64 #x) -> (*int64 #r) {
	*x + 1 -> *r
}

rwfunc test() -> () {
	add1(41) -> v:int64
	println(v)
}
