// Criterion: a call site may bind the same key to both a read slot and a write slot (`inc(v) -> v` as explicit inout).
// Rejecting read/write aliasing at call sites would cause layout to reject this program.
// Reference: 04-layout-semantics/03-functions.kv (same variable readable and writable at call site).
// Expected output:
//   6

rwfunc inc(*int64 #x) -> (*int64 #r) {
	*x + 1 -> *r
}

rwfunc test() -> () {
	5 -> v:int64
	inc(v) -> v
	println(v)
}
