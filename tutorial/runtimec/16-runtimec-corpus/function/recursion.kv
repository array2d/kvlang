// 判据：递归调用 + 局部 + return 闭环；fib(10) 需要完整调用栈。
// 若 call 不建被调帧或局部不物化，第一条 fib 调用就 blocked 或失败。
// 依据：04-layout语义/03-函数.kv、05-runtime语义/01-执行模型.kv。
// 期望输出:
//   55

rwfunc fib(*int64 #n) -> (*int64 #r) {
	if (*n <= 1) {
		*n -> *r
	} else {
		a:int64 = *n - 1
		b:int64 = *n - 2
		fib(a) -> x:int64
		fib(b) -> y:int64
		x + y -> *r
	}
}

rwfunc test() -> () {
	fib(10) -> v:int64
	println(v)
}
