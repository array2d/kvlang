// Criterion: recursive calls + local slots + return form a complete call stack (`fib(10)`).
// Failing to allocate callee frames or materialize locals per frame would block or corrupt recursion.
// Reference: 04-layout-semantics/03-functions.kv, 05-runtime-semantics/01-execution-model.kv.
// Expected output:
//   55

rwfunc fib(*int64 #n) -> (*int64 #r) {
	if (*n <= 1) {
		*n -> *r
	} else {
		a:int64 = *n - 1
		b:int64 = *n - 2
		fib(a) -> x:int64
		fib(b) -> y:int64
		x + y -> *r
	}
}

rwfunc test() -> () {
	fib(10) -> v:int64
	println(v)
}
