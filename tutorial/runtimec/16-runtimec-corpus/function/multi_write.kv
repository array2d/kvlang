// Criterion: a single call can map multiple write parameters positionally (`q`, `r`).
// Supporting only a single write parameter would drop the second output binding.
// Reference: 04-layout-semantics/01-instruction-architecture.kv (multi-assignment), 03-functions.kv.
// Expected output:
//   3 2

rwfunc divmod(*int64 #n, *int64 #d) -> (*int64 #q, *int64 #r) {
	*n ÷ *d -> *q
	*n % *d -> *r
}

rwfunc test() -> () {
	divmod(17, 5) -> q:int64, r:int64
	println(q, r)
}
