// Criterion: a call expression may appear as an argument to another call, materializing the inner result first.
// Restricting arguments to bare identifiers would reject `add1(add1(40))` during layout.
// Reference: 04-layout-semantics/03-functions.kv, nested calls in 07-lib/inline_lib.kv.
// Expected output:
//   42

rwfunc add1(*int64 #x) -> (*int64 #r) {
	*x + 1 -> *r
}

rwfunc test() -> () {
	println(add1(add1(40)))
}
