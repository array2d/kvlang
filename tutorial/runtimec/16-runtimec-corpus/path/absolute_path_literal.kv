// Criterion: a bare path starting with `/` is an absolute path literal that directly reads/writes pathspace;
// `·[i]` is a coordinate segment, not an expression subscript.
// Treating the path as a string or `·[0]` as an array subscript would land on a different key.
// Reference: 01-lexical/05-absolute-path-literals.kv, 02-pathspace-model/05-keys-and-array-access.kv.
// Per language rules: existence of an absolute key is a runtime precondition rather than a static guarantee --
// instructions do not implicitly create keys, so this test explicitly declares `path_scalar:int64`.
// Expected output:
//   42
//   7

rwfunc test() -> () {
	/tmp/kv_corpus/path_scalar:int64 = 0
	42 -> /tmp/kv_corpus/path_scalar
	/tmp/kv_corpus/path_scalar -> v:int64
	println(v)
	/tmp/kv_corpus/nums:'[int64]'int64 = {}
	7 -> /tmp/kv_corpus/nums·[0]
	/tmp/kv_corpus/nums·[0] -> w:int64
	println(w)
}
