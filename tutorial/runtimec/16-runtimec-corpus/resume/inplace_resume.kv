// Special case: inplace write `x = x + 1`.
//
// When a crash/stop occurs **mid-instruction** (write persisted, `‥pc` not yet advanced),
// proper recovery must walk back to the nearest non-inplace ancestor (P2c): restore `x = 1`,
// then replay `x = x + 1` to get `x = 2`. Replaying directly from `‥pc` increments `x` twice (`x = 3`).
//
// Driver: lay out this file into pathspace, run once to get `/resume/y = 2`; rewind `‥pc` to
// `s0=2` of `x = x + 1` (while `x` is still 2), and resume from `s0=2`.
// Correct value: 2; naive replay produces 3.
//
// Clean run (without simulated crash):
// Expected output:
//   2

rwfunc inplace_resume() -> () {
	x:int64 = 1
	x = x + 1
	x -> /resume/y
	println(x)
}
