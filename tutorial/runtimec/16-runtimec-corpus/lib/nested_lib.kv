// Criterion: nested `lib` blocks accumulate package segments with `/`, and function names attach to the leaf via `·`;
// calls omit `/lib` and write `outer/inner·add1`.
// Keeping only the innermost `lib` name would fail to resolve `/lib/outer/inner·add1`.
// Reference: 04-layout-semantics/11-lib-and-rwir-data.kv.
// Expected output:
//   42

lib outer {
	lib inner {
		rwfunc add1(*int64 #x) -> (*int64 #r) {
			*x + 1 -> *r
		}
	}
}

rwfunc test() -> () {
	println(outer/inner·add1(41))
}
