// Criterion: `ident: { … }` is a named block; layout flattens it into a linear irseq
// without creating a scope subdirectory, so variables stay in the same frame.
// If treated as an isolated frame, `x` assigned inside the block would not be visible outside.
// Reference: appendix/06-control-flow.kv, 04-layout-semantics/05-control-flow.kv.
// Expected output:
//   42

rwfunc test() -> () {
	x:int64 = 0
	setup: {
		x = 41
	}
	println(x + 1)
}
