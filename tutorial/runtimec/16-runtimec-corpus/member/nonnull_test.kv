// Criterion: `nonnull` / `nonnull·not` -- existence checks hold for **arbitrary types**.
// Reference: 03-type-system/03-kinds-codes-and-special-values.kv ("None criterion": normalized empty body
//            + no wire langtype + key is not a directory).
//
// Paired `==` and `!=` assertions in every group so a globally inverted operator cannot slip through:
//   1. Zero-valued local `x:int64 = 0` -- key exists with langtype ⇒ not `None`.
//   2. (Omitted) "Declared without initial write" is not expressible in pathlang source because the parser
//      requires an initializer on scalar declarations; frame zero-materialization is covered via group 1.
//   3. Existing absolute key with typed zero value ⇒ not `None`. (Missing-key `None` comparison requires
//      type-from-target and is tracked separately.)
//   4. Null pointer `p:*int64 = None` -- is `None` (dispatches to `ptreq` rather than `nonnull`).
//
// Expected output:
//   zero eq false
//   zero neq true
//   present eq false
//   present neq true
//   nullptr eq true
//   nullptr neq false

rwfunc test() -> () {
	x:int64 = 0
	eq0:bool = x == None
	println("zero eq", eq0)
	ne0:bool = x != None
	println("zero neq", ne0)

	/never_written:int64 = 0
	missing:int64 = /never_written
	println("present eq", missing == None)
	println("present neq", missing != None)

	p:*int64 = None
	println("nullptr eq", p == None)
	println("nullptr neq", p != None)
}
