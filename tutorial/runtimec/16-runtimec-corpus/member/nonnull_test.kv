
rwfunc test() -> () {
	x:int64 = 0
	eq0:bool = x == None
	println("zero eq", eq0)
	ne0:bool = x != None
	println("zero neq", ne0)

	/never_written:int64 = 0
	missing:int64 = /never_written
	println("present eq", missing == None)
	println("present neq", missing != None)

	p:*int64 = None
	println("nullptr eq", p == None)
	println("nullptr neq", p != None)
}
