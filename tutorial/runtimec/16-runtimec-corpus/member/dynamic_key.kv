// Criterion: `a·*b` evaluates `b` first and uses its value as the key; `a·b` uses the literal name `b`.
// Ignoring `*` would write under key `"k"` instead of `"a"`, breaking both outputs.
// Reference: 03-type-system/15-member-access.kv.
//
// Tests **dynamic key access** in isolation. Non-pointer `None` comparison (`m·k == None`) is covered
// separately so two independent features are not conflated in one test.
// Expected output:
//   10
//   10

rwfunc test() -> () {
	m:'[]char/utf8'int64 = {}
	k:[]char/utf32 = "a"
	10 -> m·*k
	println(m·*k)
	println(m·a)
}
