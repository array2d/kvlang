// Criterion: `a·[i,j]` is a scalar tuple key, not a compact array subscript.
// Treating it as an array subscript would fail at runtime with TypeError since `a` is not compact.
// Reference: 03-type-system/15-member-access.kv, 14-map-containers.kv.
// Expected output:
//   7

rwfunc test() -> () {
	a:'[int64,int64]'int32 = {}
	7 -> a·[1,2]
	println(a·[1,2])
}
