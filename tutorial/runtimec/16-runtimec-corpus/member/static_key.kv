// Criterion: `a·b` accesses a static string-keyed member, reading and writing the same key.
// Treating `·` as a path subkey or dynamic key would fail to read `3` from `p·x`.
// Reference: 03-type-system/15-member-access.kv, 17-struct.kv.
// Expected output:
//   3
//   4
//   5

struct Point {
	x:int64=0
	y:int64=0
}

rwfunc test() -> () {
	p:Point = {x=3 y=4}
	println(p·x)
	println(p·y)
	5 -> p·x
	println(p·x)
}
