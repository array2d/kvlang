// Criterion: a `*T` slot holds only `Ptr` or `None`; null checks are written `p == None` / `p != None`.
// Representing null pointers as `""` or `0` would produce wrong booleans on the first two lines.
// Reference: 03-type-system/16-ptr.kv ("null pointer is None").
// Expected output:
//   true
//   true
//   7

rwfunc test() -> () {
	p:*int64 = None
	println(p == None)
	x:int64 = 7
	&x -> p
	println(p != None)
	println(*p)
}
