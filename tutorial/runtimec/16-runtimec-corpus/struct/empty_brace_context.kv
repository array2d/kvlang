// Criterion: the form of `{}` is determined by the target type -- `Point` yields a struct,
// while `'[]char/utf8'int64` yields a map. Inspecting braces without target context would conflate the two.
// Reference: 03-type-system/17-struct.kv, 14-map-containers.kv.
// Expected output:
//   7
//   9

struct Point {
	x:int64=0
	y:int64=0
}

rwfunc test() -> () {
	p:Point = {}
	p·x = 7
	m:'[]char/utf8'int64 = {}
	m·k = 9
	println(p·x)
	println(m·k)
}
