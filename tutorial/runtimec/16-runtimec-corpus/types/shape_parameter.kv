// Criterion: shape `[3]int64` participates in parameter type matching; the argument must be a length-3 compact array.
// Ignoring shape would accept mismatched lengths; here we verify that length 3 matches cleanly.
// Reference: 03-type-system/07-grammar-and-validity.kv, 09-array-forms.kv.
// Expected output:
//   6

rwfunc sum3(*[3]int64 #a) -> (*int64 #r) {
	(*a)[0] + (*a)[1] + (*a)[2] -> *r
}

rwfunc test() -> () {
	println(sum3([1, 2, 3]))
}
