// Criterion: `×` and `÷` are multiply and divide, and `≠ ≤ ≥` are comparisons; ASCII `*` and `/` are not arithmetic ops.
// An ASCII-only lexer/parser would fail on `6 × 7`.
// Reference: 01-lexical/08-operator-basics.kv.
// Expected output:
//   42
//   5
//   true
//   true
//   false

rwfunc test() -> () {
	println(6 × 7)
	println(20 ÷ 4)
	println(3 ≠ 4)
	println(3 ≤ 3)
	println(4 ≥ 5)
}
