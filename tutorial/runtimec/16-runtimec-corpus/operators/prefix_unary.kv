// Criterion: prefix unary `+ - ! √` bind tighter than all infix operators; `√(144)` yields `float64`.
// If `√` were not registered as a prefix unary operator, it would fail as an identifier or unknown operator.
// Reference: 01-lexical/08-operator-basics.kv, 09-logical-bitwise-and-precedence.kv.
// Expected output:
//   -5
//   5
//   12.0
//   true
//   false

rwfunc test() -> () {
	println(-5)
	println(+5)
	println(√(144))
	println(!false)
	println(!true)
}
