// Criterion: printing `float64` appends `.0` for integral values in fixed-point range while keeping fractional values compact.
//
// Convention: **Python** style rather than C/Go/JS (which print `12.0` as `12`, making `float64`
// indistinguishable from `int64`), while keeping `%g`-like compactness (`3.5`, not `3.500000`).
// Driven by the **value's kind** (`float64` branch), not post-hoc string heuristics.
//
// Reference: `runtimec/contract/float_format.{c,h}`;
//            `√(144)` in `operators/prefix_unary.kv` expects `12.0`.
//
// ── Expected-output changelog (2026-11-05, float formatter rewrite) ──────────
//
// `100.0`: legacy `%g`-based formatting switched to scientific notation earlier, whereas the unified
// Python-style fixed-point interval `[1e-4, 1e16)` formats `100.0` in fixed-point rather than `1e+02`,
// avoiding a confusing hybrid of Python `.0` suffixing and C exponent thresholds.
//
// The other four values (`12.0`, `3.5`, `-5.0`, `0.5`) are unchanged.
//
// Expected output:
//   12.0
//   3.5
//   100.0
//   -5.0
//   0.5

rwfunc test() -> () {
	println(12.0)
	println(3.5)
	println(100.0)
	println(-5.0)
	println(0.5)
}
