// Criterion: character and slice results in `char/utf32` slots are written in
// the slot's declared encoding -- multi-byte UTF-8 characters (`αβ`) must not
// be truncated to 1 byte or misencoded.
// Reference: five-language-behavior-matrix `string-codepoint-indexing`.
// Expected output:
//   h
//   αβ

rwfunc test() -> () {
	x:[]char/utf32 = "hi"
	a:char/utf32 = string·char(x, 0)
	println(a)

	y:[]char/utf32 = "αβ"
	b:char/utf32 = string·slice(y, 0, 2)
	println(b)
}
