// Criterion: `string·slice` result bytes must follow the write slot's declared langtype.
// On a `char/utf32` slot each character is 4 bytes; always writing UTF-8 (6 bytes for "αβγ")
// would leave a body length that is not a multiple of 4.
// Reference: same as `char_utf32_set.kv`.
// Expected output:
//   αβγ

rwfunc test() -> () {
	s:[]char/utf32 = "αβγδ"
	t:char/utf32 = string·slice(s, 0, 3)
	println(t)
}
