// `string·concat` **exact upper bound**: 16 × 64 = 1024 codepoints must succeed.
//
// Mirrors `array/body_capacity_exact.kv`: capacity is verified behaviorally so shrinking
// `STRING_TEXT_CODEPOINT_CAPACITY` turns this test red.
//
// Over-limit counterpart (1025 codepoints must fail with `0x4A0B`) is deferred:
//   TODO(pending): add over-limit case once the corpus runner supports "Expected runtime failure"
//   (see `known-limitations/body_capacity_over_limit.kv`).
//
// Expected output:
//   len = 1024

rwfunc test() -> () {
	"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" -> base:[]char/utf32
	"" -> s:[]char/utf32
	0 -> r:int64
	while (r < 16) {
		s + base -> s
		r + 1 -> r
	}
	string·len(s) -> n:int64
	println("len =", n)
}
