// Criterion: when `string·formatint` writes to a `char/utf32` slot, every character must be 4 bytes.
// ASCII digits (`<= 0x7F`) are narrow codepoints, not narrow slots -- writing UTF-8 would set body length
// to the character count instead of `4 × count`, which utf32 decoding rejects as malformed.
// Reference: five-language-behavior-matrix `string-format-base-radix`;
//            utf32 branch of `string_text_encode`.
// Expected output:
//   -42
//   ff

rwfunc test() -> () {
	a:char/utf32 = string·formatint(-42)
	println(a)
	b:char/utf32 = string·formatuint(255, 16)
	println(b)
}
