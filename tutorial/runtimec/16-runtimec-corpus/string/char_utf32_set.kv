// Criterion: bytes rebuilt by `string·set` must follow the **write slot's declared langtype**.
// The write slot is `char/utf32`, so "α" must be encoded as 4 bytes (`b1 03 00 00`);
// if rebuild always wrote UTF-8 ("hα" = 3 bytes), the body length would not be a multiple of 4,
// and println decoding as utf32 would reject it as malformed.
// Reference: five-language-behavior-matrix `string-codepoint-indexing`;
//            utf32 branch of `string_text_encode`.
// Expected output:
//   hα

rwfunc test() -> () {
	s:[]char/utf8 = "hi"
	t:char/utf32 = string·set(s, 1, "α")
	println(t)
}
