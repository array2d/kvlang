// Criterion: a structref is annotated with its prototype path `/lib/Point`; containers are passed by
// address, written `**/lib/Point` (value type `*/lib/Point` plus `*` parameter slot convention).
// Treating `/lib/Point` as a plain kind name would fail signature matching.
// Reference: 03-type-system/17-struct.kv, 07-grammar-and-validity.kv, 05-runtime-semantics/04-function-calls.kv.
//
// ── Known limitation (excluded from active corpus scan) ──────────────────────
// **Blocked on pointer representation wiring**: `head.ptr` is still 0, layout does not emit `ptr=1`,
// and the encoder rejects capability rows with POINTER bits (`vmkv encoder: pointer and extension
// parameters are not representable from RWIR text yet`).
//
// Do **not** convert this into `// Expected error:`. Move back to `types/` once pointer wiring lands.
//
// Expected output:
//   3

struct Point {
	x:int64=0
	y:int64=0
}

rwfunc xcoord(**/lib/Point #p) -> (*int64 #r) {
	(*p)·x -> *r
}

rwfunc test() -> () {
	p:Point = {x=3 y=4}
	println(xcoord(&p))
}
