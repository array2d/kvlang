// Criterion: a `**T` formal parameter inside the callee is a pointer to the caller's pointer argument,
// requiring one dereference to reach `*int64` (the caller's address) and a second via `*local` to read the value.
// Migrated from legacy `p:*int64`: passing convention and value type each contribute one `*`, giving `**int64 #p`
// rather than `*int64 #p` (which would pass an `int64` by slot rather than a pointer).
// Reference: 03-type-system/16-ptr.kv, 05-runtime-semantics/04-function-calls.kv (`rwfunc` frame slot `**T`).
//
// ── Known limitation (excluded from active corpus scan) ──────────────────────
// **Blocked on pointer representation wiring**: `head.ptr` is still 0, layout does not emit `ptr=1`,
// and the encoder rejects capability rows with POINTER bits (`vmkv encoder: pointer and extension
// parameters are not representable from RWIR text yet`).
//
// Do **not** convert this into `// Expected error:`. Move back to `types/` once pointer wiring lands.
//
// Expected output:
//   41

rwfunc read_target(**int64 #p) -> (*int64 #r) {
	*p -> local:int64
	*local -> *r
}

rwfunc test() -> () {
	x:int64 = 41
	read_target(&x) -> v:int64
	println(v)
}
