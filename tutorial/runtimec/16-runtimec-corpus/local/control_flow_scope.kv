// Criterion: layout flattens block bodies into a single linear irseq without scope subdirectories;
// a local declared inside an `if` block lives in the same frame slot outside the block.
// With lexical block scoping, `y` would be unreadable after the `if`.
// Reference: 04-layout-semantics/05-control-flow.kv, 02-pathspace-model/10-system-vars.kv.
// Expected output:
//   7

rwfunc test() -> () {
	if (true) {
		y:int64 = 7
	}
	println(y)
}
