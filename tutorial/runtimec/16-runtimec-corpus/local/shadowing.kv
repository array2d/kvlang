// Criterion: frame slots are keyed by name and named blocks do not create scope subdirectories;
// same-named writes do not shadow, so writing `x` inside `inner` updates the same slot.
// If block-level shadowing is introduced in the future, the expected output here changes to 1.
// Reference: 04-layout-semantics/05-control-flow.kv, 02-pathspace-model/10-system-vars.kv.
// Expected output:
//   2

rwfunc test() -> () {
	x:int64 = 1
	inner: {
		x = 2
	}
	println(x)
}
