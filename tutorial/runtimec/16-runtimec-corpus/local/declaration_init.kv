// Criterion: local variables with explicit `int64` and `float64` type annotations
// must initialize and read back accurately.
// Reference: 03-type-system/27-assignment-conversions.kv, 04-layout-semantics/03-functions.kv.
// Expected output:
//   3
//   3.5

rwfunc test() -> () {
	a:int64 = 1
	b:int64 = 2
	c:float64 = 3.5
	println(a + b)
	println(c)
}
