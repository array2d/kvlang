// 多级包名调用：全路径 /lib/aaa/bbb/math·sum() 与短形式 aaa/bbb/math·sum() 等价
// 期望输出:
//   7
//   7
//   30
lib aaa/bbb/math {
    rwfunc sum(*int64 #A, *int64 #B) -> (*int64 #C) { *A + *B -> *C }
    rwfunc double(*int64 #A) -> (*int64 #C) {
        aaa/bbb/math·sum(*A, *A) -> *C
    }
}
rwfunc test() -> () {
    /lib/aaa/bbb/math·sum(3, 4) -> s:int64
    println(s)

    aaa/bbb/math·sum(3, 4) -> t:int64
    println(t)

    /lib/aaa/bbb/math·double(15) -> d:int64
    println(d)
}
