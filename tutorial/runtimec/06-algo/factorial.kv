
rwfunc factorial(*int64 #n) -> (*int64 #result) {
	1 -> *result
	i:int64 = 1
	while (i <= *n) {
		*result = *result × i
		i + 1 -> i
	}
}

rwfunc test() -> () {

	t0:time = time·now()
	ans:int64 = factorial(10)
	t1:time = time·now()
	println("fact =", ans)
	delta:time/duration = time·sub(t1, t0)
	ns:int64 = time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
}
