// gcd: 欧几里得最大公约数（尾递归）
// 算法: gcd(48, 18) = 6
// 期望输出:
//   gcd = 6
rwfunc gcd(*int64 #A, *int64 #B) -> (*int64 #R) {
	if (*B == 0) {
		*A -> *R
	} else {
		rem:int64 = *A % *B
		*R = gcd(*B, rem)
	}
}

rwfunc test() -> () {

	t0:time = time·now()
	gcd(48, 18) -> ans:int64
	t1:time = time·now()
	println("gcd =", ans)
	delta:time/duration = time·sub(t1, t0)
	ns:int64 = time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
}
