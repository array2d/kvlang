
rwfunc word_count(*'[int64]'[]char/utf32 #chars) -> (*int64 #nw) {
	*nw = 0
	0 -> state:int64
	kvspace·listlen(*chars) -> n:int64
	0 -> i:int64
	while (i < n) {
		kvspace·listat(*chars, i) -> k:int64
		(*chars)·*k -> c:[]char/utf32
		blank:bool = c == " "

		if (blank) {
			state = 0
		} else {
			state == 0 -> was_out:bool

			if (was_out) {
				state = 1
				*nw = *nw + 1
			}
		}
		i = i + 1
	}
}

rwfunc test() -> () {
	chars:'[int64]'[]char/utf32 = {}
	chars·0 = "h"
	"e" -> chars·1
	chars·2 = "l"
	chars·3 = "l"
	"o" -> chars·4
	chars·5 = " "
	chars·6 = "w"
	"o" -> chars·7
	chars·8 = "r"
	chars·9 = "l"
	"d" -> chars·10
	chars·11 = " "
	chars·12 = "k"
	"v" -> chars·13
	chars·14 = "l"
	chars·15 = "a"
	"n" -> chars·16
	chars·17 = "g"
	word_count(chars) -> nw:int64
	println("word count =", nw)
	nw -> /last_wc
}
