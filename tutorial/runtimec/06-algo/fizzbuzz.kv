
rwfunc fizzbuzz(*int64 #N) -> () {
	i:int64 = 1
	while (i <= *N) {
		i % 3 -> m3:int64
		m5:int64 = i % 5
		d3:bool = m3 == 0
		m5 == 0 -> d5:bool
		fb:bool = d3 && d5

		if (fb) {
			println("FizzBuzz")
		} else {
			if (d3) {
				println("Fizz")
			} else {
				if (d5) {
					println("Buzz")
				} else {
					println(i)
				}
			}
		}

		i = i + 1
	}
}

rwfunc test() -> () {
	fizzbuzz(15)
}
