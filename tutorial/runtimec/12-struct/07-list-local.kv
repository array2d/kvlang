
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc sum_list(*Node #head) -> (*int64 #sum) {
	head -> cur:*/lib/Node
	0 -> *sum
	while (cur != None) {
		(*cur)·val -> v:int64
		*sum + v -> *sum
		(*cur)·next -> cur
	}
}

rwfunc test() -> () {
	n3:Node = {val=30}
	n2:Node = {val=20 next=&n3}
	n1:Node = {val=10 next=&n2}
	sum_list(&n1) -> s:int64
	println(s)
}
