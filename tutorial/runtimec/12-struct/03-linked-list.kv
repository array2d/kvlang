
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc show_list(*Node #head) -> () {
	head -> cur                  
	while (cur != None) {
		(*cur)·val -> v:int64    
		println(v)
		(*cur)·next -> cur:*/lib/Node
	}
}

rwfunc test() -> () {
	n3:Node = {val=30}
	n2:Node = {val=20 next=&n3}
	n1:Node = {val=10 next=&n2}
	show_list(&n1)
}
