
struct 点 {
	x:int64=0
	y:int64=0
}
rwfunc 求和(*点 #p) -> (*int64 #s) {
	(*p)·x + (*p)·y -> *s
}
rwfunc 造点(*int64 #a, *int64 #b) -> (*点 #r) {
	*a -> (*r)·x
	*b -> (*r)·y
}
rwfunc test() -> () {
	a:点 = {x=3 y=4}
	求和(a) -> s:int64
	println(s)
	r0:点 = {}
	造点(1, 2) -> r0
	求和(r0) -> s2:int64
	println(s2)
}
