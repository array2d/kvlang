
struct GNode {
	val:int64=0
	e0:*GNode=None
	e1:*GNode=None
	seen:bool=false
}

rwfunc dfs() -> (**GNode #node) {
	if (node != None) {
		(*node)·seen -> s
		if (!s) {
			n:*/lib/GNode = *node
			true -> (*n)·seen
			(*node)·val -> v
			println(v)
			(*node)·e0 -> a:*/lib/GNode
			dfs() -> a
			(*node)·e1 -> b:*/lib/GNode
			dfs() -> b
		}
	}
}

rwfunc test() -> () {
	/graph:'[int64]'GNode = {}
	/graph·1:GNode = {val=1}
	/graph·2:GNode = {val=2}
	/graph·3:GNode = {val=3}
	&/graph·2 -> /graph·1·e0
	&/graph·3 -> /graph·1·e1
	&/graph·3 -> /graph·2·e0
	&/graph·1 -> g1
	dfs() -> g1
}
