
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc reverse_list() -> (**Node #head, **Node #new_head) {
	prev:*/lib/Node = None
	cur:*/lib/Node = *head
	while (cur != None) {
		(*cur)·next -> nxt:*/lib/Node
		prev -> (*cur)·next
		prev = cur
		cur:*/lib/Node = nxt
	}
	prev -> *new_head
}

rwfunc test() -> () {
	n3:Node = {val=30}
	n2:Node = {val=20 next=&n3}
	n1:Node = {val=10 next=&n2}
	&n1 -> h:*/lib/Node
	reverse_list() -> h:*/lib/Node, head:*/lib/Node
	head -> cur:*/lib/Node
	while (cur != None) {
		(*cur)·val -> v:int64
		println(v)
		(*cur)·next -> cur
	}
}
