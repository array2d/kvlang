
struct TNode {
	val:int64=0
	left:*TNode=None
	right:*TNode=None
}

rwfunc inorder(*TNode #node) -> () {
	if (node != None) {
		(*node)·left -> l:*/lib/TNode
		inorder(l)
		(*node)·val -> v:int64
		println(v)
		(*node)·right -> r:*/lib/TNode
		inorder(r)
	}
}

rwfunc test() -> () {
	/tree:'[int64]'TNode = {}
	/tree·1:TNode = {val=5}
	/tree·2:TNode = {val=3}
	/tree·3:TNode = {val=8}
	&/tree·2 -> /tree·1·left
	&/tree·3 -> /tree·1·right
	inorder(&/tree·1)
}
