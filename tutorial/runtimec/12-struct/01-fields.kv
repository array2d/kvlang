
struct User {
	name:[]char/utf32="anon"
	age:int64=0
	active:bool=false
}

rwfunc test() -> () {
	u:User = {name="alice" age=30 active=true}
	u·name, u·age, u·active -> n:[]char/utf32, a:int64, ac:bool
	println(n, a, ac)
	d:User = {}
	d·name, d·age, d·active -> dn:[]char/utf32, da:int64, dac:bool
	println(dn, da, dac)
}
