
rwfunc test() -> () {
	string·formatint(255, 16) -> hex:char/utf32
	println(hex)
	string·formatuint(255, 2) -> bin:char/utf32
	println(bin)
	string·formatint(-42, 10) -> neg:char/utf32
	println(neg)
	string·parseint("ff", 16) -> n:int64
	println(n)
	string·parseuint("101", 2) -> u:uint64
	println(u)
	string·parsefloat("3.5") -> f:float64
	println("f=", f)
	string·parsefloat("-1e3") -> g:float64
	println("g=", g)
}
