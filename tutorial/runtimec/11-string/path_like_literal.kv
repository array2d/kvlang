// path_like_literal: quoted strings starting with `/` are string literals, not kvspace reads
// (unquoted `/tmp/...` reads kvspace); path strings also work consistently as member bases.
// Expected output:
//   p= /tmp/plk.txt
//   sep= /
//   v= 42
//   s= /tmp/plk·data
//   via-base= 7
//   via-abs= 7
rwfunc test() -> () {
	p = "/tmp/plk.txt"
	println("p=", p)
	"/" -> sep
	println("sep=", sep)
	/tmp/plk:int64·int64 = {}
	42 -> /tmp/plk·data
	/tmp/plk·data -> v
	println("v=", v)
	"/tmp/plk·data" -> s
	println("s=", s)
	/tmp/plm:[]char/utf32·int64 = {}
	"/tmp/plm" -> h
	k = "a"
	7 -> h·*k
	h·*k -> r
	println("via-base=", r)
	/tmp/plm·a -> r2
	println("via-abs=", r2)
}
