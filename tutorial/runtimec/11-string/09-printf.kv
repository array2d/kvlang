
rwfunc test() -> () {
	printf("[%d,%d]\n", 3, 7)
	printf("|%5d|%-5d|%05d|%+d|\n", 42, 42, 42, 42)
	printf("|%x|%X|%08x|%o|\n", 255, 255, 255, 64)
	printf("pi=%.2f\n", 3.14159)
	printf("|%8.2f|%-8.2f|\n", 3.14159, 3.14159)
	printf("|%s|%10s|%-10s|%.3s|\n", "hi", "hi", "hi", "hello")
	printf("%c%c\n", 65, 66)
	printf("%d%%\n", 50)
}
