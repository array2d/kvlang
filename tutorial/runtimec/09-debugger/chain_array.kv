// 期望阻塞: debugger 由 byteseek stdlib 提供，本 runner 不装载 stdlib
// 深层数组参数链路：main → f1 → f2 → f3
// 在 f3 最深处 debugger() 暂停，dump kvspace 看调用栈与参数槽
rwfunc f3() -> (*[]int64 $a, *int64 $s) {
	println((*a)[0])
	debugger()          // 在此暂停
	(*a)[0] -> v0:int64
	(*a)[1] -> v1:int64
	v0 + v1 -> *s        // 30 + 40 = 70
}

rwfunc f2() -> (*[]int64 $a, *int64 $s) {
	[30, 40] -> *a        // 数组直接落写参槽，不拷贝
	f3() -> (*a, *s)    // 传给 f3 的写参，同路径直达
}

rwfunc f1() -> (*int64 $s) {
	f2() -> (_, *s)     // 接收 s，丢弃数组
}

rwfunc test() -> () {
	f1() -> r:int64
	println(r)            // 70
}
