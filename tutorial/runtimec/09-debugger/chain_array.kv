
rwfunc f3() -> (*[]int64 #a, *int64 #s) {
	println((*a)[0])
	debugger()          
	(*a)[0] -> v0:int64
	(*a)[1] -> v1:int64
	v0 + v1 -> *s        
}

rwfunc f2() -> (*[]int64 #a, *int64 #s) {
	[30, 40] -> *a        
	f3() -> (*a, *s)    
}

rwfunc f1() -> (*int64 #s) {
	f2() -> (_, *s)     
}

rwfunc test() -> () {
	f1() -> r:int64
	println(r)            
}
