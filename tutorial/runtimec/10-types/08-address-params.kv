
rwfunc inc(*int64 #x) -> (*int64 #r) {
    *x + 1 -> *r
}
rwfunc bump() -> (*int64 #p) {
    *p + 1 -> *p
}
rwfunc own() -> (*int64 #t) {
    *t + 100 -> *t
}
rwfunc test() -> () {
    3 -> v:int64
    inc(v) -> r:int64
    println("inc r=", r, " v=", v)
    bump() -> v
    println("bump v=", v)
    own() -> v
    println("own v=", v)
}
