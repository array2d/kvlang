// 语义: []char/utf8·[]char/utf32 —— key 侧 []char/utf8 字符串键，value 侧完整 kindexpr。
//       = Go map[string]string。建 map 用成员赋值 d·key = v；字符串恒 []char/<enc>。
// 期望输出:
//   en = hello
//   zh = 你好
//   missing: true
rwfunc lookup(*'[]char/utf8'[]char/utf32 $dict, *[]char/utf32 $k) -> (*[]char/utf32 $v) {
	(*dict)·*k -> *v
}
rwfunc test() -> () {
	d:'[]char/utf8'[]char/utf32 = {}
	d·en = "hello"
	d·zh = "你好"
	lookup(d, "en") -> a:[]char/utf32
	println("en =", a)
	lookup(d, "zh") -> b:[]char/utf32
	println("zh =", b)
	d·*"fr" == None -> gone:bool
	println("missing:", gone)
}
