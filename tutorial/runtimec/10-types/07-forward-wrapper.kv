// 语义: 转发/包装函数**必须**写全签名——参数与返回的类型逐一声明，不做隐式推断。
//       省略标注由 layout 直接报错（`param "a": unknown type (got "")`）；
//       这是有意的严格化：类型是调用契约，不在包装层被悄悄抹掉。
// 期望输出:
//   3
rwfunc plus(*int64 $a, *int64 $b) -> (*int64 $c) {
	*a + *b -> *c
}
rwfunc wrap(*int64 $a, *int64 $b) -> (*int64 $c) {
	plus(*a, *b) -> *c
}
rwfunc test() -> () {
	wrap(1, 2) -> c:int64
	println(c)
}
