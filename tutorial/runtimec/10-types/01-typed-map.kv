
rwfunc total(*'[]char/utf8'int64 #m) -> (*int64 #s) {
	(*m)·*"a" -> a:int64
	(*m)·*"b" -> b:int64
	(a + b) -> *s
}
rwfunc max2(*'[]char/utf8'int64 #m) -> (*int64 #mx) {
	(*m)·*"a" -> a:int64
	(*m)·*"b" -> b:int64
	max(a, b) -> *mx
}
rwfunc test() -> () {
	d:'[]char/utf8'int64 = {}
	d·a = 10
	d·b = 20
	total(d) -> t:int64
	println("total =", t)
	max2(d) -> mm:int64
	println("max =", mm)
}
