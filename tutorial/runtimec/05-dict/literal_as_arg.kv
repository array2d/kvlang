
rwfunc count(*'[int64]'[]char/utf32 #a) -> (*int64 #n) {
	pathspace·listlen(*a) -> *n
}
rwfunc first(*'[int64]'[]char/utf32 #a) -> (*[]char/utf32 #v) {
	(*a)·*"[0]" -> *v
}
rwfunc test() -> () {
	args:'[int64]'[]char/utf32 = {"a", "b", "c"}
	count(args) -> n:int64
	println(n)
	one:'[int64]'[]char/utf32 = {"hi"}
	first(one) -> v:[]char/utf32
	println(v)
}
