
rwfunc test() -> () {
	/tmp/adk:'int64'int64 = {}
	i:int64 = 0
	while (i < 3) {
		v:int64 = i × 10
		/tmp/adk·*i = v
		i = i + 1
	}
	j:int64 = 0
	/tmp/adk·*j -> a0:int64
	j = 1
	"/tmp/adk"·*j -> a1:char/utf32
	j = 2
	/tmp/adk·*j -> a2:int64
	println("a0=", a0, "a1=", a1, "a2=", a2)
	/tmp/adb:'int64'int64 = {}
	k:int64 = 1
	while (k < 3) {
		k + 100 -> /tmp/adb·*k
		k = k + 1
	}
	/tmp/adb·1 -> b1:int64
	/tmp/adb·2 -> b2:int64
	println("b1=", b1, "b2=", b2)
	/tmp/ads:'[]char/utf32'int64 = {}
	name:[]char/utf32 = "x"
	5 -> /tmp/ads·*name
	/tmp/ads·x -> s:int64
	println("s=", s)
}
