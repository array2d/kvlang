
rwfunc test() -> () {
	
	5 + 3 -> a:int64
	println(a)
	7 - 2 - 2 -> b:int64
	println(b)
	
	7.5 ÷ 3 -> c:float64
	7.5 ÷ 3 -> c_m:float64
	println(c_m)
	println(c)
	7 % 3 -> d:int64
	println(d)

	5 & 3 -> e:int64
	println(e)
	neg(2) -> f:int64
	println(f)
	3 | 4 -> g:int64
	println(g)

	5 > 3 -> h:bool
	println(h)
	3 > 5 -> i:bool
	println(i)
	
	3 == 3.0 -> j:bool
	println(j)

	sqrt(64.0) -> k:float64
	√(64.0) -> k_m:float64
	println(k_m)
	println(k)
	abs(-3) -> l:int64
	println(l)
	pow(2, 3) -> m:float64
	println(m)
	log(exp(1.0)) -> n:float64
	println(n)

	max(max(1, 3), 2) -> o:int64
	println(o)

	"a" + "bc" -> p:[]char/utf32
	println(p)

	string·cmp("a", "b") -> q:int64
	println(q)

	true == true -> r:bool
	println(r)
}
