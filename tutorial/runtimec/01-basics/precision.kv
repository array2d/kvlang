
rwfunc test() -> () {
	a:int64 = 2 + 3
	println(a)
	b:float64 = 2 + 3.5
	println(b)
	1.5 × 2 -> c:float64
	1.5 × 2 -> c_m:float64
	println(c_m)
	println(c)

	q:int64 = 7 ÷ 2
	q_m:int64 = 7 ÷ 2
	println(q_m)
	println(q)
	-9 ÷ 2 -> qz:int64
	-9 ÷ 2 -> qz_m:int64
	println(qz_m)
	println(qz)
	fq:float64 = 7.0 ÷ 2
	fq_m:float64 = 7.0 ÷ 2
	println(fq_m)
	println(fq)
	r:int64 = 7 % 3
	println(r)

	ti:int64 = int64(3.99)
	println(ti)
	float64(7) -> tf:float64
	println(tf)

	sci:float64 = 1e3
	println(sci)
	small:float64 = 2.5e-2
	println(small)

	0.1 + 0.2 -> sum:float64
	println(sum)

	eq:bool = 3 == 3.0
	println(eq)

	big:int64 = 9223372036854775807
	println(big)

	big - 1 -> bm:int64
	println(bm)
	precise:int64 = 9007199254740993 + 0
	println(precise)
	same:bool = big == 9223372036854775806
	println(same)
}
