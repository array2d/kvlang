
rwfunc divmod_loop(*int64 #n) -> (*int64 #q) {
	
	*q = 0
	m:int64 = -9223372036854775807 - 1
	i:int64 = 0
	while (i < *n) {
		*q = m ÷ -1
		i:int64 = i + 1
	}
}
rwfunc mod_loop(*int64 #n) -> (*int64 #r) {
	*r = 7
	m:int64 = -9223372036854775807 - 1
	i:int64 = 0
	while (i < *n) {
		*r = m % -1
		i = i + 1
	}
}
rwfunc test() -> () {
	a:int64 = -9223372036854775807 - 1
	b:int64 = -1
	a ÷ b -> c:int64
	println("a/b =", c)
	a % b -> d:int64
	println("a%b =", d)
	println("loop q =", divmod_loop(3))
	println("loop r =", mod_loop(3))
	mx:int64 = 9223372036854775807
	mx + 1 -> e:int64
	println("max+1 =", e)
	a - 1 -> f:int64
	println("min-1 =", f)
	a × b -> g:int64
	println("min*-1 =", g)
	-a -> h:int64
	println("neg min =", h)
	abs(a) -> k:int64
	println("abs min =", k)
	int32(-2147483648) ÷ int32(-1) -> i32:int32
	println("i32 min/-1 =", i32)
	int8(-128) ÷ int8(-1) -> i8:int8
	println("i8 min/-1 =", i8)
	-7 ÷ 2 -> t1:int64
	println("-7/2 =", t1)
	-7 % 2 -> t2:int64
	println("-7%2 =", t2)
	big:uint64 = uint64(18446744073709551615)
	u3:uint64 = uint64(3)
	u4:uint64 = uint64(4)
	u3 + u4 -> s1:uint64
	println("u64 3+4 =", s1)
	u3 - u4 -> s2:uint64
	println("u64 3-4 =", s2)
	big × u3 -> s3:uint64
	println("u64max*3 =", s3)
	big ÷ uint64(2) -> s4:uint64
	println("u64max/2 =", s4)
	big % uint64(10) -> s5:uint64
	println("u64max%10 =", s5)
	big >> uint64(60) -> s6:uint64
	println("u64max>>60 =", s6)
	uint64(1) << uint64(63) -> s7:uint64
	println("u64 1<<63 =", s7)
	max(big, u3) -> s8:uint64
	println("u64 max(big,3) =", s8)
	min(big, u3) -> s9:uint64
	println("u64 min(big,3) =", s9)
	big > u3 -> c1:bool
	println("u64 big>3 =", c1)
	big < u3 -> c2:bool
	println("u64 big<3 =", c2)
	uint8(200) + uint8(100) -> b1:uint8
	println("u8 200+100 =", b1)
	uint8(200) ÷ uint8(3) -> b2:uint8
	println("u8 200/3 =", b2)
}
