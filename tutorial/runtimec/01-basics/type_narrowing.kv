
rwfunc test() -> () {
        
        int8(127) + int8(1) -> a:int8
        println(a)

        uint8(255) + uint8(1) -> b:uint8
        println(b)

        float32(16777216) + float32(1) -> c:float32
        println(c)

        int8(100) × int16(2) -> d:int16
        int8(100) × int16(2) -> d_m:int16
        println(d_m)
        println(d)

        int8(120) ÷ int8(10) -> e:int8
        int8(120) ÷ int8(10) -> e_m:int8
        println(e_m)
        println(e)

        int8(120) ÷ float32(10) -> f:float32
        int8(120) ÷ float32(10) -> f_m:float32
        println(f_m)
        println(f)

        int8(7) % int16(3) -> g:int16
        println(g)

        neg(9223372036854775807) -> h:int64
        println(h)

        int32(100) × int32(100) -> i:int32
        int32(100) × int32(100) -> i_m:int32
        println(i_m)
        println(i)
}
