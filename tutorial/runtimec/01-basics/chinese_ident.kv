
lib 数学/几何 {
	rwfunc 相加(*int64 #甲, *int64 #乙) -> (*int64 #和) {
		*甲 + *乙 -> *和
	}
}

lib 外层 {
	lib 内层 {
		rwfunc 问候() -> () { println("嵌套问候") }
	}
}

struct 点 {
	横:float64=0.0
	纵:float64=0.0
}

rwfunc test() -> () {
	数学/几何·相加(3, 4) -> 结果:int64
	println("相加 =", 结果)
	/lib/数学/几何·相加(10, 20) -> 结果2:int64
	println("相加 =", 结果2)
	/lib/外层/内层·问候()
	原点:点 = {横=3.0 纵=4.0}
	原点·横 -> x:float64
	原点·纵 -> y:float64
	println("点 =", x, y)
}
