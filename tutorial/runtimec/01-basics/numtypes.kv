
rwfunc test() -> () {
	f:float32 = float32(3)
	println(f)
	i:int8 = int8(0.1)
	println(i)
	int8(300) -> w:int8
	println(w)

	println(uint8(-1))
	println(int16(70000))
	println(int32(2147483648))
	println(uint32(-1))
	println(uint64(18446744073709551615))

	p32:float32 = float32(0.1)
	println(p32)
	println(float32(16777217))

	sum:int8 = w + 1
	println(sum)
	int16(-2) -> n:int16
	println(n)
}
