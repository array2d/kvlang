
rwfunc replace_at(*[]char/utf32 #s, *int64 #i,*[]char/utf32 #ch) -> (*[]char/utf32 #r) {
	*s -> *r
	(*r)[*i] = (*ch)[0]
}

rwfunc test() -> () {
	s:[]char/utf32 = "hello"
	println(s[1])
	replace_at(s, 0, "H") -> s
	println(s)

	t:[]char/utf32 = "kv" + "lang"
	println(t)
	s + " " + t -> w:[]char/utf32
	println(w)
	println(string·len(w))

	println(string·cmp("abc", "abd"))
	println(string·cmp("x", "x"))
	println(string·find(w, "kv"))
	println(string·find(w, "zz"))

	c:char/utf32 = w[3]
	println(c)
	println(string·ord(c))
}
