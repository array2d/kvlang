
rwfunc test() -> () {
    
    int8(127) + int8(1) -> i8:int8
    println(i8)
    println(int16(32767))
    println(int32(2147483647))
    println(int64(9223372036854775807))

    println(uint8(255))
    println(uint16(65535))
    println(uint32(4294967295))
    println(uint64(18446744073709551615))

    a:float32 = float32(3.14)
    println(a)
    println(float32(3.141592653589793))

    b:float64 = float64(3.141592653589793)
    println(b)

    b -> f64:float64
    println(int64(f64))
    println(int32(3.9))
    println(int32(-2.7))
    println(int64(0.5))

    42.9 -> x:float64
    println(int8(x))
    println(int16(x))
    println(int32(x))
    println(int64(x))
    println(uint64(x))
}
