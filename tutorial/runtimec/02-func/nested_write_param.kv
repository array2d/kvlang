// nested_write_param: forwarded write-params across nested pure-memory and kvspace frames
// must propagate updated values to every intermediate and outer caller slot.
// Expected output:
//   outer1 a= 3
//   f1= 3
//   outer a= 3  b= 4
//   f= 3  g= 4
//   fib(10) = 34 55
rwfunc inner(*int64 $n) -> (*int64 $a, *int64 $b) {
	*a = *n
	*b = 4
}
rwfunc outer1(*int64 $n) -> (*int64 $a) {
	inner(*n) -> (*a, _)
	println("outer1 a=", *a)
	x:int64 = *a + 1
}
rwfunc outer(*int64 $n) -> (*int64 $a, *int64 $b) {
	inner(*n) -> (*a, *b)
	println("outer a=", *a, " b=", *b)
}
rwfunc fib(*int64 $n) -> (*int64 $a, *int64 $b) {
	if (*n <= 1) {
		*a = 0
		1 -> *b
	} else {
		n1:int64 = *n - 1
		fib(n1) -> (*a, *b)
		x:int64 = *a + *b
		*b -> *a
		*b = x
	}
}
rwfunc test() -> () {
	outer1(3) -> f1:int64
	println("f1=", f1)
	outer(3) -> (f:int64, g:int64)
	println("f=", f, " g=", g)
	fib(10) -> (p:int64, q:int64)
	println("fib(10) =", p, q)
}
