// string_passthrough: 字符串变量作实参穿过多层调用不丢值
// 实参槽 [0,-k] 存的是键路径；resolve 只追显式 Ptr，勿把 char 值当路径再追（否则第二层即 None）
// 期望输出:
//   L1: hello world
//   L2: hello world
//   L3: hello world
//   L2 int: 42
//   L2 path-like: /lib
rwfunc show(*[]char/utf32 #x, *[]char/utf32 #tag) -> () {
	println(*tag, *x)
}

rwfunc show2(*[]char/utf32 #x, *[]char/utf32 #tag) -> () {
	show(*x, *tag)
}

rwfunc show3(*[]char/utf32 #x, *[]char/utf32 #tag) -> () {
	show2(*x, *tag)
}

rwfunc showi(*int64 #n) -> () {
	println("L2 int:", *n)
}

rwfunc showi2(*int64 #n) -> () {
	showi(*n)
}

rwfunc test() -> () {
	s:[]char/utf32 = "hello world"
	show(s, "L1:")
	show2(s, "L2:")
	show3(s, "L3:")
	k:int64 = 42
	showi2(k)
	p:[]char/utf32 = "/lib"
	show2(p, "L2 path-like:")
}
