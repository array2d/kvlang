// stop_caller_locals: handoff Stop (e.g. println in a direct or transitive callee) must
// flush caller locals and use kvspace frames for callers that may transitively Stop.
// Expected output:
//   in f r= 8
//   in g r= 8
//   x= 5  y= 7  z= 8
//   leaf n= 6
//   x= 5  w= 16
rwfunc f(*int64 #n) -> (*int64 #r) {
	*r = *n + 1
	println("in f r=", *r)
}
rwfunc g(*int64 #n) -> (*int64 #r) {
	f(*n) -> *r
	println("in g r=", *r)
}
rwfunc leaf(*int64 #n) -> () {
	println("leaf n=", *n)
}
rwfunc mid(*int64 #n) -> (*int64 #r) {
	*r = *n + 1
	leaf(*r)
	*r = *r + 10
}
rwfunc test() -> () {
	x:int64 = 5
	y:int64 = x + 2
	g(y) -> z:int64
	println("x=", x, " y=", y, " z=", z)
	mid(x) -> w:int64
	println("x=", x, " w=", w)
}
