
rwfunc sum(*[]int64 #arr) -> (*int64 #acc) {
	n:int64 = compactarray·numel(*arr)
	0 -> *acc  
	0 -> i:int64
	while (i < n) {
		*acc + (*arr)[i] -> *acc
		i = i + 1
	}
}

rwfunc rsum(*[]int64 #arr, *int64 #i, *int64 #acc) -> (*int64 #r) {
	n:int64 = compactarray·numel(*arr)

	if (*i >= n) {
		*acc -> *r
	} else {
		rsum(*arr, *i + 1, *acc + (*arr)[*i]) -> *r
	}
}

rwfunc test() -> () {
	a1:[]int64 = [1, 2, 3, 4]
	sum(a1) -> s1:int64
	println(s1)
	a2:[]int64 = [1, 2, 3, 4]
	rsum(a2, 0, 0) -> s2:int64
	println(s2)
}
