
rwfunc generate(*int64 #num_rows) -> () {
	/tmp/cur:'[int64]'int64 = {}
	
	/tmp/pt:'[int64]'int64 = {}
	1 -> "/tmp/pt"·*0
	println(1)
	if (*num_rows == 1) { }
	r:int64 = 1
	while (r < *num_rows) {
		println(1)
		1 -> "/tmp/cur"·*0
		i:int64 = 1
		while (i < r) {
			i - 1 -> im1:int64
			"/tmp/pt"·*im1 -> a:char/utf32
			"/tmp/pt"·*i -> b:char/utf32
			v:[]char/utf32 = a + b
			println(v)
			v -> "/tmp/cur"·*i
			i + 1 -> i
		}
		println(1)
		1 -> "/tmp/cur"·*r
		
		k:int64 = 0
		while (k <= r) {
			"/tmp/cur"·*k -> val:char/utf32
			val -> "/tmp/pt"·*k
			k + 1 -> k
		}
		r + 1 -> r
	}
}

rwfunc test() -> () {
	generate(5)
}
