
struct TNode {
	val:int64=0
	left:*TNode=None
	right:*TNode=None
}

rwfunc inorder(**TNode #root) -> () {
	
	si = 0
	stack:[int64]·*TNode = {}
	cur = *root
	while (cur != None || si > 0) {
		while (cur != None) {
			cur -> stack·*si
			si + 1 -> si
			(*cur)·left -> cur
		}
		si - 1 -> si
		stack·*si -> node
		(*node)·val -> v
		println(v)
		(*node)·right -> cur
	}
}

rwfunc test() -> () {
	n2:TNode = {val=2}
	n3:TNode = {val=3}
	n1:TNode = {val=1 left=&n2 right=&n3}
	&n1 -> root
	inorder(root)
}
