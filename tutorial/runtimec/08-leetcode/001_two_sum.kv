
rwfunc two_sum(*[]int64 #nums, *int64 #target) -> () {
	n:int64 = compactarray·numel(*nums)
	found:int64 = 0
	0 -> i:int64
	while (i < n) {
		j:int64 = 0
		while (j < n) {
			sk:bool = i == j

			if (sk) {
				j + 1 -> j
			} else {
				x:int64 = (*nums)[i]
				y:int64 = (*nums)[j]
				x + y -> s:int64
				hit:bool = s == *target

				if (hit) {
					println("[", i, ",", j, "]")
					found = 1
					n -> i
					j = n
				} else {
					j = j + 1
				}
			}
		}
		i + 1 -> i
	}
	nf:bool = found == 0

	if (nf) {
		println("[-1, -1]")
	}
}

rwfunc test() -> () {

	a1:[]int64 = [2, 7, 11, 15]
	two_sum(a1, 9)
	a2:[]int64 = [1, 2, 3]
	two_sum(a2, 99)
}
