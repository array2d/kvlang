
rwfunc near_dup(*[]int64 #nums, *int64 #k) -> () {
	n:int64 = compactarray·numel(*nums)
	h:'[]char/utf8'int64 = {}
	found:bool = false
	0 -> i:int64
	while (i < n) {
		(*nums)[i] -> x:int64
		h·*x != None -> exists:bool

		if (exists) {
			h·*x -> j:int64
			if (j > 0) {
				d:int64 = i - j + 1

				if (d <= *k) {
					true -> found
					n -> i
				}
			}
		}
		if (found == false) {
			i + 1 -> h·*x
		}
		i = i + 1
	}
	if (found) {
		println("true")
	} else {
		println("false")
	}
}

rwfunc test() -> () {

	a1:[]int64 = [1, 2, 3, 1]
	near_dup(a1, 3)
	a2:[]int64 = [1, 2, 3, 1, 2, 3]
	near_dup(a2, 2)
}
