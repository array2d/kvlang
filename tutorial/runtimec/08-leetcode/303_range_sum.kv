
rwfunc range_sum() -> () {
	a:[]int64 = [-2, 0, 3, -5, 2, -1]
	n:int64 = compactarray·numel(a)
	
	[0, 0, 0, 0, 0, 0] -> p:[]int64
	s:int64 = a[0]
	p[0] = s
	i:int64 = 1
	while (i < n) {
		a[i] -> v:int64
		s = s + v
		p[i] = s
		i = i + 1
	}
	
	p[2] -> r1:int64
	println(r1)
	
	t2:int64 = p[5]
	t1:int64 = p[1]
	t2 - t1 -> r2:int64
	println(r2)
}

rwfunc test() -> () {

	range_sum()
}
