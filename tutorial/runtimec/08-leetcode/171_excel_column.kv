// 171: Excel Sheet Column Number — 26进制转数字
// 来源: LeetCode #171
// 期望输出:
//   28
rwfunc title_to_num(*[]char/utf32 $s) -> () {
	string·len(*s) -> n:int64
	result:int64 = 0
	i:int64 = 0
	while (i < n) {
		result × 26 -> r26:int64
		result × 26 -> r26_m:int64
		c:char/utf32 = string·char(*s, i)
		v:int64 = string·ord(c) - 65
		v + 1 -> d:int64
		result = r26 + d
		i = i + 1
	}
	println(result)
}

rwfunc test() -> () {

	title_to_num("AB")
}
