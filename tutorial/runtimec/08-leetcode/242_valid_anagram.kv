
rwfunc is_anagram(*[]char/utf32 #s, *[]char/utf32 #t) -> () {
	ns:int64 = string·len(*s)
	nt:int64 = string·len(*t)
	ok:bool = true

	if (ns != nt) {
		false -> ok
	} else {
		h:'[]char/utf8'int64 = {}
		0 -> i:int64
		while (i < ns) {
			string·char(*s, i) -> c:char/utf32
			h·*c != None -> exists:bool
			if (exists) {
				h·*c + 1 -> h·*c
			} else {
				1 -> h·*c
			}
			i = i + 1
		}
		0 -> i
		while (i < nt) {
			string·char(*t, i) -> c
			h·*c != None -> exists
			if (exists) {
				h·*c -> v:int64
				v - 1 -> h·*c
			} else {
				false -> ok
				nt -> i
			}
			i + 1 -> i
		}
		0 -> i
		while (i < ns) {
			string·char(*s, i) -> c
			h·*c -> v

			if (v != 0) {
				false -> ok
				ns -> i
			}
			i = i + 1
		}
	}
	if (ok) {
		println("true")
	} else {
		println("false")
	}
}

rwfunc test() -> () {

	is_anagram("anagram", "nagaram")
	is_anagram("rat", "car")
}
