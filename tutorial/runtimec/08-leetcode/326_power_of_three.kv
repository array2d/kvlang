// 326: Power of Three — 判断3的幂
// 来源: LeetCode #326
// 期望输出:
//   1
//   0
rwfunc is_power3(*int64 $n) -> () {
	pos:bool = *n > 0

	if (pos) {
		t:int64 = 1
		while (t < *n) {
			t × 3 -> t
			t × 3 -> t_m:int64
		}
		eq:bool = t == *n

		if (eq) {
			println(1)
		} else {
			println(0)
		}
	} else {
		println(0)
	}
}

rwfunc test() -> () {

	is_power3(27)
	is_power3(45)
}
