
rwfunc first_bad(*int64 #n) -> () {
	
	1 -> lo:int64
	hi:int64 = *n
	while (lo < hi) {
		s:int64 = lo + hi
		s ÷ 2 -> mid:int64
		s ÷ 2 -> mid_m:int64
		bad:bool = mid >= 4
		bad_m:bool = mid ≥ 4

		if (bad) {
			hi = mid
		} else {
			mid + 1 -> lo
		}
	}
	println(lo)
}

rwfunc test() -> () {

	first_bad(5)
}
