// 278: First Bad Version — 二分查找第一个坏版本
// 来源: LeetCode #278
// 期望输出:
//   4
rwfunc first_bad(*int64 $n) -> () {
	// isBadVersion(i) = i >= 4
	1 -> lo:int64
	hi:int64 = *n
	while (lo < hi) {
		s:int64 = lo + hi
		s ÷ 2 -> mid:int64
		s ÷ 2 -> mid_m:int64
		bad:bool = mid >= 4
		bad_m:bool = mid ≥ 4

		if (bad) {
			hi = mid
		} else {
			mid + 1 -> lo
		}
	}
	println(lo)
}

rwfunc test() -> () {

	first_bad(5)
}
