// 038: Count and Say — 报数序列
// 来源: LeetCode #38
// 存储：(val, count) 交替排列在数组中
// 期望输出:
//   1
//   11
//   21
//   1211
//   111221
rwfunc next_seq(*int64 $src_len) -> (*int64 $dst_len) {
	/tmp/s2:'[int64]'int64 = {}
	i:int64 = 0
	di:int64 = 0
	while (i < *src_len) {
		"/tmp/s"·*i -> cur:char/utf32
		count:int64 = 1
		j:int64 = i + 1
		while (j < *src_len) {
			"/tmp/s"·*j -> v:char/utf32
			if (v == cur) { count + 1 -> count ; j + 1 -> j }
			else { *src_len -> j }
		}
			count -> "/tmp/s2"·*di
			di + 1 -> di1:int64
			cur -> "/tmp/s2"·*di1
		di + 2 -> di
		i + count -> i:int64
	}
	di -> *dst_len
}

rwfunc print_seq_len(*int64 $seq_len) -> () {
	i:int64 = 0
	while (i < *seq_len) {
		"/tmp/s"·*i -> cnt:char/utf32
		i + 1 -> i1:int64
		"/tmp/s"·*i1 -> val:char/utf32
		k:int64 = 0
		while (k < cnt) {
			print(val)
			k + 1 -> k
		}
		i + 2 -> i
	}
	println()
}

rwfunc copy_from_s2_to_s(*int64 $s2_len) -> () {
	i = 0
	while (i < *s2_len) {
		/tmp/s2[i] -> v
		v -> "/tmp/s"·*i
		i + 1 -> i
	}
}

rwfunc count_and_say(*int64 $N) -> () {
	/tmp/s:'[int64]'int64 = {}
	1 -> "/tmp/s"·*0
	1 -> "/tmp/s"·*1
	cur_len = 2
	round = 1
	while (round < *N) {
		l = next_seq(cur_len)
		copy_from_s2_to_s(l)
		l -> cur_len
		round + 1 -> round
	}
	print_seq_len(cur_len)
}

rwfunc test() -> () {
	count_and_say(1)
	count_and_say(2)
	count_and_say(3)
	count_and_say(4)
	count_and_say(5)
}
