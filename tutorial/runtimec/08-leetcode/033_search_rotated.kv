// 033: Search in Rotated Sorted Array
// 算法: 二分查找 + 半区判断
// 来源: LeetCode #33
// 期望输出:
//   4
rwfunc search() -> () {
	a:[]int64 = [4, 5, 6, 7, 0, 1, 2]
	n:int64 = compactarray·numel(a)
	0 -> target:int64
	lo:int64 = 0
	hi:int64 = n - 1
	-1 -> result:int64
	while (lo <= hi) {
		s:int64 = lo + hi
		mid:int64 = s ÷ 2
		mid_m:int64 = s ÷ 2
		a[mid] -> mv:int64
		eq:bool = mv == target

		if (eq) {
			result = mid
			hi + 1 -> lo
		} else {
			lv:int64 = a[lo]
			rv:int64 = a[hi]
			lv <= mv -> left_sorted:bool
			lv ≤ mv -> left_sorted_m:bool

			if (left_sorted) {
				t1:bool = lv <= target
				t1_m:bool = lv ≤ target
				t2:bool = target < mv

				if (t1 && t2) {
					mid - 1 -> hi
				} else {
					lo = mid + 1
				}
			} else {
				t3:bool = mv <= target
				t3_m:bool = mv ≤ target
				target <= rv -> t4:bool
				target ≤ rv -> t4_m:bool

				if (t3 && t4) {
					lo = mid + 1
				} else {
					hi = mid - 1
				}
			}
		}
	}
	println(result)
}

rwfunc test() -> () {

	search()
}
