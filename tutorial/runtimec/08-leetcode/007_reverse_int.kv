
rwfunc reverse(*int64 #x) -> (*int64 #result) {
	neg:bool = *x < 0
	*x -> n:int64

	if (neg) {
		n = -*x
	}

	rev:int64 = 0
	while (n > 0) {
		rev × 10 -> r:int64
		rev × 10 -> r_m:int64
		d:int64 = n % 10
		rev = r + d
		n ÷ 10 -> n
		n ÷ 10 -> n_m:int64
	}

	if (neg) {
		*result = -rev
	} else {
		*result = rev
	}
}

rwfunc test() -> () {

	reverse(123) -> r1:int64
	println(r1)
	r2:int64 = reverse(-123)
	println(r2)
}
