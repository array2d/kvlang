// 008: String to Integer (atoi) — 字符串转整数
// 来源: LeetCode #8
// 简化: 不处理前导空格
// 期望输出:
//   42
//   -42
//   4193
rwfunc my_atoi(*[]char/utf32 #s) -> (*int64 #result) {
	*result = 0
	n:int64 = string·len(*s)
	i:int64 = 0
	sign:int64 = 1
	if ((*s)[i] == "-") { -1 -> sign ; i + 1 -> i }
	if ((*s)[i] == "+") { i + 1 -> i }
	while (i < n) {
		c2:char/utf32 = (*s)[i]
		digit:int64 = string·ord(c2) - 48
		if (digit >= 0 && digit <= 9) {
			*result = *result × 10 + digit
			result_m:int64 = *result × 10 + digit
			i + 1 -> i
		} else { n -> i }
	}
	*result = *result × sign
	result_m = *result × sign
}

rwfunc test() -> () {
	println(my_atoi("42"))
	println(my_atoi("-42"))
	println(my_atoi("4193"))
}
