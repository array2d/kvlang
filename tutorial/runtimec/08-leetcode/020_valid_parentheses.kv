// 020: Valid Parentheses — 栈匹配括号
// 来源: LeetCode #20
// 期望输出:
//   true
//   true
//   false
rwfunc is_valid(*[]char/utf32 $s) -> (*int64 $ok) {
	*ok = 1
	si:int64 = -1
	n:int64 = string·len(*s)
	i:int64 = 0
	while (i < n) {
		c:char/utf32 = (*s)[i]
		if (c == "(") {
			si + 1 -> si
			/tmp/vp:'[int64]'int64 = {}
			1 -> "/tmp/vp"·*si
		}
		if (c == "[") {
			si = si + 1
			2 -> "/tmp/vp"·*si
		}
		if (c == "{") {
			si + 1 -> si
			3 -> "/tmp/vp"·*si
		}
		if (c == ")") {
			if (si < 0) { 0 -> *ok ; n -> i }
			else {
				/tmp/vp[si] -> top:int64
				si - 1 -> si
				if (top != 1) { *ok = 0 ; n -> i }
			}
		}
		if (c == "]") {
			if (si < 0) { *ok = 0 ; i = n }
			else {
				/tmp/vp[si] -> top
				si - 1 -> si
				if (top != 2) { 0 -> *ok ; n -> i }
			}
		}
		if (c == "}") {
			if (si < 0) { 0 -> *ok ; i = n }
			else {
				/tmp/vp[si] -> top
				si = si - 1
				if (top != 3) { *ok = 0 ; i = n }
			}
		}
		i = i + 1
	}
	if (si >= 0) { 0 -> *ok }
}

rwfunc test() -> () {
	r1:int64 = is_valid("()")
	if (r1 == 1) { println("true") } else { println("false") }
	r2:int64 = is_valid("()[]{}")
	if (r2 == 1) { println("true") } else { println("false") }
	r3:int64 = is_valid("(]")
	if (r3 == 1) { println("true") } else { println("false") }
}
