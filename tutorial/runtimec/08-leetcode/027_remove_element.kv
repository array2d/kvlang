
rwfunc remove_element() -> () {
	a:[]int64 = [3, 2, 2, 3]
	3 -> val:int64
	n:int64 = compactarray·numel(a)
	k:int64 = 0
	0 -> i:int64
	while (i < n) {
		cur:int64 = a[i]
		skip:bool = cur == val

		if (skip) {
			i + 1 -> i
		} else {
			a[k] = cur
			k = k + 1
			i = i + 1
		}
	}
	println("k =", k)
	0 -> j:int64
	while (j < k) {
		v:int64 = a[j]
		println(v)
		j = j + 1
	}
}

rwfunc test() -> () {

	remove_element()
}
