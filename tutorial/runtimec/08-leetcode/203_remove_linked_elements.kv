
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc remove(*Node #head, *int64 #val) -> () {
	head -> p:*/lib/Node
	while (p != None) {
		v:int64 = (*p)·val
		v == *val -> skip:bool

		if (skip) {
		} else {
			println(v)
		}

		p = (*p)·next
	}
}

rwfunc test() -> () {
	n7:Node = {val=6}
	n6:Node = {val=5 next=&n7}
	n5:Node = {val=4 next=&n6}
	n4:Node = {val=3 next=&n5}
	n3:Node = {val=6 next=&n4}
	n2:Node = {val=2 next=&n3}
	n1:Node = {val=1 next=&n2}
	&n1 -> h:*/lib/Node
	remove(h, 6)
}
