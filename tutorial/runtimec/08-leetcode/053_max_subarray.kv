
rwfunc max_subarray(*[]int64 #nums) -> () {
	a:[]int64 = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
	n:int64 = compactarray·numel(a)
	a[0] -> cur:int64
	max:int64 = a[0]
	i:int64 = 1
	while (i < n) {
		a[i] -> x:int64
		curx:int64 = cur + x
		take_x:bool = x > curx

		if (take_x) {
			x -> cur
		} else {
			cur = curx
		}

		bigger:bool = cur > max

		if (bigger) {
			cur -> max
		}

		i = i + 1
	}
	println(max)
}

rwfunc test() -> () {

	nums:[]int64 = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
	max_subarray(nums)
}
