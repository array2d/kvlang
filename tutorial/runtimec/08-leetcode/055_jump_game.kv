
rwfunc can_jump(*[]int64 #nums) -> (*int64 #ok) {
	*ok = 1
	n:int64 = compactarray·numel(*nums)
	0 -> reach:int64
	i:int64 = 0
	while (i < n) {
		if (i > reach) {
			0 -> *ok
			n -> i
		} else {
			dist:int64 = (*nums)[i] + i
			if (dist > reach) { dist -> reach }
			if (reach >= n - 1) {
				n -> i
			}
			i + 1 -> i
		}
	}
}

rwfunc test() -> () {
	a1:[]int64 = [2, 3, 1, 1, 4]
	a2:[]int64 = [3, 2, 1, 0, 4]
	r1:int64 = can_jump(a1)
	if (r1 == 1) { println("true") } else { println("false") }
	r2:int64 = can_jump(a2)
	if (r2 == 1) { println("true") } else { println("false") }
}
