// 263: Ugly Number
// 来源: LeetCode #263
// 期望输出:
//   1
rwfunc is_ugly(*int64 $n) -> () {
	*n -> nv:int64
	bad:bool = nv <= 0
	bad_m:bool = nv ≤ 0

	if (bad) {
		println(0)
	} else {
		nv % 2 -> r2:int64
		while (r2 == 0) {
			nv = nv ÷ 2
			nv_m:int64 = nv ÷ 2
			r2 = nv % 2
		}
		nv % 3 -> r3:int64
		while (r3 == 0) {
			nv = nv ÷ 3
			nv_m = nv ÷ 3
			r3 = nv % 3
		}
		nv % 5 -> r5:int64
		while (r5 == 0) {
			nv = nv ÷ 5
			nv_m = nv ÷ 5
			r5 = nv % 5
		}
		nv == 1 -> ok:bool

		if (ok) {
			println(1)
		} else {
			println(0)
		}
	}
}

rwfunc test() -> () {

	is_ugly(6)
}
