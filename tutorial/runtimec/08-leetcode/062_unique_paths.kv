
rwfunc dp(*int64 #m, *int64 #n) -> (*int64 #result) {
	/tmp/up:'[int64]'int64 = {}
	i:int64 = 0
	while (i < *n) {
		1 -> "/tmp/up"·*i
		i + 1 -> i
	}
	j:int64 = 1
	while (j < *m) {
		k:int64 = 1
		while (k < *n) {
			"/tmp/up"·*k -> v:char/utf32
			k - 1 -> km1:int64
			"/tmp/up"·*km1 -> prev:char/utf32
			prev + v -> "/tmp/up"·*k
			k + 1 -> k
		}
		j + 1 -> j
	}
	*n - 1 -> last:int64
	"/tmp/up"·*last -> *result
}

rwfunc test() -> () {
	r1 = dp(3, 7)
	println(r1)
	r2 = dp(3, 2)
	println(r2)
}
