
rwfunc sort_colors() -> () {
	nums:[]int64 = [2, 0, 2, 1, 1, 0]
	n:int64 = compactarray·numel(nums)
	lo:int64 = 0
	mid:int64 = 0
	hi:int64 = n - 1
	while (mid <= hi) {
		nums[mid] -> v:int64
		if (v == 0) {
			nums[lo] -> t:int64
			nums[mid] = t
			nums[lo] = v
			lo + 1 -> lo
			mid = mid + 1
		}
		else if (v == 1) {
			mid + 1 -> mid
		}
		else {
			nums[hi] -> t
			nums[mid] = t
			nums[hi] = v
			hi - 1 -> hi
		}
	}
	i:int64 = 0
	while (i < n) {
		println(nums[i])
		i + 1 -> i
	}
}

rwfunc test() -> () {
	sort_colors()
}
