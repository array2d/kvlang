// 022: Generate Parentheses — 生成 n=2 的括号组合
// 来源: LeetCode #22
// 期望输出:
//   (())
//   ()()
rwfunc generate() -> () {
	total:int64 = 16
	idx:int64 = 0
	while (idx < total) {
		bal:int64 = 0
		ok2:int64 = 1
		s:[]char/utf32 = ""
		pow:int64 = 8
		while (pow > 0) {
			bit:int64 = (idx ÷ pow) % 2
			bit_m:int64 = (idx ÷ pow) % 2
			if (bit == 0) {
				s + "(" -> s
				bal + 1 -> bal
			} else {
				s + ")" -> s
				bal - 1 -> bal
				if (bal < 0) { 0 -> ok2 ; 0 -> pow }
			}
			pow ÷ 2 -> pow
			pow ÷ 2 -> pow_m:int64
		}
		if (bal == 0 && ok2 == 1 && string·len(s) == 4) { println(s) }
		idx + 1 -> idx
	}
}

rwfunc test() -> () {
	generate()
}
