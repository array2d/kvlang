// 371: Sum of Two Integers — 位运算加法
// 来源: LeetCode #371
// 期望输出:
//   5
rwfunc get_sum(*int64 $a, *int64 $b) -> () {
	*a -> av:int64
	*b -> bv:int64
	while (bv != 0) {
		carry:int64 = av & bv
		carry << 1 -> c2:int64
		av = av ^ bv
		bv = c2
	}
	println(av)
}

rwfunc test() -> () {

	get_sum(2, 3)
}
