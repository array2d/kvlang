// 048: Rotate Image — 原地旋转矩阵 90° 顺时针
// 来源: LeetCode #48
// 期望输出:
//   7
//   4
//   1
//   8
//   5
//   2
//   9
//   6
//   3
rwfunc rotate(*int64 #N) -> () {
	mat:[]int64 = [1, 2, 3, 4, 5, 6, 7, 8, 9]
	// transpose
	i:int64 = 0
	while (i < *N) {
		j:int64 = i + 1
		while (j < *N) {
			ri:int64 = i × *N + j
			ri_m:int64 = i × *N + j
			rj:int64 = j × *N + i
			rj_m:int64 = j × *N + i
			mat[ri] -> t:int64
			mat[rj] -> u:int64
			mat[ri] = u
			mat[rj] = t
			j + 1 -> j
		}
		i + 1 -> i
	}
	// reverse each row
	r:int64 = 0
	while (r < *N) {
		l:int64 = r × *N
		l_m:int64 = r × *N
		h:int64 = l + *N - 1
		while (l < h) {
			mat[l] -> v1:int64
			mat[h] -> v2:int64
			mat[l] = v2
			mat[h] = v1
			l + 1 -> l
			h - 1 -> h
		}
		r + 1 -> r
	}
	// print
	row:int64 = 0
	while (row < *N) {
		col:int64 = 0
		while (col < *N) {
			idx:int64 = row × *N + col
			idx_m:int64 = row × *N + col
			v:int64 = mat[idx]
			println(v)
			col + 1 -> col
		}
		row + 1 -> row
	}
}

rwfunc test() -> () {
	rotate(3)
}
