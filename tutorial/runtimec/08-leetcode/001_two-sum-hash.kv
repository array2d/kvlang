
rwfunc two_sum(*[]int64 #nums, *int64 #target) -> () {
	n:int64 = compactarray·numel(*nums)
	i:int64 = 0
	/tmp/two_sum:'int64'int64 = {}
	"/tmp/two_sum" -> h:[]char/utf32
	while (i < n) {
		x:int64 = (*nums)[i]
		need:int64 = *target - x
		h·*need != None -> exists:bool

		if (exists) {
			h·*need -> j:char/utf32
			k = j - 1
			println("[", k, ",", i, "]")
			n -> i
		} else {
			v:int64 = i + 1
			v -> h·*x
			i + 1 -> i
		}
	}
}

rwfunc two_sum2(*[]int64 #nums, *int64 #target) -> () {
	n = compactarray·numel(*nums)
	i = 0
	/tmp/two_sum:'int64'int64 = {}
	while (i < n) {
		x = (*nums)[i]
		need = *target - x
		
		exists = /tmp/two_sum·*need != None

		if (exists) {
			j = /tmp/two_sum·*need
			k = j - 1
			println("[", k, ",", i, "]")
			n -> i
		} else {
			v = i + 1
			/tmp/two_sum·*x = v
			i + 1 -> i
		}
	}
}

rwfunc test() -> () {

	a:[]int64 = [2, 7, 11, 15]
	two_sum(a, 9)
	two_sum2(a, 9)
}
