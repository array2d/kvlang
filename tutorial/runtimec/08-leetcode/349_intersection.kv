// 349: Intersection of Two Arrays — O(n²) 暴力
// 来源: LeetCode #349
// 期望输出:
//   2
rwfunc intersection() -> () {
	a:[]int64 = [1, 2, 2, 1]
	compactarray·numel(a) -> na:int64
	b:[]int64 = [2, 2]
	nb:int64 = compactarray·numel(b)
	[0, 0] -> r:[]int64
	idx:int64 = 0
	count:int64 = 0
	0 -> i:int64
	while (i < na) {
		av:int64 = a[i]
		j:int64 = 0
		false -> found:bool
		while (j < nb) {
			bv:int64 = b[j]
			match:bool = av == bv

			if (match) {
				true -> found
				j = nb
			} else {
				j = j + 1
			}
		}

		if (found) {
			r[idx] = av
			idx + 1 -> idx
			count = count + 1
		}

		i = i + 1
	}
	r[0] -> v:int64
	println(v)
}

rwfunc test() -> () {

	intersection()
}
