// 067: Add Binary — 二进制字符串加法
// 来源: LeetCode #67
// 期望输出:
//   100
//   10101
rwfunc add_binary(*[]char/utf32 $a, *[]char/utf32 $b) -> () {
	na:int64 = string·len(*a)
	nb:int64 = string·len(*b)
	carry:int64 = 0
	i:int64 = na - 1
	j:int64 = nb - 1
	result:[]char/utf32 = ""
	while (i >= 0 || j >= 0 || carry > 0) {
		sum:int64 = carry
		if (i >= 0) {
			if ((*a)[i] == "1") { sum + 1 -> sum }
			i = i - 1
		}
		if (j >= 0) {
			if ((*b)[j] == "1") { 1 + sum -> sum }
			j - 1 -> j
		}
		if (sum % 2 == 1) {
			result = "1" + result
		} else {
			"0" + result -> result
		}
		sum ÷ 2 -> carry
		sum ÷ 2 -> carry_m:int64
	}
	println(result)
}

rwfunc test() -> () {
	add_binary("11", "1")
	add_binary("1010", "1011")
}
