
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc reverse() -> (**Node #head) {
	prev:*/lib/Node = None
	cur:*/lib/Node = *head
	while (cur != None) {
		nxt:*/lib/Node = (*cur)·next
		(*cur)·next = prev
		prev = cur
		cur = nxt
	}
	p:*/lib/Node = prev
	while (p != None) {
		(*p)·val -> v:int64
		println(v)
		p = (*p)·next
	}
}

rwfunc test() -> () {
	n5:Node = {val=5}
	n4:Node = {val=4 next=&n5}
	n3:Node = {val=3 next=&n4}
	n2:Node = {val=2 next=&n3}
	n1:Node = {val=1 next=&n2}
	&n1 -> h:*/lib/Node
	reverse() -> h
}
