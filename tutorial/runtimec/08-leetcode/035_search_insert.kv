
rwfunc search_insert() -> () {
	a:[]int64 = [1, 3, 5, 6]
	5 -> target:int64
	n:int64 = compactarray·numel(a)
	lo:int64 = 0
	n - 1 -> hi:int64
	pos:int64 = 0
	while (lo <= hi) {
		s:int64 = lo + hi
		s ÷ 2 -> mid:int64
		s ÷ 2 -> mid_m:int64
		mv:int64 = a[mid]
		eq:bool = mv == target

		if (eq) {
			mid -> pos
			lo = hi + 1
		} else {
			lt:bool = mv < target

			if (lt) {
				mid + 1 -> lo
			} else {
				hi = mid - 1
			}
		}
	}
	not_found:bool = pos == 0

	if (not_found) {
		lo -> pos
	}

	println("index =", pos)
}

rwfunc test() -> () {

	search_insert()
}
