
rwfunc product() -> () {
	a:[]int64 = [1, 2, 3, 4]
	compactarray·numel(a) -> n:int64
	prefix:int64 = 1
	suffix:int64 = 1
	
	[1, 1, 1, 1] -> result:[]int64
	i:int64 = 0
	while (i < n) {
		result[i] = prefix
		x:int64 = a[i]
		prefix × x -> prefix
		prefix × x -> prefix_m:int64
		i = i + 1
	}
	
	j:int64 = n - 1
	while (j >= 0) {
		result[j] -> rv:int64
		newv:int64 = suffix × rv
		newv_m:int64 = suffix × rv
		result[j] = newv
		y:int64 = a[j]
		suffix × y -> suffix
		suffix × y -> suffix_m:int64
		j = j - 1
	}
	k:int64 = 0
	while (k < n) {
		result[k] -> v:int64
		println(v)
		k = k + 1
	}
}

rwfunc test() -> () {

	product()
}
