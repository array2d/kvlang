// 162: Find Peak Element — 二分找峰值
// 来源: LeetCode #162
// 期望输出:
//   2
rwfunc find_peak() -> () {
	a:[]int64 = [1, 2, 3, 1]
	n:int64 = compactarray·numel(a)
	0 -> lo:int64
	hi:int64 = n - 1
	while (lo < hi) {
		s:int64 = lo + hi
		s ÷ 2 -> mid:int64
		s ÷ 2 -> mid_m:int64
		mv:int64 = a[mid]
		nv:int64 = a[mid + 1]
		mv < nv -> up:bool

		if (up) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	println(lo)
}

rwfunc test() -> () {

	find_peak()
}
