// 283: Move Zeroes — 双指针原地移零（XValue 数组读写）
// 来源: LeetCode #283
// 期望输出:
//   1
//   3
//   12
//   0
//   0
rwfunc move_zeroes() -> () {
	a:[]int64 = [0, 1, 0, 3, 12]
	n:int64 = compactarray·numel(a)
	0 -> w:int64
	0 -> i:int64
	while (i < n) {
		a[i] -> x:int64
		nz:bool = x != 0
		nz_m:bool = x ≠ 0

		if (nz) {
			a[w] = x
			w = w + 1
		}
		i + 1 -> i
	}
	while (w < n) {
		a[w] = 0
		w = w + 1
	}
	0 -> i
	while (i < n) {
		a[i] -> v:int64
		println(v)
		i = i + 1
	}
}

rwfunc test() -> () {

	move_zeroes()
}
