// 026: Remove Duplicates from Sorted Array
// 来源: LeetCode #26
// 期望输出:
//   k = 5
//   k = 5
rwfunc remove_dupes() -> (*int64 #k) {
    a:[]int64 = [0, 0, 1, 1, 1, 2, 2, 3, 3, 4]
    compactarray·numel(a) -> n:int64
    *k = 1
    i:int64 = 1
    while (i < n) {
        a[i] -> cur:int64
        pi:int64 = *k - 1
        prev:int64 = a[pi]
        cur == prev -> same:bool

        if (same) {
            i = i + 1
        } else {
            a[*k] = cur
            *k = *k + 1
            i + 1 -> i
        }
    }
}

rwfunc test() -> () {

	remove_dupes() -> k:int64
	println("k =", k)
	remove_dupes() -> k
	println("k =", k)
}
