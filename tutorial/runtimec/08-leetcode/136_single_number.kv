// 136: Single Number — 找出只出现一次的数
// 算法: XOR 异或（所有成对出现的数互相抵消）
// 来源: LeetCode #136
// 期望输出:
//   4
rwfunc single_number() -> () {
	a:[]int64 = [4, 1, 2, 1, 2]
	n:int64 = compactarray·numel(a)
	a[0] -> result:int64
	i:int64 = 1
	while (i < n) {
		x:int64 = a[i]
		result ^ x -> result
		i = i + 1
	}
	println(result)
}

rwfunc test() -> () {

	single_number()
}
