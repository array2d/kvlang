
rwfunc convert(*int64 #n) -> () {
	
	[0, 0, 0, 0, 0] -> a:[]int64
	idx:int64 = 0
	num:int64 = *n
	while (num > 0) {
		num - 1 -> n1:int64
		r:int64 = n1 % 26
		ch:int64 = 65 + r
		a[idx] = ch
		idx + 1 -> idx
		num = n1 ÷ 26
		num_m:int64 = n1 ÷ 26
	}
	k:int64 = idx - 1
	while (k >= 0) {
		a[k] -> v:int64
		println(v)
		k = k - 1
	}
}

rwfunc test() -> () {

	convert(28)
}
