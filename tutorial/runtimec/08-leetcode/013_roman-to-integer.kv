// 013 Roman to Integer
// 期望输出: 58, 1994
rwfunc romanToInt(*[]char/utf32 #s) -> (*int64 #val) {
	0 -> *val
	i:int64 = 0
	n:int64 = string·len(*s)
	"" -> prev:[]char/utf32
	while (i < n) {
		c:char/utf32 = (*s)[i]
		isI:bool = c == "I"
		c == "V" -> isV:bool
		isX:bool = c == "X"
		isL:bool = c == "L"
		c == "C" -> isC:bool
		isD:bool = c == "D"
		isM:bool = c == "M"
		pI:bool = prev == "I"
		prev == "X" -> pX:bool
		pC:bool = prev == "C"

		if (isI) {
			*val = *val + 1
		}

		if (isV) {
			*val + 5 -> *val
		}

		if (isX) {
			*val = *val + 10
		}

		if (isL) {
			*val = *val + 50
		}

		if (isC) {
			*val + 100 -> *val
		}

		if (isD) {
			*val = *val + 500
		}

		if (isM) {
			*val + 1000 -> *val
		}

		subI:bool = pI
		pX -> subX:bool
		subC:bool = pC

		if (isV) {
			if (subI) {
				*val = *val - 2
			}
		}

		if (isX) {
			if (subI) {
				*val - 2 -> *val
			}
		}

		if (isL) {
			if (subX) {
				*val = *val - 20
			}
		}

		if (isC) {
			if (subX) {
				*val = *val - 20
			}
		}

		if (isD) {
			if (subC) {
				*val - 200 -> *val
			}
		}

		if (isM) {
			if (subC) {
				*val = *val - 200
			}
		}

		prev = c
		i = i + 1
	}
}

rwfunc test() -> () {

	romanToInt("LVIII") -> a:int64
	println("LVIII =", a)
	b:int64 = romanToInt("MCMXCIV")
	println("MCMXCIV =", b)
	/roman_lviii = a
}
