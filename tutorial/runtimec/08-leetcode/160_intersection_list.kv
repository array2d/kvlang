
struct Node {
	val:int64=0
	next:*Node=None
}

rwfunc get_intersection(*Node #ha, *Node #hb) -> () {
	pa:*/lib/Node = ha
	pb:*/lib/Node = hb
	switch_a:int64 = 0
	switch_b:int64 = 0
	while (pa != pb) {
		(*pa)·next -> nxt:*/lib/Node
		if (nxt == None) {
			if (switch_a == 0) {
				pa = hb
				1 -> switch_a
			} else {
				pa = None
			}
		} else {
			pa = nxt
		}
		(*pb)·next -> nxt2:*/lib/Node
		if (nxt2 == None) {
			if (switch_b == 0) {
				pb = ha
				1 -> switch_b
			} else {
				pb = None
			}
		} else {
			pb = nxt2
		}
	}
	if (pa != None) {
		(*pa)·val -> v:int64
		println(v)
	}
}

rwfunc test() -> () {
	
	t5:Node = {val=5}
	t4:Node = {val=4 next=&t5}
	t8:Node = {val=8 next=&t4}

	a2:Node = {val=1 next=&t8}
	a1:Node = {val=4 next=&a2}
	&a1 -> ha:*/lib/Node

	b3:Node = {val=1 next=&t8}
	b2:Node = {val=6 next=&b3}
	b1:Node = {val=5 next=&b2}
	&b1 -> hb:*/lib/Node

	get_intersection(ha, hb)
}
