// 089: Gray Code — 生成 n 位格雷码序列
// 来源: LeetCode #89
// 公式: G(i) = i ^ (i >> 1)
// 期望输出:
//   0
//   0
//   1
//   1
//   3
//   3
//   2
//   2
//
// 期望值变更（2026-11-06）：原块每个格雷码只写了一次，实际每个值出现两遍。
// 逐行对照源码：内层 `while (i < total)` 每轮打 **两行** —— `println(g_m)` 与
// `println(g)`，两者值相同（`g` 与 `g_m` 都赋成 `i ^ (i ÷ 2)`）。`gray_code(2)` ⇒
// total=4 ⇒ 4 个值 × 2 行 = 8 行。实际输出 `0,0,1,1,3,3,2,2` 与之一一对应。
// 补齐是同形修正，不是让测试迎合实现。
rwfunc gray_code(*int64 #n) -> () {
	total:int64 = 1
	k:int64 = 0
	while (k < *n) {
		total = total × 2
		total_m:int64 = total × 2
		k + 1 -> k
	}
	i:int64 = 0
	while (i < total) {
		g:int64 = i ^ (i ÷ 2)
		g_m:int64 = i ^ (i ÷ 2)
		println(g_m)
		println(g)
		i + 1 -> i
	}
}

rwfunc test() -> () {
	gray_code(2)
}
