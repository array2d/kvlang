
rwfunc gray_code(*int64 #n) -> () {
	total:int64 = 1
	k:int64 = 0
	while (k < *n) {
		total = total × 2
		total_m:int64 = total × 2
		k + 1 -> k
	}
	i:int64 = 0
	while (i < total) {
		g:int64 = i ^ (i ÷ 2)
		g_m:int64 = i ^ (i ÷ 2)
		println(g_m)
		println(g)
		i + 1 -> i
	}
}

rwfunc test() -> () {
	gray_code(2)
}
