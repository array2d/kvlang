// classify: 成绩分档
// 算法: 嵌套 if，score=85 → grade=B
// 期望输出:
//   grade = B
rwfunc classify(*int64 #score) -> (*[]char/utf32 #grade) {
	if (*score >= 90) {
		*grade = "A"
	} else {
		if (*score >= 80) {
			"B" -> *grade
		} else {
			if (*score >= 70) {
				*grade = "C"
			} else {
				if (*score >= 60) {
					*grade = "D"
				} else {
					"F" -> *grade
				}
			}
		}
	}
}

rwfunc test() -> () {

	ans:[]char/utf32 = classify(85)
	println("grade =", ans)
	/last_grade = ans
}
