
rwfunc fahr_to_cels(*int64 #fahr) -> (*float64 #cels) {
	factor:float64 = 5.0 ÷ 9.0
	*fahr - 32 -> diff:int64
	factor × diff -> *cels
}

rwfunc test() -> () {
	data:'[int64]'int64 = {}
	data·0 = 0
	data·1 = 20
	40 -> data·2
	data·3 = 60
	data·4 = 80
	100 -> data·5
	data·6 = 120
	data·7 = 140
	160 -> data·8
	data·9 = 180
	data·10 = 200
	220 -> data·11
	data·12 = 240
	data·13 = 260
	280 -> data·14
	data·15 = 300
	for (fahr in data) {
		cels:float64 = fahr_to_cels(fahr)
		println(fahr, "F =", cels, "C")
	}
}
