# 多级包名调用：全路径 /lib/aaa/bbb/math.sum() 与短形式 aaa/bbb/math.sum() 等价
# 期望输出:
#   7
#   7
#   30
lib aaa/bbb/math {
    rwfunc sum(A:int64, B:int64) -> (C:int64) { A + B -> C }
    rwfunc double(A:int64) -> (C:int64) {
        sum(A, A) -> C  # 同包裸名调用
    }
}
rwfunc init() -> () {
    /lib/aaa/bbb/math.sum(3, 4) -> s
    println(s)

    aaa/bbb/math.sum(3, 4) -> t
    println(t)

    /lib/aaa/bbb/math.double(15) -> d
    println(d)
}
