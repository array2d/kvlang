# numpy 第三类：matmul（矩阵乘）
# extern: 需 numpy 扩展引擎驱动
#   python runtime-rwirext_example/py/numpy/numpy.py tutorial/14-numpy/03-linalg.kv
# 二维矩阵由一维 arange 经 reshape 得到——ndarray 就是 [dims]dtype，秩由算子产生。
# 期望输出:
#   a: [[0, 1, 2], [3, 4, 5]]
#   b: [[0, 1], [2, 3], [4, 5]]
#   matmul: [[10, 13], [28, 40]]
#   dot: 32.0
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> r
		numpy.reshape(r, [2, 3]) -> a
		numpy.print("a:", a)
		numpy.reshape(r, [3, 2]) -> b
		numpy.print("b:", b)
		numpy.matmul(a, b) -> c
		numpy.print("matmul:", c)
		u:[]float64 = [1.0, 2.0, 3.0]
		v:[]float64 = [4.0, 5.0, 6.0]
		numpy.dot(u, v) -> d
		numpy.print("dot:", d)
	}
}
demo.main()
