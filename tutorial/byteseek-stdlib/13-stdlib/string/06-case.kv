
rwfunc test() -> () {
	println("upper", string·upper("Hello"))
	println("lower", string·lower("Hello"))
	println("cap", string·capitalize("hELLO"))
	println("title", string·title("hello wORLD foo-bar"))
	println("swap", string·swapcase("Hello World"))
	println("eqfold", string·eqfold("AbC", "aBc"), string·eqfold("ab", "ac"))
}
