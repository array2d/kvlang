// time·elapsed_ns：从指定时刻到现在的纳秒数（确定 >= 0）
// 期望输出:
//   elapsed >= 0: true
// 自 t0 至今经过的纳秒数非负
rwfunc elapsed_nonneg(*int64 #t0) -> (*bool #ok) {
	time·now() - *t0 -> ns:int64
	ns >= 0 -> *ok
}

rwfunc test() -> () {
	time·now() -> t0:int64
	elapsed_nonneg(t0) -> ok:bool
	print("elapsed >= 0: ")
	println(ok)
}
