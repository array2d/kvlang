// 时间就是 int64 纳秒：until / max / min / elapsed 全部用 int64 算子
// 期望输出:
//   until > 0: true
//   max=t1: true
//   min=t0: true
//   elapsed_ms >= 0: true
//   elapsed_s >= 0: true
rwfunc test() -> () {
	time·now() -> t0:int64
	3600000000000 -> h1:int64
	t0 + h1 -> t1:int64
	t1 - time·now() -> rs:int64
	println("until > 0:", rs > 0)
	max(t0, t1) -> mx:int64
	min(t0, t1) -> mn:int64
	println("max=t1:", mx == t1)
	println("min=t0:", mn == t0)
	time·now() - t0 -> el1:int64
	el1 ÷ 1000000 -> ms:int64
	time·now() - t0 -> el2:int64
	el2 ÷ 1000000000 -> s:int64
	println("elapsed_ms >= 0:", ms >= 0)
	println("elapsed_s >= 0:", s >= 0)
}
