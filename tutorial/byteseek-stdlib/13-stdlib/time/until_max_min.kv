// time·until / max / min / elapsed_ms / elapsed_s
// 期望输出:
//   until > 0: true
//   max=t1: true
//   min=t0: true
//   elapsed_ms >= 0: true
//   elapsed_s >= 0: true
rwfunc test() -> () {
	time·now() -> t0:time
	time/duration·hours(1) -> h1:time/duration
	time·add(t0, h1) -> t1:time
	time·until(t1) -> rem:time/duration
	time/duration·as_seconds(rem) -> rs:int64
	println("until > 0:", rs > 0)
	time·max(t0, t1) -> mx:time
	time·min(t0, t1) -> mn:time
	println("max=t1:", time·equal(mx, t1))
	println("min=t0:", time·equal(mn, t0))
	time·elapsed_ms(t0) -> ms:int64
	time·elapsed_s(t0) -> s:int64
	println("elapsed_ms >= 0:", ms >= 0)
	println("elapsed_s >= 0:", s >= 0)
}
