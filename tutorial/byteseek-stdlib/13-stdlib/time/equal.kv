// 两时刻相等判断：时间就是 int64 纳秒，`==` 直接比
// 期望输出:
//   same: true
//   shifted: false
rwfunc test() -> () {
	time·now() -> t0:int64
	1000000000 -> one_sec:int64
	t0 + one_sec -> t1:int64
	t0 == t0 -> same:bool
	print("same: ")
	println(same)
	t0 == t1 -> shifted:bool
	print("shifted: ")
	println(shifted)
}
