// vthread·sleep(dur)：让当前 vthread 阻塞 dur 纳秒（int64），到点后续跑下一指令
//   单进程模型下即阻塞驱动线程；与 vthread·setstatus("wait") 的挂起-恢复不同
// 期望输出:
//   slept >= 10ms: true
// sleep_at_least 睡 ms 毫秒，并核对实际耗时是否达到请求值，返回 bool
rwfunc sleep_at_least(*int64 #ms) -> (*bool #ok) {
	*ms × 1000000 -> d:int64
	time·now() -> t0:int64
	vthread·sleep(d)
	time·now() - t0 -> ns:int64
	*ms × 1000000 -> want:int64
	ns >= want -> *ok
}

rwfunc test() -> () {
	sleep_at_least(10) -> ok:bool
	print("slept >= 10ms: ")
	println(ok)
}
