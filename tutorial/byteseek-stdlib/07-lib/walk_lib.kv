// 递归遍历一棵 lib 子树：列举成员名 + 叶子的 langtype（目录只列名），并下钻一层。
// 粒度按实测定：本 pod 上单次 kvspace 操作约 17ms（redis RTT 主导），所以整棵 /lib
// （含 84 章规范树）或 string 包全下钻（3k+ 叶子）都是分钟级。这里：
//   1) 列 string 包自身成员（38 个函数的签名键 / 源码 / 目录条目，192 条）；
//   2) Recurse into a single function directory (count/) to inspect instruction and label slots;
//      ‥labels/ is a system segment hidden from parent listings, so walk it explicitly.
// 成员经 `kvspace·members` 取：值与同名目录共存时后端会同时给出裸名与目录名（两个实体，
// 后端不去重），members 折成一条，遍历侧不必各自去重（见 lib kvspace 注释）。
// 目录判定不看 list 的尾斜杠（三后端不统一）：<名>/ 是结构目录，<名>· 是成员前缀目录。
// 两种拼写都试，先 / 后 ·。kvspace·listat 返回 utf8，须显式转 char/utf32 才能索引（utf32）。
// 期望输出:
//   /lib/string·
//   upper
//   upper.src
//   count/
//   [0,-1]
//   /lib/string·count/
//   [0,0] rwfunc
//   ‥labels/
//   _do_9
rwfunc walk(*[]char/utf32 $path, *[]char/utf32 $indent, *int64 $down) -> () {
	ms:'[int64]'[]char/utf32 = {}
	kvspace·members(*path) -> (ms, n:int64)
	0 -> i:int64
	while (i < n) {
		kvspace·listat(ms, i) -> mk:char/utf8
		ms·*mk -> nm8:[]char/utf32
		char/utf32(nm8) -> nm:[]char/utf32
		*path + nm -> full:[]char/utf32
		"" -> child:[]char/utf32
		string·find(nm, "/") -> sl:int64
		if (sl >= 0) {
			full -> child
		} else {
			full + "/" -> d1:[]char/utf32
			kvspace·listlen(d1) -> c1:int64
			if (c1 > 0) {
				d1 -> child
			} else {
				full + "·" -> d2:[]char/utf32
				kvspace·listlen(d2) -> c2:int64
				if (c2 > 0) {
					d2 -> child
				}
			}
		}
		if (child == "") {
			// `full` is a runtime string (`full -> v` copies the string, not the target key);
			// copy the leaf to a fixed scratch key and read it via an unquoted path.
			kvspace·del("/tmp/walk_lib_leaf") -> _
			kvspace·cp(full, "/tmp/walk_lib_leaf")
			/tmp/walk_lib_leaf -> v
			if (v == None) {
				println(*indent, nm)
			} else {
				compactarray·langtype(v) -> lt:[]char/utf8
				char/utf32(lt) -> lts:[]char/utf32
				println(*indent, nm, lts)
			}
		} else {
			println(*indent, nm)
			if (*down > 0) {
				walk(child, *indent + "  ", *down - 1)
			}
		}
		i + 1 -> i
	}
}
rwfunc test() -> () {
	println("/lib/string·")
	walk("/lib/string·", "  ", 0)
	println("/lib/string·count/")
	walk("/lib/string·count/", "  ", 1)
	// System segments (prefixed with ‥) are omitted from parent listings; walk explicitly.
	println("/lib/string·count/‥labels/")
	walk("/lib/string·count/‥labels/", "  ", 0)
}
