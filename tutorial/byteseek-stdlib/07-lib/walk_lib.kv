
rwfunc walk(*[]char/utf32 #path, *[]char/utf32 #indent, *int64 #down) -> () {
	ms:'[int64]'[]char/utf32 = {}
	kvspace·members(*path) -> (ms, n:int64)
	0 -> i:int64
	while (i < n) {
		kvspace·listat(ms, i) -> mk:char/utf8
		ms·*mk -> nm8:[]char/utf32
		char/utf32(nm8) -> nm:[]char/utf32
		*path + nm -> full:[]char/utf32
		"" -> child:[]char/utf32
		string·find(nm, "/") -> sl:int64
		if (sl >= 0) {
			full -> child
		} else {
			full + "/" -> d1:[]char/utf32
			kvspace·listlen(d1) -> c1:int64
			if (c1 > 0) {
				d1 -> child
			} else {
				full + "·" -> d2:[]char/utf32
				kvspace·listlen(d2) -> c2:int64
				if (c2 > 0) {
					d2 -> child
				}
			}
		}
		if (child == "") {
			
			kvspace·del("/tmp/walk_lib_leaf") -> _
			kvspace·cp(full, "/tmp/walk_lib_leaf")
			/tmp/walk_lib_leaf -> v
			if (v == None) {
				println(*indent, nm)
			} else {
				compactarray·langtype(v) -> lt:[]char/utf8
				char/utf32(lt) -> lts:[]char/utf32
				println(*indent, nm, lts)
			}
		} else {
			println(*indent, nm)
			if (*down > 0) {
				walk(child, *indent + "  ", *down - 1)
			}
		}
		i + 1 -> i
	}
}
rwfunc test() -> () {
	println("/lib/string·")
	walk("/lib/string·", "  ", 0)
	println("/lib/string·count/")
	walk("/lib/string·count/", "  ", 1)
	
	println("/lib/string·count/‥labels/")
	walk("/lib/string·count/‥labels/", "  ", 0)
}
