// word_count: 单词计数状态机（K&R C §1.5.4）
// 算法: 遍历 + IN/OUT 状态机
// 期望输出:
//   word count = 3
// 散 key 数组作实参时 for-in 在 layout 脱糖成 compact 取值（xv·at），
// 函数内改用 kv·listlen/kv·listn/kv·get 显式遍历。
rwfunc word_count(chars:*[int64]·[]char/utf32) -> (nw:int64) {
	nw = 0
	0 -> state
	kv·listlen(chars) -> n
	0 -> i
	while (i < n) {
		kv·listn(chars, i) -> k
		kv·get(chars, k) -> c
		blank = c == " "

		if (blank) {
			state = 0
		} else {
			state == 0 -> was_out

			if (was_out) {
				state = 1
				nw = nw + 1
			}
		}
		i = i + 1
	}
}

rwfunc test() -> () {
	chars:[int64]·[]char/utf32 = {}
	chars·0 = "h"
	"e" -> chars·1
	chars·2 = "l"
	chars·3 = "l"
	"o" -> chars·4
	chars·5 = " "
	chars·6 = "w"
	"o" -> chars·7
	chars·8 = "r"
	chars·9 = "l"
	"d" -> chars·10
	chars·11 = " "
	chars·12 = "k"
	"v" -> chars·13
	chars·14 = "l"
	chars·15 = "a"
	"n" -> chars·16
	chars·17 = "g"
	word_count(chars) -> nw
	println("word count =", nw)
	nw -> /last_wc
}
