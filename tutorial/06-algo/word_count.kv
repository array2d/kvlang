// word_count: 单词计数状态机（K&R C §1.5.4）
// 算法: for 遍历 + IN/OUT 状态机
// 期望输出:
//   word count = 3
rwfunc test() -> () {
	chars·0 = "h"
	"e" -> chars·1
	chars·2 = "l"
	chars·3 = "l"
	"o" -> chars·4
	chars·5 = " "
	chars·6 = "w"
	"o" -> chars·7
	chars·8 = "r"
	chars·9 = "l"
	"d" -> chars·10
	chars·11 = " "
	chars·12 = "k"
	"v" -> chars·13
	chars·14 = "l"
	chars·15 = "a"
	"n" -> chars·16
	chars·17 = "g"
	nw = 0
	0 -> state
	for (c in chars) {
		blank = c == " "

		if (blank) {
			state = 0
		} else {
			state == 0 -> was_out

			if (was_out) {
				state = 1
				nw = nw + 1
			}
		}
	}
	println("word count =", nw)
	nw -> /last_wc
}
