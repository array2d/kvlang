// prime_sieve: 试除法求质数（Rust The Book §3.5）
// 算法: 嵌套 while，找出 <=200 的质数
// 期望输出:
//   prime: 2
//   prime: 199
//   total primes up to 200 = 46
rwfunc prime_sieve(limit:int64) -> () {
	println("primes up to", limit)
	count = 0  // = 等价于 <-
	2 -> n
	while (n <= limit) {
		is_prime <- true
		d = 2  // = 等价于 <-
		while (d < n) {
			n % d -> rem
			divisible <- rem == 0

			if (divisible) {
				is_prime = false  // = 等价于 <-
				break
			} else {
				d <- d + 1
			}
		}

		if (is_prime) {
			println("  prime:", n)
			count = count + 1  // = 等价于 <-
		}

		n + 1 -> n
	}
	println("total primes up to", limit, "=", count)
}

rwfunc test() -> () {

	t0 <- time·now()
	prime_sieve(200)
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
}
