// map_reduce: filter + map + reduce（MDN JS Array）
// 算法: for 遍历器筛选奇数 + 累加平方
// 期望输出:
//   odd squares count: 5
//   sum of squares: 165
rwfunc test() -> () {
	nums·0 = 1
	3 -> nums·1
	nums·2 = 5
	nums·3 = 7
	9 -> nums·4
	nums·5 = 2
	nums·6 = 4
	6 -> nums·7
	nums·8 = 8
	nums·9 = 10
	0 -> count
	total = 0
	for (n in nums) {
		rem = n % 2
		rem == 1 -> is_odd

		if (is_odd) {
			println("  keep:", n)
			sq = n × n
			sq_m = n × n
			total = total + sq
			count + 1 -> count
		} else {
			println("  skip:", n)
		}
	}
	println("odd squares count:", count)
	println("sum of squares:", total)
	/last_sum = total
}
