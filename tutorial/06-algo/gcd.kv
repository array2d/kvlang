// gcd: 欧几里得最大公约数（尾递归）
// 算法: gcd(48, 18) = 6
// 期望输出:
//   gcd = 6
rwfunc gcd(A:int64, B:int64) -> (R:int64) {
	if (B == 0) {
		A -> R
	} else {
		rem <- A % B
		R = gcd(B, rem)  // = 等价于 <-
	}
}

rwfunc test() -> () {

	t0 <- time·now()
	gcd(48, 18) -> ans
	t1 <- time·now()
	println("gcd =", ans)
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
}
