// 特化对照 fixture：
//   flex —— 形参无类型声明（x:），layout 只能发泛型 `+`；binircompiler 按实参类型特化。
//   fixa / fixc —— 同一表达式写成已声明类型，layout 直接发 int64·add / float64·add；
//                  用来与 flex 的特化结果对拍（两份类型推断必须一致）。
//   注：`float64 + int 字面量` 的混合提升，layout 目前发 float32·add（宽度单位
//   用了位而不是字节，layout/src/lower.rs promoted_numeric_kind），运行时按值
//   宽度执行结果仍正确；所以 float 侧对拍用纯 float 表达式，不把该标注当 oracle。
rwfunc flex(x:) -> (y:) {
	y = x + 1
}

rwfunc fixa(x:int64) -> (y:int64) {
	y = x + 1
}

rwfunc fixc(x:float64) -> (y:float64) {
	y = x + 0.5
}
