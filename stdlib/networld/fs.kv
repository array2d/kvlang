// 欢迎加入kvspace世界
// lib networld/fs —— 宿主文件系统的文本级工具（rwfunc，kv 源码）。
// native rwir（字节级，runtime-rs）：size / read(p,start,off) / write(p,bytes)
//   / append / rename / list / del / mkdir / exists / isutf8。本库在其上补文本级与路径级组合：
//   readtext / writetext / appendtext  文件 ↔ []char/utf32 文本（UTF-8 解码 / 编码往返与追加）
//   copyfile                          字节级整文件拷贝
//   basename / dirname / ext / joinpath  路径分段与拼接
//   match                             名字段 shell 通配（* 任意串、? 单字符）
//   glob                              按通配展开路径
//   scan / grep                       逐行查找（文件或目录下匹配 glob 的成员）
// 文本约定：文件按 UTF-8 解码为 []char/utf32 后操作（只有定宽的 char/utf32 可
// 索引 / 切片）；落盘再编码回 UTF-8。字节级 I/O 仍走 native rwir。

lib networld/fs {
	// readtext(p) -> (t, sz)：整文件读为文本；sz = 字节数（缺失 = -1，t = ""）
	rwfunc readtext(p:[]char/utf32) -> (t:[]char/utf32, sz:int64) {
		networld/fs·size(p) -> sz
		"" -> t
		if (sz > 0) {
			networld/fs·isutf8(p) -> valid
			if (valid) {
				networld/fs·read(p, 0, sz) -> raw
				compactarray·newreinterpret(raw, "[]char/utf8") -> u8
				char/utf32(u8) -> t
			}
		}
	}
	// writetext(p, t) -> n：文本按 UTF-8 覆盖写盘，返回字节数（失败 -1）
	rwfunc writetext(p:[]char/utf32, t:[]char/utf32) -> (n:int64) {
		char/utf8(t) -> u8
		compactarray·newreinterpret(u8, "[]uint8") -> bytes
		networld/fs·write(p, bytes) -> n
	}
	// appendtext(p, t) -> n：文本按 UTF-8 追加到文件末尾，返回追加字节数（失败 -1）
	rwfunc appendtext(p:[]char/utf32, t:[]char/utf32) -> (n:int64) {
		char/utf8(t) -> u8
		compactarray·newreinterpret(u8, "[]uint8") -> bytes
		networld/fs·append(p, bytes) -> n
	}
	// copyfile(src, dst) -> n：字节级整文件拷贝，返回写入字节数（源不存在/失败 -1）
	rwfunc copyfile(src:[]char/utf32, dst:[]char/utf32) -> (n:int64) {
		networld/fs·size(src) -> sz
		if (sz < 0) {
			-1 -> n
		} else {
			networld/fs·read(src, 0, sz) -> raw
			networld/fs·write(dst, raw) -> n
		}
	}
	// basename(p) -> name：路径末段（剥除末尾连续 '/'；无 '/' 原样；全 '/' 返 "/"）
	rwfunc basename(p:[]char/utf32) -> (name:[]char/utf32) {
		hi = string·len(p)
		if (hi == 0) {
			"" -> name
		} else {
			while (hi > 1) {
				string·char(p, hi - 1) -> c
				if (string·cmp(c, "/") != 0) {
					break
				}
				hi = hi - 1
			}
			string·slice(p, 0, hi) -> trimmed
			string·rfind(trimmed, "/") -> idx
			if (idx < 0) {
				trimmed -> name
			} else {
				if (idx == 0 && hi == 1) {
					"/" -> name
				} else {
					string·slice(trimmed, idx + 1, hi) -> name
				}
			}
		}
	}
	// dirname(p) -> dir：路径父目录（剥除末尾连续 '/' 后取最后一个 '/' 之前；无 '/' 返 "."；根返 "/"）
	rwfunc dirname(p:[]char/utf32) -> (dir:[]char/utf32) {
		hi = string·len(p)
		if (hi == 0) {
			"." -> dir
		} else {
			while (hi > 1) {
				string·char(p, hi - 1) -> c
				if (string·cmp(c, "/") != 0) {
					break
				}
				hi = hi - 1
			}
			string·slice(p, 0, hi) -> trimmed
			string·rfind(trimmed, "/") -> idx
			if (idx < 0) {
				"." -> dir
			} else {
				if (idx == 0) {
					"/" -> dir
				} else {
					string·slice(trimmed, 0, idx) -> dir
				}
			}
		}
	}
	// ext(p) -> e：文件扩展名（含前导 '.'，如 ".kv"；无 '.' 或末段以单 '.' 开头无后续 '.' 返 ""）
	rwfunc ext(p:[]char/utf32) -> (e:[]char/utf32) {
		networld/fs·basename(p) -> base
		bl = string·len(base)
		string·rfind(base, ".") -> idx
		if (idx <= 0) {
			"" -> e
		} else {
			string·slice(base, idx, bl) -> e
		}
	}
	// joinpath(a, b) -> p：拼接两段路径（自动处理连接处单 '/'；一方为空则返另一方）
	rwfunc joinpath(a:[]char/utf32, b:[]char/utf32) -> (p:[]char/utf32) {
		if (string·empty(a)) {
			b -> p
		} else {
			if (string·empty(b)) {
				a -> p
			} else {
				string·trimsuffix(a, "/") -> a2
				string·trimprefix(b, "/") -> b2
				if (string·empty(a2)) {
					"/" + b2 -> p
				} else {
					a2 + "/" + b2 -> p
				}
			}
		}
	}
	// match(name, pat) -> b：名字段通配匹配（* 任意串、? 单字符，其余按字面）
	rwfunc match(name:[]char/utf32, pat:[]char/utf32) -> (b:bool) {
		nn = string·len(name)
		pn = string·len(pat)
		if (pn == 0) {
			b = nn == 0
		} else {
			string·slice(pat, 1, pn) -> ptail
			if (string·startswith(pat, "*")) {
				networld/fs·match(name, ptail) -> b
				if (!b && nn > 0) {
					string·slice(name, 1, nn) -> ntail
					networld/fs·match(ntail, pat) -> b
				}
			} else {
				if (nn == 0) {
					b = false
				} else {
					string·slice(name, 1, nn) -> ntail
					if (string·startswith(pat, "?")) {
						networld/fs·match(ntail, ptail) -> b
					} else {
						string·slice(name, 0, 1) -> nc
						string·slice(pat, 0, 1) -> pc
						if (string·cmp(nc, pc) == 0) {
							networld/fs·match(ntail, ptail) -> b
						} else {
							b = false
						}
					}
				}
			}
		}
	}
	// glob(pat) -> paths：按通配展开路径（\n 连接；无匹配 = 空串）。
	// 仅最后一段可含 *?，其前目录须为字面路径，如 "/tmp/*.kv"、"src/*.c"。
	rwfunc glob(pat:[]char/utf32) -> (paths:[]char/utf32) {
		"" -> paths
		ln = string·len(pat)
		cut = -1
		i = 0
		while (i < ln) {
			string·slice(pat, i, i + 1) -> c
			if (string·cmp(c, "/") == 0) {
				cut = i
			}
			i = i + 1
		}
		if (cut < 0) {
			"." -> dir
			pat -> np
		} else {
			string·slice(pat, 0, cut) -> dir
			string·slice(pat, cut + 1, ln) -> np
		}
		dir -> scan
		if (string·len(dir) == 0) {
			"/" -> scan
		}
		networld/fs·list(scan) -> ns
		kvspace·listlen(ns) -> nc
		i = 0
		while (i < nc) {
			kvspace·listat(ns, i) -> k
			ns·*k -> nm
			networld/fs·match(nm, np) -> ok
			if (ok) {
				string·concat(dir, "/") -> d
				string·concat(d, nm) -> cp
				string·concat(paths, cp) -> paths
				string·concat(paths, "\n") -> paths
			}
			i = i + 1
		}
	}
	// scan(text, path, pat) -> hits：逐行找含 pat 的行，输出 "path:行号:文本"\n
	rwfunc scan(text:[]char/utf32, path:[]char/utf32,
	            pat:[]char/utf32) -> (hits:[]char/utf32) {
		"" -> hits
		ln = string·len(text)
		pos = 0
		no = 0
		while (pos < ln) {
			string·slice(text, pos, ln) -> rest
			string·find(rest, "\n") -> e
			no = no + 1
			if (e == -1) {
				string·slice(text, pos, ln) -> line
				pos = ln
			} else {
				string·slice(text, pos, pos + e) -> line
				pos = pos + e + 1
			}
			string·find(line, pat) -> h
			if (h != -1) {
				string·concat(hits, path) -> hits
				string·concat(hits, ":") -> hits
				string·formatint(no, 10) -> sn
				string·concat(hits, sn) -> hits
				string·concat(hits, ":") -> hits
				string·concat(hits, line) -> hits
				string·concat(hits, "\n") -> hits
			}
		}
	}
	// grep(pat, path, glob) -> hits：path 是文件则扫它本身；是目录则扫其下匹配
	// glob 的成员（glob 空 = 全部成员）。命中输出 "路径:行号:文本"，多行 \n 连接。
	rwfunc grep(pat:[]char/utf32, path:[]char/utf32,
	            glob:[]char/utf32) -> (hits:[]char/utf32) {
		"" -> hits
		networld/fs·list(path) -> ns
		kvspace·listlen(ns) -> nc
		if (nc == 0) {
			networld/fs·readtext(path) -> (t, sz)
			if (sz > 0) {
				networld/fs·scan(t, path, pat) -> h
				string·concat(hits, h) -> hits
			}
		} else {
			gl = string·len(glob)
			i = 0
			while (i < nc) {
				kvspace·listat(ns, i) -> k
				ns·*k -> nm
				networld/fs·match(nm, glob) -> ok
				if (gl == 0 || ok) {
					string·concat(path, "/") -> d
					string·concat(d, nm) -> cp
					networld/fs·readtext(cp) -> (t, sz)
					if (sz > 0) {
						networld/fs·scan(t, cp, pat) -> h
						string·concat(hits, h) -> hits
					}
				}
				i = i + 1
			}
		}
	}
}
