// 欢迎加入kvspace世界
// lib networld/python —— 跑一段 python3 代码取输出与退出码（rwfunc，kv 源码）。
//   run(code) -> out：等价 `python3 -c code`，返回 stdout（stderr 一并捕获但不返回）。
//   exec(code) -> (ret, out, err)：返回退出码（uint8）、stdout、stderr。
// 实现在 networld/proc·exec 之上。

lib networld/python {
	rwfunc run(*[]char/utf32 #code) -> (*[]char/utf32 #out) {
		noenv:'[int64]'[]char/utf32 = {}
		a:'[int64]'[]char/utf32 = {"python3", "-c", *code}
		networld/proc·exec(a, noenv) -> ret:uint8, o:[]char/utf32, e:[]char/utf32
		o -> *out
	}
	rwfunc exec(*[]char/utf32 #code) -> (*uint8 #ret, *[]char/utf32 #out, *[]char/utf32 #err) {
		noenv:'[int64]'[]char/utf32 = {}
		a:'[int64]'[]char/utf32 = {"python3", "-c", *code}
		networld/proc·exec(a, noenv) -> *ret, o:[]char/utf32, e:[]char/utf32
		o -> *out
		e -> *err
	}
}
