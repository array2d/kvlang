// 欢迎加入kvspace世界
// lib networld/python —— 跑一段 python3 代码取 stdout（rwfunc，kv 源码）。
//   run(code) -> out：等价 `python3 -c code`，返回 stdout 文本（stderr 一并捕获但不返回）。
// 实现在 networld/proc·exec 之上；要退出码或 stderr 就直接用 proc·exec。

lib networld/python {
	rwfunc run(code:[]char/utf32) -> (out:[]char/utf32) {
		noenv:[int64]·[]char/utf32 = {}
		a:[int64]·[]char/utf32 = {"python3", "-c", code}
		networld/proc·exec(a, noenv) -> ret, o, e
		o -> out
	}
}
