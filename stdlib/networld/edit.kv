
lib networld/edit {
	
	rwfunc read(*[]char/utf32 #p, *int64 #from, *int64 #lines) -> (
	          *[]char/utf32 #view, *int64 #total, *int64 #sz) {
		networld/fs·readtext(*p) -> (t:[]char/utf32, *sz)
		"" -> *view
		*total = 0
		if (*sz >= 0) {
			networld/fs·isutf8(*p) -> u8ok:bool
			if (u8ok == false) {
				*total = -2
			} else {
			if (*sz > 8388608) {
				*total = -1
			} else {
				parts:'[int64]'[]char/utf32 = {}
				string·lines(t) -> (parts, *total)
				lo:int64 = *from
				if (lo < 1) { lo = 1 }
				hi:int64 = *total
				if (*lines > 0 && lo + *lines - 1 < *total) { hi = lo + *lines - 1 }
				i:int64 = lo
				while (i <= hi) {
					pathspace·listat(parts, i - 1) -> kk:char/utf8
					parts·*kk -> ln:[]char/utf32
					string·formatint(i, 10) -> no:char/utf32
					string·concat(*view, no) -> *view
					string·concat(*view, ": ") -> *view
					string·concat(*view, ln) -> *view
					string·concat(*view, "\n") -> *view
					i + 1 -> i
				}
			}
			}
		}
	}

	rwfunc commit(*[]char/utf32 #p, *[]char/utf32 #t) -> (*int64 #code) {
		*code = 4
		string·concat(*p, ".tmp") -> tp:[]char/utf32
		networld/fs·writetext(tp, *t) -> wn:int64
		if (wn >= 0) {
			networld/fs·rename(tp, *p) -> rc:int64
			if (rc == 0) {
				networld/fs·readtext(*p) -> (back:[]char/utf32, _)
				if (string·cmp(back, *t) == 0) { *code = 0 } else { *code = 5 }
			}
		}
	}

	rwfunc write(*[]char/utf32 #p, *[]char/utf32 #t) -> (*int64 #n, *int64 #code) {
		*n = 0
		networld/edit·commit(*p, *t) -> *code
		if (*code == 0) { string·len(*t) -> *n }
	}

	rwfunc replace(*[]char/utf32 #p, *[]char/utf32 #old, *[]char/utf32 #new,
	               *int64 #dry) -> (*int64 #done, *int64 #hit, *int64 #code) {
		*done = 0
		*hit = 0
		networld/fs·isutf8(*p) -> u8ok:bool
		if (u8ok == false) {
			*code = 7
		} else {
		networld/fs·readtext(*p) -> (t:[]char/utf32, sz:int64)
		if (sz < 0) {
			*code = 3
		} else {
			string·count(t, *old) -> *hit
			if (*hit == 0) {
				*code = 1
			} else {
				if (*hit > 1) {
					*code = 2
				} else {
					string·replace(t, *old, *new) -> (t2:[]char/utf32, _)
					if (*dry == 1) {
						*done = 1
						*code = 0
					} else {
						networld/edit·commit(*p, t2) -> *code
						if (*code == 0) { *done = 1 }
					}
				}
			}
		}
		}
	}

	rwfunc multi(*[]char/utf32 #p, *'[int64]'[]char/utf32 #olds,
	             *'[int64]'[]char/utf32 #news, *int64 #dry) -> (
	             *int64 #done, *int64 #bad, *int64 #code) {
		pathspace·listlen(*olds) -> cnt:int64
		pathspace·listlen(*news) -> m:int64
		*done = 0
		*bad = -1
		networld/fs·isutf8(*p) -> u8ok:bool
		if (u8ok == false) {
			*code = 7
		} else {
		if (cnt != m) {
			*code = 6
		} else {
			networld/fs·readtext(*p) -> (t:[]char/utf32, sz:int64)
			if (sz < 0) {
				*code = 3
			} else {
				*code = 0
				i:int64 = 0
				while (i < cnt) {
					pathspace·listat(*olds, i) -> ko:char/utf8
					pathspace·listat(*news, i) -> kn:char/utf8
					(*olds)·*ko -> o:[]char/utf32
					(*news)·*kn -> w:[]char/utf32
					string·count(t, o) -> c:int64
					if (c == 0) {
						*bad = i
						*code = 1
						break
					}
					if (c > 1) {
						*bad = i
						*code = 2
						break
					}
					string·replace(t, o, w) -> (t2:[]char/utf32, _)
					t = t2
					*done = *done + 1
					i = i + 1
				}
				if (*bad < 0 && *dry != 1) {
					networld/edit·commit(*p, t) -> *code
				}
			}
		}
		}
	}
}
