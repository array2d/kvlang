
lib pathspace {
	
	rwfunc members(*[]char/utf32 #path) -> (
	               *'[int64]'[]char/utf32 #names, *int64 #n) {
		pathspace·listlen(*path) -> total:int64
		*n = 0
		i:int64 = 0
		while (i < total) {
			pathspace·listat(*path, i) -> m8:char/utf8
			char/utf32(m8) -> m:[]char/utf32
			skip:bool = false
			string·len(m) -> ml:int64
			if (ml > 0) {
				string·char(m, ml - 1) -> tail:char/utf32
				if (tail != "/" && tail != "·") {
					
					j:int64 = i + 1
					while (j < total) {
						pathspace·listat(*path, j) -> n8:char/utf8
						char/utf32(n8) -> nx:[]char/utf32
						string·len(nx) -> xl:int64
						if (xl < ml) {
							break
						}
						string·slice(nx, 0, ml) -> head:char/utf32
						if (string·cmp(head, m) != 0) {
							break
						}
						m + "/" -> t1:[]char/utf32
						m + "·" -> t2:[]char/utf32
						if (string·cmp(nx, t1) == 0) {
							skip = true
							break
						}
						if (string·cmp(nx, t2) == 0) {
							skip = true
							break
						}
						j = j + 1
					}
				}
			}
			if (!skip) {
				scatterarray·append(*names, m) -> *names
				*n = *n + 1
			}
			i = i + 1
		}
	}
	
	rwfunc count(*[]char/utf32 #path) -> (*int64 #n) {
		ms:'[int64]'[]char/utf32 = {}
		pathspace·members(*path) -> (ms, *n)
	}
}
