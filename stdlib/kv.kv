// 欢迎加入kvspace世界
// lib kvspace —— KV 空间便利库。native rwir：kvspace·get/set/del/deltree/list/listlen；
// rwfunc 补充：has（存在检测）、get_or（缺省回退）、set_default（幂等写）。
// /___kv_stdlib_null___ 为内部 sentinel 路径，用户不得写入。

lib kvspace {
	rwfunc has(path:[]char/utf32) -> (result:bool) {
		v = kvspace·get(path)
		sentinel = kvspace·get("/___kv_stdlib_null___")
		result = !(v == sentinel)
	}
	rwfunc get_or(path:[]char/utf32, default_val:[]char/utf32) -> (result:[]char/utf32) {
		v = kvspace·get(path)
		sentinel = kvspace·get("/___kv_stdlib_null___")
		if (v == sentinel) {
			result = default_val
		} else {
			result = v
		}
	}
	rwfunc set_default(path:[]char/utf32, val:[]char/utf32) -> () {
		existing = kvspace·get(path)
		sentinel = kvspace·get("/___kv_stdlib_null___")
		if (existing == sentinel) {
			kvspace·set(path, val)
		}
	}
	// members(path) -> (names, n)：列目录成员，并**折叠同名孪生条目**。
	// 值与同名目录可以共存（见 kvspace/tutorial-durable/10-dir-file-coexist.sh），此时
	// 列举会同时给出裸名 X 与目录名 X/（或 X·）——它们是两个实体，**后端不去重**（fs 发两
	// 条、redis 视场景而定，无统一规则）。需要「这层有哪些名字」的自省/遍历类调用方一律用
	// 本函数：裸名后面紧跟同名 X/（或 X·）时只保留带目录标记的那条，名字取 `X/`。
	// 调用方先声明空容器：`m:[int64]·[]char/utf32 = {}` + `kvspace·members(p) -> (m, n)`。
	rwfunc members(path:[]char/utf32) -> (
	               names:*[int64]·[]char/utf32, n:int64) {
		kvspace·listlen(path) -> total
		n = 0
		i = 0
		while (i < total) {
			kvspace·listn(path, i) -> m8
			char/utf32(m8) -> m
			skip = false
			string·len(m) -> ml
			if (ml > 0) {
				string·char(m, ml - 1) -> tail
				if (tail != "/" && tail != "·") {
					// 名字带 `.[…]`/`.src` 的兄弟把裸名与 `<名>/` 隔开
					// （列举按 cmp_coord 排序：fields, fields.[0,-1], …, fields/），
					// 所以要向后扫完**同前缀**的条目，不能只看下一条。
					j = i + 1
					while (j < total) {
						kvspace·listn(path, j) -> n8
						char/utf32(n8) -> nx
						string·len(nx) -> xl
						if (xl < ml) {
							break
						}
						string·slice(nx, 0, ml) -> head
						if (string·cmp(head, m) != 0) {
							break
						}
						m + "/" -> t1
						m + "·" -> t2
						if (string·cmp(nx, t1) == 0) {
							skip = true
							break
						}
						if (string·cmp(nx, t2) == 0) {
							skip = true
							break
						}
						j = j + 1
					}
				}
			}
			if (!skip) {
				array·append(names, m) -> names
				n = n + 1
			}
			i = i + 1
		}
	}
}
