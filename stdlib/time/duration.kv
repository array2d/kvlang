// 欢迎加入kvspace世界
// lib time/duration —— 时长标准库便利函数。native rwir: nanos/millis/seconds/minutes/hours/
// as_nanos/as_millis/as_seconds/as_minutes/as_hours/add/sub/before/after；
// days/as_days/is_zero/is_neg/is_pos/abs/equal/max/min/clamp 是 rwfunc 封装（kv 源码，可寻址/可自改）。

lib time/duration {
	rwfunc days(*int64 #n) -> (*time/duration #dur) {
		*n × 24 -> h:int64
		time/duration·hours(h) -> *dur
	}
	rwfunc as_days(*time/duration #d) -> (*int64 #n) {
		time/duration·as_hours(*d) -> h:int64
		h ÷ 24 -> *n
	}
	rwfunc is_zero(*time/duration #d) -> (*bool #r) {
		time/duration·as_nanos(*d) -> ns:int64
		ns == 0 -> *r
	}
	rwfunc is_neg(*time/duration #d) -> (*bool #r) {
		time/duration·as_nanos(*d) -> ns:int64
		ns < 0 -> *r
	}
	rwfunc is_pos(*time/duration #d) -> (*bool #r) {
		time/duration·as_nanos(*d) -> ns:int64
		ns > 0 -> *r
	}
	rwfunc abs(*time/duration #d) -> (*time/duration #r) {
		time/duration·as_nanos(*d) -> ns:int64
		if (ns < 0) {
			0 - ns -> pos:int64
			time/duration·nanos(pos) -> *r
		} else {
			*d -> *r
		}
	}
	rwfunc equal(*time/duration #d1, *time/duration #d2) -> (*bool #r) {
		time/duration·before(*d1, *d2) -> b:bool
		time/duration·after(*d1, *d2) -> a:bool
		!b && !a -> *r
	}
	rwfunc max(*time/duration #d1, *time/duration #d2) -> (*time/duration #r) {
		time/duration·after(*d1, *d2) -> a:bool
		if (a) {
			*d1 -> *r
		} else {
			*d2 -> *r
		}
	}
	rwfunc min(*time/duration #d1, *time/duration #d2) -> (*time/duration #r) {
		time/duration·before(*d1, *d2) -> b:bool
		if (b) {
			*d1 -> *r
		} else {
			*d2 -> *r
		}
	}
	rwfunc clamp(*time/duration #d, *time/duration #lo,
		*time/duration #hi) -> (*time/duration #r) {
		time/duration·max(*d, *lo) -> t:time/duration
		time/duration·min(t, *hi) -> *r
	}
}
