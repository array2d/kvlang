// 欢迎加入kvspace世界
// lib time/duration —— 时长标准库便利函数。native rwir: nanos/millis/seconds/minutes/hours/
// as_nanos/as_millis/as_seconds/as_minutes/as_hours/add/sub/before/after；
// days/as_days/is_zero/is_neg/is_pos/abs/equal/max/min/clamp 是 rwfunc 封装（kv 源码，可寻址/可自改）。

lib time/duration {
	rwfunc days(n:int64) -> (dur:time/duration) {
		n × 24 -> h
		time/duration·hours(h) -> dur
	}
	rwfunc as_days(d:time/duration) -> (n:int64) {
		time/duration·as_hours(d) -> h
		h ÷ 24 -> n
	}
	rwfunc is_zero(d:time/duration) -> (r:bool) {
		time/duration·as_nanos(d) -> ns
		ns == 0 -> r
	}
	rwfunc is_neg(d:time/duration) -> (r:bool) {
		time/duration·as_nanos(d) -> ns
		ns < 0 -> r
	}
	rwfunc is_pos(d:time/duration) -> (r:bool) {
		time/duration·as_nanos(d) -> ns
		ns > 0 -> r
	}
	rwfunc abs(d:time/duration) -> (r:time/duration) {
		time/duration·as_nanos(d) -> ns
		if (ns < 0) {
			0 - ns -> pos
			time/duration·nanos(pos) -> r
		} else {
			d -> r
		}
	}
	rwfunc equal(d1:time/duration, d2:time/duration) -> (r:bool) {
		time/duration·before(d1, d2) -> b
		time/duration·after(d1, d2) -> a
		!b && !a -> r
	}
	rwfunc max(d1:time/duration, d2:time/duration) -> (r:time/duration) {
		time/duration·after(d1, d2) -> a
		if (a) {
			d1 -> r
		} else {
			d2 -> r
		}
	}
	rwfunc min(d1:time/duration, d2:time/duration) -> (r:time/duration) {
		time/duration·before(d1, d2) -> b
		if (b) {
			d1 -> r
		} else {
			d2 -> r
		}
	}
	rwfunc clamp(d:time/duration, lo:time/duration,
		hi:time/duration) -> (r:time/duration) {
		time/duration·max(d, lo) -> t
		time/duration·min(t, hi) -> r
	}
}
