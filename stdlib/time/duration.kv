// 欢迎加入kvspace世界
// lib time/duration —— 时长标准库便利函数。时长就是 **int64 纳秒**：加减比较极值全用 int64 算子，
// 能力清单只剩 time/duration·format()。本文件全是 rwfunc 封装（kv 源码，可寻址/可自改）。
// 单位换算是**常量乘除**：nanos=1、millis=1000000、seconds=1000000000、
// minutes=60000000000、hours=3600000000000、days=24×hours；as_* 是反向整除。

lib time/duration {
	rwfunc nanos(*int64 #n) -> (*int64 #dur) {
		*n -> *dur
	}
	rwfunc millis(*int64 #n) -> (*int64 #dur) {
		*n × 1000000 -> *dur
	}
	rwfunc seconds(*int64 #n) -> (*int64 #dur) {
		*n × 1000000000 -> *dur
	}
	rwfunc minutes(*int64 #n) -> (*int64 #dur) {
		*n × 60000000000 -> *dur
	}
	rwfunc hours(*int64 #n) -> (*int64 #dur) {
		*n × 3600000000000 -> *dur
	}
	rwfunc days(*int64 #n) -> (*int64 #dur) {
		*n × 86400000000000 -> *dur
	}
	rwfunc as_nanos(*int64 #d) -> (*int64 #n) {
		*d -> *n
	}
	rwfunc as_millis(*int64 #d) -> (*int64 #n) {
		*d ÷ 1000000 -> *n
	}
	rwfunc as_seconds(*int64 #d) -> (*int64 #n) {
		*d ÷ 1000000000 -> *n
	}
	rwfunc as_minutes(*int64 #d) -> (*int64 #n) {
		*d ÷ 60000000000 -> *n
	}
	rwfunc as_hours(*int64 #d) -> (*int64 #n) {
		*d ÷ 3600000000000 -> *n
	}
	rwfunc as_days(*int64 #d) -> (*int64 #n) {
		*d ÷ 86400000000000 -> *n
	}
	rwfunc add(*int64 #d1, *int64 #d2) -> (*int64 #r) {
		*d1 + *d2 -> *r
	}
	rwfunc sub(*int64 #d1, *int64 #d2) -> (*int64 #r) {
		*d1 - *d2 -> *r
	}
	rwfunc before(*int64 #d1, *int64 #d2) -> (*bool #r) {
		*d1 < *d2 -> *r
	}
	rwfunc after(*int64 #d1, *int64 #d2) -> (*bool #r) {
		*d1 > *d2 -> *r
	}
	rwfunc equal(*int64 #d1, *int64 #d2) -> (*bool #r) {
		*d1 == *d2 -> *r
	}
	rwfunc is_zero(*int64 #d) -> (*bool #r) {
		*d == 0 -> *r
	}
	rwfunc is_neg(*int64 #d) -> (*bool #r) {
		*d < 0 -> *r
	}
	rwfunc is_pos(*int64 #d) -> (*bool #r) {
		*d > 0 -> *r
	}
	rwfunc abs(*int64 #d) -> (*int64 #r) {
		if (*d < 0) {
			0 - *d -> *r
		} else {
			*d -> *r
		}
	}
	rwfunc max(*int64 #d1, *int64 #d2) -> (*int64 #r) {
		if (*d1 > *d2) {
			*d1 -> *r
		} else {
			*d2 -> *r
		}
	}
	rwfunc min(*int64 #d1, *int64 #d2) -> (*int64 #r) {
		if (*d1 < *d2) {
			*d1 -> *r
		} else {
			*d2 -> *r
		}
	}
	rwfunc clamp(*int64 #d, *int64 #lo, *int64 #hi) -> (*int64 #r) {
		if (*d < *lo) {
			*lo -> *r
		} else if (*d > *hi) {
			*hi -> *r
		} else {
			*d -> *r
		}
	}
}
