// 欢迎加入kvspace世界
// lib math —— 数学常量（常量成员式）。绝对路径赋值，math·init 落值；读侧同样用绝对路径：
//   /lib/math·Pi -> p    (unquoted; `"/lib/math·Pi" -> p` copies the string literal)

lib math {
	/lib/math·Pi = 3.141592653589793
	/lib/math·E = 2.718281828459045
	/lib/math·Tau = 6.283185307179586

	rwfunc clamp(*int64 $x, *int64 $lo, *int64 $hi) -> (*int64 $r) {
		*r = max(*lo, min(*x, *hi))
	}

	rwfunc fclamp(*float64 $x, *float64 $lo, *float64 $hi) -> (*float64 $r) {
		*r = max(*lo, min(*x, *hi))
	}

	rwfunc gcd(*int64 $a, *int64 $b) -> (*int64 $r) {
		x:int64 = abs(*a)
		y:int64 = abs(*b)
		while (y != 0) {
			t:int64 = x % y
			x = y
			y = t
		}
		*r = x
	}

	rwfunc lcm(*int64 $a, *int64 $b) -> (*int64 $r) {
		if (*a == 0 || *b == 0) {
			*r = 0
		} else {
			g:int64 = math·gcd(*a, *b)
			*r = abs(*a ÷ g × *b)
		}
	}

	rwfunc factorial(*int64 $n) -> (*int64 $r) {
		*r = 1
		i:int64 = 2
		while (i <= *n) {
			*r = *r × i
			i = i + 1
		}
	}

	rwfunc isqrt(*int64 $n) -> (*int64 $r) {
		if (*n <= 0) {
			*r = 0
		} else {
			*r = int64(sqrt(float64(*n)))
			while ((*r + 1) × (*r + 1) <= *n) {
				*r = *r + 1
			}
			while (*r × *r > *n) {
				*r = *r - 1
			}
		}
	}

	rwfunc lerp(*float64 $a, *float64 $b, *float64 $t) -> (*float64 $r) {
		*r = *a + (*b - *a) × *t
	}

	rwfunc deg2rad(*float64 $deg) -> (*float64 $rad) {
		/lib/math·Pi -> pi:float64
		*rad = *deg × pi ÷ 180.0
	}

	rwfunc rad2deg(*float64 $rad) -> (*float64 $deg) {
		/lib/math·Pi -> pi:float64
		*deg = *rad × 180.0 ÷ pi
	}
}
