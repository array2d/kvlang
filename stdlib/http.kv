
lib http {
	rwfunc get(*[]char/utf32 #url) -> (*[]char/utf32 #resp) {
		http·call("GET", "", *url, "") -> *resp
	}
	rwfunc post(*[]char/utf32 #url, *[]char/utf32 #body) -> (*[]char/utf32 #resp) {
		http·call("POST", "", *url, *body) -> *resp
	}
	rwfunc put(*[]char/utf32 #url, *[]char/utf32 #body) -> (*[]char/utf32 #resp) {
		http·call("PUT", "", *url, *body) -> *resp
	}
	rwfunc del(*[]char/utf32 #url) -> (*[]char/utf32 #resp) {
		http·call("DELETE", "", *url, "") -> *resp
	}
	rwfunc patch(*[]char/utf32 #url, *[]char/utf32 #body) -> (*[]char/utf32 #resp) {
		http·call("PATCH", "", *url, *body) -> *resp
	}
	rwfunc head(*[]char/utf32 #url) -> (*[]char/utf32 #resp) {
		http·call("HEAD", "", *url, "") -> *resp
	}
	rwfunc post_json(*[]char/utf32 #url, *[]char/utf32 #body) -> (*[]char/utf32 #resp) {
		http·call("POST", "Content-Type: application/json", *url, *body) -> *resp
	}
}
