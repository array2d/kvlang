// 欢迎加入kvspace世界
// lib kvlang/reflect —— kvlang 自省（rwfunc，kv 源码）。
//   fnlist(name) -> listing：枚举 /lib/<name> 下的能力名，逗号连接。
// 分类看 xvalue 的 langtype（三轴正交：ref / storetype / langtype），不看名字猜——
// 用 `compactarray·parselangtype(v) -> kind` 拿基名（剥掉 [dims] 与 "def " 前缀）：
//   langtype     形参 / 返回槽（def langtype）—— 不是能力，跳过
//   rwir         rwir 路由头（def rwir）—— 能力，名字原样
//   rwfunc       函数签名槽 —— 能力
//   其他数据      常量等普通 key —— 能力，名字原样
// 每个 rwfunc 在容器里有三条成员：`<fn>.[0,±k]`（形参）、`<fn>.src`（源码副本）、
//   `<fn>/`（函数目录条目）。前者按 langtype 跳过，中者是源码副本跳过，后者去尾斜杠即函数名。
// Read member values via path-string dynamic member access `base·*key` (base = "/lib/<name>").
// Members are enumerated via `kvspace·members`, which deduplicates coexisting value and directory
// entries into a single name.
// Purpose: summarize a `/lib/<name>` subtree's capabilities into a comma-separated line.
// Named `reflect` after Go/Rust reflection, leaving `lib kvlang` for core compiler/VM capabilities.

lib kvlang/reflect {
	rwfunc fnlist(*[]char/utf32 #name) -> (*[]char/utf32 #listing) {
		"" -> *listing
		"/lib/" + *name -> base:[]char/utf32
		base + "·" -> mdir:[]char/utf32
		ms:'[int64]'[]char/utf32 = {}
		kvspace·members(mdir) -> (ms, n:int64)
		i:int64 = 0
		while (i < n) {
			kvspace·listat(ms, i) -> mk:char/utf8
			ms·*mk -> k8:[]char/utf32
			char/utf32(k8) -> key:[]char/utf32
			// Path-string member base: `base·*key` reads `/lib/<name>·<key>` (`=` only copies strings).
			base·*key -> v:char/utf32
			compactarray·parselangtype(v) -> k:char/utf8
			// Skip dangling None entries (e.g. deleted `<pkg>·init`); `<fn>/` holds a non-None rwfunc marker.
			if (v != None && k != "langtype") {
				string·find(key, ".src") -> src:int64
				if (src < 0) {
					string·len(key) -> klen:int64
					string·char(key, klen - 1) -> tail:char/utf32
					if (tail == "/") {
						klen - 1 -> cut:int64
						string·slice(key, 0, cut) -> cap:[]char/utf32
					} else {
						key -> cap
					}
					if (*listing == "") {
						cap -> *listing
					} else {
						*listing + ", " + cap -> *listing
					}
				}
			}
			i + 1 -> i
		}
	}
}
