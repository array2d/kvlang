// 欢迎加入kvspace世界
lib kvlang/spec/附录/类型表达式文法 {
	r##"# 类型表达式（签名参数/返回值类型，多态 + 高维数组）

> 完整语义见 [[langtype签名类型表达式]]（类型系统卷）。**签名位（参数/返回值）写的是 `def langtype`（定义处
  的匹配类型）**，它可含并集/轴量词/`any`，因而能匹配多种调用时的 `langtype`（值的真实类型）；两者区别
  见该章。铁律：无家族简写（`int`/`uint`/`float`/`num`/`char`）——位宽是开放集合，编码须写明确；多态靠
  显式 `|` 枚举。

```
type_expr   = [ ref_prefix ] atom { "|" atom }   (* ref 前缀可选；layout 剥离前缀落 head ref 字节，wire langtype 不含前缀；见 [[总体方案]] *)
ref_prefix  = "*" | "@"                          (* * → ref=1（kvspace 内间接）；@ → ref=2（扩展世界，值在 kvspace 之外，runtime-c 不可直达、由支持 @ 的 rwir 兑现）。签名位置可写：`T` 值传、`*T` 址传、`@T` 扩展存储；值容器（map/struct）无值本体可拷，必须带 `*`/`@`，见 [[函数]] *)
atom        = shape | mapexpr | structref
shape       = [ dims ] ( any | kind )
mapexpr     = memitemkey "·" memitemvalue        (* stringkeymap；`·` 左=item 键侧的**格式器**（memitemkey_langtype_formatter）、右=item 值类型。声明形如 memheadname:memitemkey_langtype_formatter·memitemvalue_langtype={}，见 [[map容器]] *)
memitemvalue = type_expr                         (* item 值/body 类型，递归为完整 type_expr，故 map 可无限嵌套 *)
memitemkey  = scalar                             (* 裸标量键：键只在路径系统、无 body，故这是"格式器"——输出该标量字面量本身，如 b·200；禁止包成 [200]（见 [[文法与合法性]]） *)
            | "[]" char_enc                      (* 字符串键（格式器输出裸名字符串），等价 Go map[string]V *)
            | "[" scalar { "," scalar } "]"      (* 标量元组键（格式器输出 `[v0,v1,…]`），如 a·[342.124,23.2345]；与数组形状 [2]float64 不同——形状不可作键 *)
structref   = path                               (* struct 原型路径，如 /lib/Point *)
char_enc    = "char/utf8" | "char/utf32" | "char/ascii"
scalar      = "bool"
            | "int8" | "int16" | "int32" | "int64"
            | "uint8" | "uint16" | "uint32" | "uint64"
            | "float32" | "float64"
dims        = "[]"                               (* 等价 [.]：恰一维、长度任意 *)
            | "[" elem { "," elem } "]"          (* 逗号分割的轴量词序列；至多一个变元量词 ?/*/+ *)
elem        = integer                            (* 恰 1 轴、长度=integer *)
            | "."                                (* 恰 1 轴、任意长（≈正则 . ） *)
            | "?"                                (* 0 或 1 轴（≈正则 .? ） *)
            | "*"                                (* 0+ 轴（≈正则 .* ） *)
            | "+"                                (* 1+ 轴（≈正则 .+ ） *)
              (* 参数变参 "..." 不在类型表达式内——它是签名层 arity 构造，见 [[函数]] / [[程序结构]] *)
any         = "any"                              (* 通配，匹配任意 kind *)
kind        = "bool"
            | "int8" | "int16" | "int32" | "int64"
            | "uint8" | "uint16" | "uint32" | "uint64"
            | "float32" | "float64"
            | "char/utf8" | "char/utf32" | "char/ascii"
            | "stringkeymap"
            | "struct"
            | "rwir" | "rwfunc" | "time" | "duration"
              (* 标注可用 kind 白名单（layout known_kind）。rwfunc 兼作用户函数签名槽 kind；
                 def rwir 是 /lib/<op> 路由头（rwir 统一调度入口，仅存于 /lib/ 目录），不在标注白名单。
                 无 def rwfunc：rwfunc 有 kvlang 实现体（一串 rwir 指令槽），可被 main-runtime 直接解释执行，无需路由头（见 [[总体方案]]）。
                 `object`/`scope` 彻底删除，无此种类名（见 [[总体方案]]）；异构命名容器一律 struct。
                 index/extindex 是 storetype 名，不是 kind，故不在标注白名单；
                 `*`/`@` 是源码 ref_prefix（见上方 type_expr/ref_prefix 产生式）；layout 剥离前缀落 head ref 字节，wire langtype 不含前缀；
                 valid_langtype 校验剥离 ref_prefix 后的剩余部分；真正非法的是后缀 `int64*` 或前缀位置错误。 *)
```
"## -> /lib/kvlang/spec/附录/类型表达式文法
}
