- [[pkg与嵌套lib]]
- [[init函数]]
- [[签名装载]]
- [[rwfunc布局细节]]
- [[def-rwir路由头]]
- [[native-rwir不落盘]]
- [[lib数据常量]]
- [[struct原型]]
"## -> /lib/kvlang/规范/layout语义/lib与rwir数据
}
