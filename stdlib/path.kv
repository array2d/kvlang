lib path {
	rwfunc isabs(*[]char/utf32 $p) -> (*bool $r) {
		string·startswith(*p, "/") -> *r
	}

	rwfunc join(*[]char/utf32 $a, *[]char/utf32 $b) -> (*[]char/utf32 $r) {
		if (string·len(*b) == 0) {
			*a -> *r
		} else if (path·isabs(*b) || string·len(*a) == 0) {
			*b -> *r
		} else if (string·endswith(*a, "/")) {
			*a + *b -> *r
		} else {
			*a + "/" + *b -> *r
		}
	}

	rwfunc trim_slashes(*[]char/utf32 $p) -> (*[]char/utf32 $r) {
		hi:int64 = string·len(*p)
		while (hi > 1) {
			if (string·char(*p, hi - 1) != "/") {
				break
			}
			hi = hi - 1
		}
		string·slice(*p, 0, hi) -> *r
	}

	rwfunc dirname(*[]char/utf32 $p) -> (*[]char/utf32 $d) {
		if (string·len(*p) == 0) {
			"." -> *d
		} else {
			path·trim_slashes(*p) -> t:[]char/utf32
			string·rfind(t, "/") -> idx:int64
			if (idx == -1) {
				"." -> *d
			} else {
				string·slice(t, 0, max(1, idx)) -> prefix:[]char/utf32
				path·trim_slashes(prefix) -> *d
			}
		}
	}

	rwfunc basename(*[]char/utf32 $p) -> (*[]char/utf32 $b) {
		if (string·len(*p) == 0) {
			"" -> *b
		} else {
			path·trim_slashes(*p) -> t:[]char/utf32
			if (t == "/") {
				"/" -> *b
			} else {
				string·rfind(t, "/") -> idx:int64
				string·slice(t, idx + 1, string·len(t)) -> *b
			}
		}
	}

	rwfunc split(*[]char/utf32 $p) -> (*[]char/utf32 $dir, *[]char/utf32 $base) {
		path·dirname(*p) -> *dir
		path·basename(*p) -> *base
	}

	rwfunc splitext(*[]char/utf32 $p) -> (*[]char/utf32 $root, *[]char/utf32 $e) {
		plen:int64 = string·len(*p)
		string·rfind(*p, "/") -> slash:int64
		string·rfind(*p, ".") -> dot:int64
		if (dot <= slash + 1) {
			*p -> *root
			"" -> *e
		} else {
			string·slice(*p, slash + 1, dot) -> prefix:[]char/utf32
			if (string·allinset(prefix, ".")) {
				*p -> *root
				"" -> *e
			} else {
				string·slice(*p, 0, dot) -> *root
				string·slice(*p, dot, plen) -> *e
			}
		}
	}

	rwfunc ext(*[]char/utf32 $p) -> (*[]char/utf32 $e) {
		path·basename(*p) -> b:[]char/utf32
		path·splitext(b) -> (_, *e)
	}

	rwfunc stem(*[]char/utf32 $p) -> (*[]char/utf32 $s) {
		path·basename(*p) -> b:[]char/utf32
		path·splitext(b) -> (*s, _)
	}

	rwfunc normpath(*[]char/utf32 $p) -> (*[]char/utf32 $r) {
		n:int64 = string·len(*p)
		if (n == 0) {
			"." -> *r
		} else {
			path·isabs(*p) -> is_abs:bool
			"" -> acc:[]char/utf32
			i:int64 = 0
			while (i < n) {
				while (i < n) {
					if (string·char(*p, i) != "/") {
						break
					}
					i = i + 1
				}
				if (i < n) {
					start:int64 = i
					while (i < n) {
						if (string·char(*p, i) == "/") {
							break
						}
						i = i + 1
					}
					string·slice(*p, start, i) -> seg:[]char/utf32
					if (seg == "..") {
						al:int64 = string·len(acc)
						if (al == 0) {
							if (!is_abs) {
								".." -> acc
							}
						} else {
							string·rfind(acc, "/") -> ls:int64
							string·slice(acc, ls + 1, al) -> last_seg:[]char/utf32
							if (last_seg == "..") {
								acc + "/.." -> acc
							} else if (ls == -1) {
								"" -> acc
							} else {
								string·slice(acc, 0, ls) -> acc
							}
						}
					} else if (seg != ".") {
						if (string·len(acc) == 0) {
							seg -> acc
						} else {
							acc + "/" + seg -> acc
						}
					}
				}
			}
			if (is_abs) {
				"/" + acc -> *r
			} else if (string·len(acc) == 0) {
				"." -> *r
			} else {
				acc -> *r
			}
		}
	}
}
