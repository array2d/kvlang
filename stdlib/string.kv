
lib string {
	
	rwfunc eq(*[]char/utf32 #a, *[]char/utf32 #b) -> (*bool #r) {
		string·cmp(*a, *b) == 0 -> *r
	}
	rwfunc ne(*[]char/utf32 #a, *[]char/utf32 #b) -> (*bool #r) {
		string·cmp(*a, *b) != 0 -> *r
	}
	rwfunc empty(*[]char/utf32 #s) -> (*bool #r) {
		string·len(*s) == 0 -> *r
	}
	rwfunc contains(*[]char/utf32 #s, *[]char/utf32 #sub) -> (*bool #r) {
		string·find(*s, *sub) != -1 -> *r
	}
	rwfunc startswith(*[]char/utf32 #s, *[]char/utf32 #pre) -> (*bool #r) {
		sl:int64 = string·len(*s)
		pl:int64 = string·len(*pre)
		if (pl > sl) {
			false -> *r
		} else {
			string·slice(*s, 0, pl) -> prefix:char/utf32
			string·cmp(prefix, *pre) == 0 -> *r
		}
	}
	rwfunc endswith(*[]char/utf32 #s, *[]char/utf32 #suf) -> (*bool #r) {
		sl:int64 = string·len(*s)
		fl:int64 = string·len(*suf)
		if (fl > sl) {
			false -> *r
		} else {
			sl - fl -> lo:int64
			string·slice(*s, lo, sl) -> tail:char/utf32
			string·cmp(tail, *suf) == 0 -> *r
		}
	}
	
	rwfunc eqfold(*[]char/utf32 #a, *[]char/utf32 #b) -> (*bool #r) {
		string·upper(*a) -> ua:[]char/utf32
		string·upper(*b) -> ub:[]char/utf32
		string·cmp(ua, ub) == 0 -> *r
	}

	rwfunc count(*[]char/utf32 #s, *[]char/utf32 #sub) -> (*int64 #n) {
		ln:int64 = string·len(*s)
		m:int64 = string·len(*sub)
		*n = 0
		if (m == 0) {
			*n = ln + 1
		} else {
			pos:int64 = 0
			while (pos + m <= ln) {
				string·slice(*s, pos, ln) -> rest:char/utf32
				string·find(rest, *sub) -> i:int64
				if (i == -1) {
					break
				}
				*n = *n + 1
				pos = pos + i + m
			}
		}
	}
	
	rwfunc rfind(*[]char/utf32 #s, *[]char/utf32 #sub) -> (*int64 #i) {
		ln:int64 = string·len(*s)
		m:int64 = string·len(*sub)
		*i = -1
		pos:int64 = 0
		while (pos + m <= ln) {
			string·slice(*s, pos, ln) -> rest:char/utf32
			string·find(rest, *sub) -> k:int64
			if (k == -1) {
				break
			}
			*i = pos + k
			pos = pos + k + 1
		}
	}

	rwfunc trim(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		string·trimstart(*s) -> t:[]char/utf32
		string·trimend(t) -> *r
	}
	
	rwfunc trimstart(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		lo:int64 = 0
		hi:int64 = string·len(*s)
		while (lo < hi) {
			string·char(*s, lo) -> c:char/utf32
			string·find(" \t\n\r\v\f", c) -> w:int64
			if (w == -1) {
				break
			}
			lo = lo + 1
		}
		string·slice(*s, lo, hi) -> *r
	}
	
	rwfunc trimend(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		lo:int64 = 0
		hi:int64 = string·len(*s)
		while (hi > lo) {
			string·char(*s, hi - 1) -> c:char/utf32
			string·find(" \t\n\r\v\f", c) -> w:int64
			if (w == -1) {
				break
			}
			hi = hi - 1
		}
		string·slice(*s, lo, hi) -> *r
	}
	
	rwfunc trimprefix(*[]char/utf32 #s, *[]char/utf32 #pre) -> (*[]char/utf32 #r) {
		string·startswith(*s, *pre) -> ok:bool
		if (ok) {
			pl:int64 = string·len(*pre)
			sl:int64 = string·len(*s)
			string·slice(*s, pl, sl) -> *r
		} else {
			*s -> *r
		}
	}
	
	rwfunc trimsuffix(*[]char/utf32 #s, *[]char/utf32 #suf) -> (*[]char/utf32 #r) {
		string·endswith(*s, *suf) -> ok:bool
		if (ok) {
			fl:int64 = string·len(*suf)
			sl:int64 = string·len(*s)
			string·slice(*s, 0, sl - fl) -> *r
		} else {
			*s -> *r
		}
	}
	
	rwfunc padstart(*[]char/utf32 #s, *int64 #n,
	                *[]char/utf32 #pad) -> (*[]char/utf32 #r) {
		need:int64 = *n - string·len(*s)
		pl:int64 = string·len(*pad)
		"" -> pre:[]char/utf32
		while (need > 0 && pl > 0 && string·len(pre) < need) {
			string·concat(pre, *pad) -> pre
		}
		string·len(pre) -> q:int64
		if (need > 0 && q > need) {
			string·slice(pre, 0, need) -> pre
		}
		string·concat(pre, *s) -> *r
	}
	
	rwfunc padend(*[]char/utf32 #s, *int64 #n,
	              *[]char/utf32 #pad) -> (*[]char/utf32 #r) {
		*s -> *r
		need:int64 = *n - string·len(*s)
		pl:int64 = string·len(*pad)
		"" -> suf:[]char/utf32
		while (need > 0 && pl > 0 && string·len(suf) < need) {
			string·concat(suf, *pad) -> suf
		}
		string·len(suf) -> q:int64
		if (need > 0 && q > need) {
			string·slice(suf, 0, need) -> suf
		}
		string·concat(*r, suf) -> *r
	}

	rwfunc splitn(*[]char/utf32 #s, *[]char/utf32 #sep, *int64 #n) -> (
	              *'[int64]'[]char/utf32 #parts, *int64 #k) {
		*k = 0
		if (*n != 0) {
			ln:int64 = string·len(*s)
			m:int64 = string·len(*sep)
			pos:int64 = 0
			if (m == 0) {
				while (pos < ln) {
					if (*n > 0 && *k == *n - 1) {
						string·slice(*s, pos, ln) -> seg:char/utf32
						scatterarray·append(*parts, seg) -> *parts
						*k = *k + 1
						pos = ln
					} else {
						string·char(*s, pos) -> c:char/utf32
						scatterarray·append(*parts, c) -> *parts
						*k = *k + 1
						pos = pos + 1
					}
				}
			} else {
				while (pos <= ln) {
					if (*n > 0 && *k == *n - 1) {
						string·slice(*s, pos, ln) -> seg
						scatterarray·append(*parts, seg) -> *parts
						*k = *k + 1
						pos = ln + 1
					} else {
						string·slice(*s, pos, ln) -> rest:char/utf32
						string·find(rest, *sep) -> j:int64
						if (j == -1) {
							rest -> seg
							scatterarray·append(*parts, seg) -> *parts
							*k = *k + 1
							pos = ln + 1
						} else {
							string·slice(*s, pos, pos + j) -> seg
							scatterarray·append(*parts, seg) -> *parts
							*k = *k + 1
							pos = pos + j + m
						}
					}
				}
			}
		}
	}
	
	rwfunc split(*[]char/utf32 #s, *[]char/utf32 #sep) -> (
	             *'[int64]'[]char/utf32 #parts, *int64 #k) {
		string·splitn(*s, *sep, -1) -> (*parts, *k)
	}
	
	rwfunc lines(*[]char/utf32 #s) -> (
	             *'[int64]'[]char/utf32 #parts, *int64 #k) {
		*k = 0
		ln:int64 = string·len(*s)
		pos:int64 = 0
		while (pos < ln) {
			string·slice(*s, pos, ln) -> rest:char/utf32
			string·find(rest, "\n") -> j:int64
			line:char/utf32 = rest
			if (j != -1) {
				string·slice(*s, pos, pos + j) -> line2:char/utf32
				line2 -> line
				pos = pos + j + 1
			} else {
				pos = ln
			}
			string·len(line) -> llen:int64
			if (llen > 0) {
				string·char(line, llen - 1) -> last:char/utf32
				if (string·cmp(last, "\r") == 0) {
					string·slice(line, 0, llen - 1) -> line3:char/utf32
					line3 -> line
				}
			}
			scatterarray·append(*parts, line) -> *parts
			*k = *k + 1
		}
	}
	
	rwfunc fields(*[]char/utf32 #s) -> (
	              *'[int64]'[]char/utf32 #parts, *int64 #k) {
		*k = 0
		ln:int64 = string·len(*s)
		i:int64 = 0
		while (i < ln) {
			while (i < ln) {
				string·char(*s, i) -> c:char/utf32
				string·find(" \t\n\r\v\f", c) -> w:int64
				if (w == -1) {
					break
				}
				i = i + 1
			}
			if (i < ln) {
				start:int64 = i
				while (i < ln) {
					string·char(*s, i) -> c2:char/utf32
					string·find(" \t\n\r\v\f", c2) -> w2:int64
					if (w2 != -1) {
						break
					}
					i = i + 1
				}
				string·slice(*s, start, i) -> word:char/utf32
				scatterarray·append(*parts, word) -> *parts
				*k = *k + 1
			}
		}
	}
	
	rwfunc join(*'[int64]'[]char/utf32 #parts,
	            *[]char/utf32 #sep) -> (*[]char/utf32 #r) {
		"" -> *r
		pathspace·listlen(*parts) -> c:int64
		i:int64 = 0
		while (i < c) {
			if (i > 0) {
				string·concat(*r, *sep) -> *r
			}
			pathspace·listat(*parts, i) -> key:char/utf8
			(*parts)·*key -> v:[]char/utf32
			string·concat(*r, v) -> *r
			i = i + 1
		}
	}
	
	rwfunc cut(*[]char/utf32 #s, *[]char/utf32 #sep) -> (
	            *[]char/utf32 #before, *[]char/utf32 #after, *bool #found) {
		string·find(*s, *sep) -> j:int64
		m:int64 = string·len(*sep)
		ln:int64 = string·len(*s)
		if (j == -1) {
			*s -> *before
			"" -> *after
			*found = false
		} else {
			string·slice(*s, 0, j) -> *before
			string·slice(*s, j + m, ln) -> *after
			*found = true
		}
	}

	rwfunc replacen(*[]char/utf32 #s, *[]char/utf32 #old, *[]char/utf32 #new,
	                *int64 #limit) -> (*[]char/utf32 #out, *int64 #k) {
		ln:int64 = string·len(*s)
		m:int64 = string·len(*old)
		"" -> *out
		*k = 0
		if (m == 0) {
			i:int64 = 0
			while (i <= ln) {
				if (*limit >= 0 && *k >= *limit) {
					break
				}
				string·concat(*out, *new) -> *out
				*k = *k + 1
				if (i < ln) {
					string·char(*s, i) -> c:char/utf32
					string·concat(*out, c) -> *out
				}
				i = i + 1
			}
			if (i < ln) {
				string·slice(*s, i, ln) -> tail:char/utf32
				string·concat(*out, tail) -> *out
			}
		} else {
			pos:int64 = 0
			while (pos + m <= ln) {
				if (*limit >= 0 && *k >= *limit) {
					break
				}
				string·slice(*s, pos, ln) -> rest:char/utf32
				string·find(rest, *old) -> j:int64
				if (j == -1) {
					break
				}
				string·slice(*s, pos, pos + j) -> seg:char/utf32
				string·concat(*out, seg) -> *out
				string·concat(*out, *new) -> *out
				*k = *k + 1
				pos = pos + j + m
			}
			string·slice(*s, pos, ln) -> tail
			string·concat(*out, tail) -> *out
		}
	}
	
	rwfunc replace(*[]char/utf32 #s, *[]char/utf32 #old,
	               *[]char/utf32 #new) -> (*[]char/utf32 #out, *int64 #k) {
		string·replacen(*s, *old, *new, -1) -> (*out, *k)
	}

	rwfunc reverse(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		n:int64 = string·len(*s)
		"" -> *r
		i:int64 = n - 1
		while (i >= 0) {
			string·char(*s, i) -> c:char/utf32
			string·concat(*r, c) -> *r
			i = i - 1
		}
	}
	rwfunc repeat(*[]char/utf32 #s, *int64 #n) -> (*[]char/utf32 #r) {
		"" -> *r
		i:int64 = 0
		while (i < *n) {
			string·concat(*r, *s) -> *r
			i = i + 1
		}
	}
	rwfunc upper(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		"" -> *r
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·find("abcdefghijklmnopqrstuvwxyz", c) -> idx:int64
			if (idx != -1) {
				string·char("ABCDEFGHIJKLMNOPQRSTUVWXYZ", idx) -> uc:char/utf32
				string·concat(*r, uc) -> *r
			} else {
				string·concat(*r, c) -> *r
			}
			i = i + 1
		}
	}
	rwfunc lower(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		"" -> *r
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) -> idx:int64
			if (idx != -1) {
				string·char("abcdefghijklmnopqrstuvwxyz", idx) -> lc:char/utf32
				string·concat(*r, lc) -> *r
			} else {
				string·concat(*r, c) -> *r
			}
			i = i + 1
		}
	}
	
	rwfunc capitalize(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		ln:int64 = string·len(*s)
		if (ln == 0) {
			"" -> *r
		} else {
			string·char(*s, 0) -> c0:char/utf32
			string·slice(*s, 1, ln) -> rest:char/utf32
			string·upper(c0) -> uc:char/utf32
			string·lower(rest) -> lr:[]char/utf32
			string·concat(uc, lr) -> *r
		}
	}
	
	rwfunc title(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		"" -> *r
		n:int64 = string·len(*s)
		i:int64 = 0
		prev:bool = false
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·isalpha(c) -> a:bool
			if (a) {
				if (prev) {
					string·lower(c) -> x:char/utf32
				} else {
					string·upper(c) -> x
				}
				prev = true
			} else {
				c -> x
				prev = false
			}
			string·concat(*r, x) -> *r
			i = i + 1
		}
	}
	
	rwfunc swapcase(*[]char/utf32 #s) -> (*[]char/utf32 #r) {
		"" -> *r
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·upper(c) -> u:char/utf32
			string·lower(c) -> l:char/utf32
			if (string·cmp(u, c) == 0) {
				string·concat(*r, l) -> *r
			} else {
				string·concat(*r, u) -> *r
			}
			i = i + 1
		}
	}

	rwfunc allinset(*[]char/utf32 #s, *[]char/utf32 #set) -> (*bool #r) {
		n:int64 = string·len(*s)
		*r = n > 0
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·find(*set, c) -> k:int64
			if (k == -1) {
				*r = false
				break
			}
			i = i + 1
		}
	}
	rwfunc isalpha(*[]char/utf32 #s) -> (*bool #r) {
		set:[]char/utf32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		string·allinset(*s, set) -> *r
	}
	rwfunc isdigit(*[]char/utf32 #s) -> (*bool #r) {
		string·allinset(*s, "0123456789") -> *r
	}
	rwfunc isalnum(*[]char/utf32 #s) -> (*bool #r) {
		set:[]char/utf32 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		string·allinset(*s, set) -> *r
	}
	rwfunc isxdigit(*[]char/utf32 #s) -> (*bool #r) {
		string·allinset(*s, "0123456789abcdefABCDEF") -> *r
	}
	rwfunc isspace(*[]char/utf32 #s) -> (*bool #r) {
		string·allinset(*s, " \t\n\r\v\f") -> *r
	}
	
	rwfunc isupper(*[]char/utf32 #s) -> (*bool #r) {
		up:bool = false
		bad:bool = false
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) -> u:int64
			string·find("abcdefghijklmnopqrstuvwxyz", c) -> l:int64
			if (u != -1) {
				up = true
			}
			if (l != -1) {
				bad = true
			}
			i = i + 1
		}
		*r = up && !bad
	}
	
	rwfunc islower(*[]char/utf32 #s) -> (*bool #r) {
		lo:bool = false
		bad:bool = false
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·find("abcdefghijklmnopqrstuvwxyz", c) -> l:int64
			string·find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) -> u:int64
			if (l != -1) {
				lo = true
			}
			if (u != -1) {
				bad = true
			}
			i = i + 1
		}
		*r = lo && !bad
	}
	
	rwfunc ispunct(*[]char/utf32 #s) -> (*bool #r) {
		al:[]char/utf32 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		n:int64 = string·len(*s)
		*r = n > 0
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·ord(c) -> o:int64
			string·find(al, c) -> a:int64
			if (o < 33 || o > 126 || a != -1) {
				*r = false
				break
			}
			i = i + 1
		}
	}
	
	rwfunc lang(*[]char/utf32 #s) -> (*[]char/utf32 #lg) {
		han:bool = false
		kana:bool = false
		hangul:bool = false
		latin:bool = false
		n:int64 = string·len(*s)
		i:int64 = 0
		while (i < n) {
			string·char(*s, i) -> c:char/utf32
			string·ord(c) -> o:int64
			if (o >= 12352) { if (o <= 12543) { kana = true } }     
			if (o >= 19968) { if (o <= 40959) { han = true } }      
			if (o >= 44032) { if (o <= 55215) { hangul = true } }   
			if (o >= 65) { if (o <= 90) { latin = true } }          
			if (o >= 97) { if (o <= 122) { latin = true } }         
			i = i + 1
		}
		"other" -> *lg
		if (latin) { "en" -> *lg }
		if (han) { "zh" -> *lg }
		if (hangul) { "ko" -> *lg }
		if (kana) { "ja" -> *lg }
	}
}
