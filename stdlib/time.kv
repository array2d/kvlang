// 欢迎加入kvspace世界
// lib time —— 时间标准库便利函数。时间就是 **int64 纳秒**：加减比较换算全用 int64 算子，
// 能力清单只剩 time·now() / time·format()。本文件全是 rwfunc 封装（kv 源码，可寻址/可自改）。

lib time {
	rwfunc since(*int64 #t) -> (*int64 #dur) {
		time·now() - *t -> *dur
	}
	rwfunc until(*int64 #t) -> (*int64 #dur) {
		*t - time·now() -> *dur
	}
	rwfunc equal(*int64 #a, *int64 #b) -> (*bool #r) {
		*a == *b -> *r
	}
	rwfunc elapsed_ns(*int64 #t) -> (*int64 #ns) {
		time·now() - *t -> *ns
	}
	rwfunc elapsed_ms(*int64 #t) -> (*int64 #ms) {
		time·now() - *t -> ns:int64
		ns ÷ 1000000 -> *ms
	}
	rwfunc elapsed_s(*int64 #t) -> (*int64 #s) {
		time·now() - *t -> ns:int64
		ns ÷ 1000000000 -> *s
	}
	rwfunc max(*int64 #a, *int64 #b) -> (*int64 #r) {
		if (*a > *b) {
			*a -> *r
		} else {
			*b -> *r
		}
	}
	rwfunc min(*int64 #a, *int64 #b) -> (*int64 #r) {
		if (*a < *b) {
			*a -> *r
		} else {
			*b -> *r
		}
	}
}
