// 欢迎加入kvspace世界
// lib xv —— 数组操作便利库。native rwir：compactarray·at/set/newreshape/newreinterpret/
// langtype/bodylen/parselangtype、compactarray·numel/dim/shape；
// rwfunc 补充（[]int64 一维/多维 compact 数组）：
//   first / last         首/尾元素
//   swap                 交换两下标元素，返回新数组
//   reverse              反转一维数组，返回新数组
//   contains / find / count  包含判定、首次出现下标（无则 -1）、元素计数
//   sum / min / max      求和、最小值、最大值
//   flatten              多维 compact 数组展平为一维 []int64
// 值语义铁律：compactarray·set 仅同槽 patch；异槽变换必须先 compactarray·copy。

lib xv {
	rwfunc swap(arr:[]int64, i:int64, j:int64) -> (result:[]int64) {
		vi = compactarray·at(arr, i)
		vj = compactarray·at(arr, j)
		tmp = compactarray·copy(arr)
		compactarray·set(tmp, i, vj) -> tmp
		compactarray·set(tmp, j, vi) -> tmp
		result = tmp
	}
	rwfunc first(arr:[]int64) -> (result:int64) {
		result = compactarray·at(arr, 0)
	}
	rwfunc last(arr:[]int64) -> (result:int64) {
		n = compactarray·numel(arr)
		result = compactarray·at(arr, n - 1)
	}
	rwfunc reverse(arr:[]int64) -> (result:[]int64) {
		result = arr
		n = compactarray·numel(arr)
		i = 0
		j = n - 1
		while (i < j) {
			xv·swap(result, i, j) -> result
			i = i + 1
			j = j - 1
		}
	}
	rwfunc find(arr:[]int64, val:int64) -> (idx:int64) {
		idx = -1
		n = compactarray·numel(arr)
		i = 0
		while (i < n) {
			compactarray·at(arr, i) -> v
			if (v == val) {
				idx = i
				break
			}
			i = i + 1
		}
	}
	rwfunc contains(arr:[]int64, val:int64) -> (ok:bool) {
		xv·find(arr, val) -> idx
		idx != -1 -> ok
	}
	rwfunc count(arr:[]int64, val:int64) -> (cnt:int64) {
		cnt = 0
		n = compactarray·numel(arr)
		i = 0
		while (i < n) {
			compactarray·at(arr, i) -> v
			if (v == val) {
				cnt = cnt + 1
			}
			i = i + 1
		}
	}
	rwfunc sum(arr:[]int64) -> (total:int64) {
		total = 0
		n = compactarray·numel(arr)
		i = 0
		while (i < n) {
			compactarray·at(arr, i) -> v
			total = total + v
			i = i + 1
		}
	}
	rwfunc min(arr:[]int64) -> (m:int64) {
		compactarray·at(arr, 0) -> m
		n = compactarray·numel(arr)
		i = 1
		while (i < n) {
			compactarray·at(arr, i) -> v
			if (v < m) {
				m = v
			}
			i = i + 1
		}
	}
	rwfunc max(arr:[]int64) -> (m:int64) {
		compactarray·at(arr, 0) -> m
		n = compactarray·numel(arr)
		i = 1
		while (i < n) {
			compactarray·at(arr, i) -> v
			if (v > m) {
				m = v
			}
			i = i + 1
		}
	}
	rwfunc flatten(arr:[]int64) -> (result:[]int64) {
		n = compactarray·numel(arr)
		compactarray·newreshape(arr, n) -> result
	}
}
