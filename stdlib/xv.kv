// 欢迎加入kvspace世界
// lib xv —— 数组操作便利库。native rwir：compactarray·at/set/newreshape/newreinterpret/
// langtype/bodylen/parselangtype、compactarray·numel/dim/shape；
// rwfunc 补充（[]int64 一维/多维 compact 数组）：
//   first / last         首/尾元素
//   swap                 交换两下标元素，返回新数组
//   reverse              反转一维数组，返回新数组
//   contains / find / count  包含判定、首次出现下标（无则 -1）、元素计数
//   sum / min / max      求和、最小值、最大值
//   flatten              多维 compact 数组展平为一维 []int64
// 值语义铁律：compactarray·set 仅同槽 patch；异槽变换必须先 compactarray·copy。

lib xv {
	rwfunc swap(*[]int64 $arr, *int64 $i, *int64 $j) -> (*[]int64 $result) {
		vi:int64 = compactarray·at(*arr, *i)
		vj:int64 = compactarray·at(*arr, *j)
		tmp:[]int64 = compactarray·copy(*arr)
		compactarray·set(tmp, *i, vj) -> tmp
		compactarray·set(tmp, *j, vi) -> tmp
		*result = tmp
	}

	rwfunc first(*[]int64 $arr) -> (*int64 $result) {
		*result = compactarray·at(*arr, 0)
	}
	rwfunc last(*[]int64 $arr) -> (*int64 $result) {
		n:int64 = compactarray·numel(*arr)
		*result = compactarray·at(*arr, n - 1)
	}
	rwfunc reverse(*[]int64 $arr) -> (*[]int64 $result) {
		*result = *arr
		n:int64 = compactarray·numel(*arr)
		i:int64 = 0
		j:int64 = n - 1
		while (i < j) {
			xv·swap(*result, i, j) -> *result
			i = i + 1
			j = j - 1
		}
	}
	rwfunc find(*[]int64 $arr, *int64 $val) -> (*int64 $idx) {
		*idx = -1
		n:int64 = compactarray·numel(*arr)
		i:int64 = 0
		while (i < n) {
			compactarray·at(*arr, i) -> v:int64
			if (v == *val) {
				*idx = i
				break
			}
			i = i + 1
		}
	}
	rwfunc contains(*[]int64 $arr, *int64 $val) -> (*bool $ok) {
		xv·find(*arr, *val) -> idx:int64
		idx != -1 -> *ok
	}
	rwfunc count(*[]int64 $arr, *int64 $val) -> (*int64 $cnt) {
		*cnt = 0
		n:int64 = compactarray·numel(*arr)
		i:int64 = 0
		while (i < n) {
			compactarray·at(*arr, i) -> v:int64
			if (v == *val) {
				*cnt = *cnt + 1
			}
			i = i + 1
		}
	}
	rwfunc sum(*[]int64 $arr) -> (*int64 $total) {
		*total = 0
		n:int64 = compactarray·numel(*arr)
		i:int64 = 0
		while (i < n) {
			compactarray·at(*arr, i) -> v:int64
			*total = *total + v
			i = i + 1
		}
	}
	rwfunc min(*[]int64 $arr) -> (*int64 $m) {
		compactarray·at(*arr, 0) -> *m
		n:int64 = compactarray·numel(*arr)
		i:int64 = 1
		while (i < n) {
			compactarray·at(*arr, i) -> v:int64
			if (v < *m) {
				*m = v
			}
			i = i + 1
		}
	}
	rwfunc max(*[]int64 $arr) -> (*int64 $m) {
		compactarray·at(*arr, 0) -> *m
		n:int64 = compactarray·numel(*arr)
		i:int64 = 1
		while (i < n) {
			compactarray·at(*arr, i) -> v:int64
			if (v > *m) {
				*m = v
			}
			i = i + 1
		}
	}
	rwfunc flatten(*[]int64 $arr) -> (*[]int64 $result) {
		n:int64 = compactarray·numel(*arr)
		compactarray·newreshape(*arr, n) -> *result
	}
	// ── 以下为 #514 增补吸收（原 xv·at/set、ndarray·numel 改写为
	//    compactarray 系；mutating 函数先 compactarray·copy 再 set）──
	rwfunc argmin(*[]int64 $arr) -> (*int64 $idx) {
		n:int64 = compactarray·numel(*arr)
		if (n == 0) {
			*idx = -1
		} else {
			*idx = 0
			best:int64 = compactarray·at(*arr, 0)
			i:int64 = 1
			while (i < n) {
				v:int64 = compactarray·at(*arr, i)
				if (v < best) {
					best = v
					*idx = i
				}
				i = i + 1
			}
		}
	}
	rwfunc argmax(*[]int64 $arr) -> (*int64 $idx) {
		n:int64 = compactarray·numel(*arr)
		if (n == 0) {
			*idx = -1
		} else {
			*idx = 0
			best:int64 = compactarray·at(*arr, 0)
			i:int64 = 1
			while (i < n) {
				v:int64 = compactarray·at(*arr, i)
				if (v > best) {
					best = v
					*idx = i
				}
				i = i + 1
			}
		}
	}
	rwfunc rfind(*[]int64 $arr, *int64 $target) -> (*int64 $idx) {
		*idx = -1
		i:int64 = compactarray·numel(*arr) - 1
		while (i >= 0) {
			if (compactarray·at(*arr, i) == *target) {
				*idx = i
				break
			}
			i = i - 1
		}
	}
	rwfunc eq(*[]int64 $a, *[]int64 $b) -> (*bool $r) {
		na:int64 = compactarray·numel(*a)
		if (na != compactarray·numel(*b)) {
			*r = false
		} else {
			*r = true
			i:int64 = 0
			while (i < na) {
				if (compactarray·at(*a, i) != compactarray·at(*b, i)) {
					*r = false
					break
				}
				i = i + 1
			}
		}
	}
	rwfunc is_sorted(*[]int64 $arr) -> (*bool $r) {
		n:int64 = compactarray·numel(*arr)
		*r = true
		i:int64 = 1
		while (i < n) {
			if (compactarray·at(*arr, i) < compactarray·at(*arr, i - 1)) {
				*r = false
				break
			}
			i = i + 1
		}
	}
	rwfunc sort(*[]int64 $arr) -> (*[]int64 $result) {
		*result = compactarray·copy(*arr)
		n:int64 = compactarray·numel(*result)
		i:int64 = 1
		while (i < n) {
			key:int64 = compactarray·at(*result, i)
			j:int64 = i - 1
			while (j >= 0) {
				vj:int64 = compactarray·at(*result, j)
				if (vj <= key) {
					break
				}
				compactarray·set(*result, j + 1, vj) -> *result
				j = j - 1
			}
			compactarray·set(*result, j + 1, key) -> *result
			i = i + 1
		}
	}
	rwfunc binary_search(*[]int64 $arr, *int64 $target) -> (*int64 $idx) {
		lo:int64 = 0
		hi:int64 = compactarray·numel(*arr) - 1
		*idx = -1
		while (lo <= hi) {
			mid:int64 = lo + (hi - lo) ÷ 2
			vm:int64 = compactarray·at(*arr, mid)
			if (vm == *target) {
				*idx = mid
				break
			} else if (vm < *target) {
				lo = mid + 1
			} else {
				hi = mid - 1
			}
		}
	}
	rwfunc fill(*[]int64 $arr, *int64 $val) -> (*[]int64 $result) {
		*result = compactarray·copy(*arr)
		n:int64 = compactarray·numel(*result)
		i:int64 = 0
		while (i < n) {
			compactarray·set(*result, i, *val) -> *result
			i = i + 1
		}
	}
}
