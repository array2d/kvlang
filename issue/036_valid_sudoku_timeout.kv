# 036: Valid Sudoku — 验证 4x4 数独棋盘
# 来源: LeetCode #36 (简化版)
# 期望输出:
#   true
#   false
def has_dup(arr:int64, start:int64, N:int64, step:int64, marker:int64) -> (dup:int64) {
	dup = 0  # = 等价于 <-
	i <- 0
	while (i < N) {
		idx = start + i * step  # = 等价于 <-
		arr[idx] -> v
		if (v != 0) {
			marker[v] -> seen
			if (seen == 1) { 1 -> dup ; N -> i }
			else { marker[v] <- 1 }
		}
		i + 1 -> i
	}
	# clear marker
	i2 <- 0
	while (i2 < N) {
		idx2 = start + i2 * step  # = 等价于 <-
		arr[idx2] -> v2
		if (v2 != 0) { marker[v2] <- 0 }
		i2 + 1 -> i2
	}
}

def check_rows(board:int64, N:int64) -> (ok:int64) {
	marker:int64 <- [0, 0, 0, 0, 0]
	ok = 1  # = 等价于 <-
	r <- 0
	while (r < N) {
		dup <- has_dup(board, r*N, N, 1, marker)
		if (dup == 1) { 0 -> ok ; N -> r }
		r + 1 -> r
	}
}

def check_cols(board:int64, N:int64) -> (ok:int64) {
	marker:int64 <- [0, 0, 0, 0, 0]
	ok = 1  # = 等价于 <-
	c <- 0
	while (c < N) {
		dup <- has_dup(board, c, N, N, marker)
		if (dup == 1) { 0 -> ok ; N -> c }
		c + 1 -> c
	}
}

def check_boxes(board:int64, N:int64, B:int64) -> (ok:int64) {
	marker:int64 <- [0, 0, 0, 0, 0]
	ok = 1  # = 等价于 <-
	br <- 0
	while (br < B) {
		bc <- 0
		while (bc < B) {
			start = br * B * N + bc * B  # = 等价于 <-
			r <- 0
			dup2 = 0  # = 等价于 <-
			while (r < B) {
				c <- 0
				while (c < B) {
					idx = start + r * N + c  # = 等价于 <-
					board[idx] -> v
					if (v != 0) {
						marker[v] -> seen
						if (seen == 1) { 1 -> dup2 ; B -> r ; B -> c }
						else { marker[v] <- 1 }
					}
					c + 1 -> c
				}
				r + 1 -> r
			}
			# clear marker for this box
			cr <- 0
			while (cr < B) {
				cc2 <- 0
				while (cc2 < B) {
					idx2 = start + cr * N + cc2  # = 等价于 <-
					board[idx2] -> v2
					if (v2 != 0) { marker[v2] <- 0 }
					cc2 + 1 -> cc2
				}
				cr + 1 -> cr
			}
			if (dup2 == 1) { 0 -> ok ; B -> br ; B -> bc }
			bc + 1 -> bc
		}
		br + 1 -> br
	}
}

def is_valid(board:int64, N:int64, B:int64) -> (ok:int64) {
	ok = 1  # = 等价于 <-
	r_ok <- check_rows(board, N)
	if (r_ok == 0) { 0 -> ok }
	c_ok <- check_cols(board, N)
	if (c_ok == 0) { 0 -> ok }
	b_ok = check_boxes(board, N, B)  # = 等价于 <-
	if (b_ok == 0) { 0 -> ok }
}

def main() -> () {
	valid:int64 <- [1,2,3,4, 3,4,1,2, 2,1,4,3, 4,3,2,1]
	invalid:int64 <- [1,2,3,4, 3,4,1,2, 2,1,4,3, 1,3,2,4]
	r1 = is_valid(valid, 4, 2)  # = 等价于 <-
	if (r1 == 1) { print("true") } else { print("false") }
	r2 <- is_valid(invalid, 4, 2)
	if (r2 == 1) { print("true") } else { print("false") }
}
main()
