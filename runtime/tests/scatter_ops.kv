// Regression test for `scatterarray·new/len/at/set` and `compactarray·newslice`.
rwfunc test() -> () {
	s:[int64]·int64 = scatterarray·new()
	println("len0=", scatterarray·len(s))
	scatterarray·append(s, 10) -> s
	scatterarray·append(s, 20) -> s
	scatterarray·append(s, 30) -> s
	println("len3=", scatterarray·len(s))
	println("at1=", scatterarray·at(s, 1))
	scatterarray·set(s, 1, 99) -> s
	println("at1_after=", scatterarray·at(s, 1))
	a:[]int64 = [10, 20, 30, 40, 50]
	b = compactarray·newslice(a, 1, 4)
	println("slice=", b[0], b[1], b[2], compactarray·numel(b))
}
