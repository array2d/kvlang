// Variant A: target() returns 1; worker() loops writing target() to /live/val.
rwfunc target() -> (r:int64) {
    r = 1
}

rwfunc worker() -> () {
    while (true) {
        i = 0
        while (i < 64) {
            target() -> v
            i + 1 -> i
        }
        kvspace·set("/live/val", v)
    }
}
