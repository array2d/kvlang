flowchart LR
  subgraph RWIR["RWIR plaintext in kvspace"]
    OPERATION_NAME["operation name"]
    READ_PARAMETER["Read parameter<br/>type plus name plus key"]
    WRITE_PARAMETER["Write parameter<br/>type plus name plus key"]
  end

  subgraph SPECIFICATION["Canonical specification"]
    OPID["stable opid"]
    READ_ARGIDX["Read argidx and permission"]
    WRITE_ARGIDX["Write argidx and permission"]
    ALIAS_POLICY["explicit Read and Write alias policy"]
  end

  VMKV["vmkv<br/>validate and dereference static keys"]

  subgraph BINRWIR["Process-local BinRWIR"]
    BINARY_OPERATION["opid only"]
    READ_ARGUMENT["Read argidx plus uint64 argaddr"]
    WRITE_ARGUMENT["Write argidx plus uint64 argaddr"]
  end

  BODY["one authoritative kvspace V.body<br/>same nonzero 64-bit address"]
  VMBIN["vmbin<br/>direct load and store<br/>no value cache or register file"]
  JIT["internal JIT current instruction<br/>speculative register and spill state<br/>alias reads observe speculative writes"]
  COMPLETION{"Logical instruction<br/>fully completed?"}
  COMMIT["COMMIT_COMPLETED_STATE<br/>materialize all aliased dirty values<br/>then advance checkpoint"]
  DISCARD["DISCARD_INCOMPLETE_STATE<br/>drop partial register and spill state<br/>no body write or checkpoint advance"]
  DYNAMIC["dynamic map or struct key<br/>UNSUPPORTED before lifecycle ABI<br/>no zero address or fallback"]

  OPERATION_NAME --> VMKV
  READ_PARAMETER --> VMKV
  WRITE_PARAMETER --> VMKV
  OPID --> VMKV
  READ_ARGIDX --> VMKV
  WRITE_ARGIDX --> VMKV
  ALIAS_POLICY --> VMKV
  VMKV --> BINARY_OPERATION
  VMKV --> READ_ARGUMENT
  VMKV --> WRITE_ARGUMENT
  READ_ARGUMENT -->|"same argaddr"| BODY
  WRITE_ARGUMENT -->|"same argaddr"| BODY
  READ_ARGIDX -. "Read only" .-> READ_ARGUMENT
  WRITE_ARGIDX -. "Write only" .-> WRITE_ARGUMENT
  ALIAS_POLICY -. "permits equal addresses" .-> BODY
  BODY -->|"later Read observes prior Write"| VMBIN
  BODY -->|"initial Read through argaddr"| JIT
  JIT --> COMPLETION
  COMPLETION -->|"yes: mandatory observable boundary"| COMMIT --> BODY
  COMPLETION -->|"no: guard failure, error, recovery, or resume"| DISCARD
  VMKV -->|"address lifetime cannot be proven"| DYNAMIC

  classDef plaintext fill:#fef3c7,stroke:#d97706,color:#451a03
  classDef read fill:#dbeafe,stroke:#2563eb,color:#172554
  classDef write fill:#fee2e2,stroke:#dc2626,color:#450a0a
  classDef shared fill:#dcfce7,stroke:#16a34a,color:#052e16
  classDef unsupported fill:#f3f4f6,stroke:#4b5563,color:#111827
  class OPERATION_NAME,READ_PARAMETER,WRITE_PARAMETER,OPID,READ_ARGIDX,WRITE_ARGIDX,ALIAS_POLICY plaintext
  class READ_ARGUMENT read
  class WRITE_ARGUMENT write
  class BODY,VMBIN,JIT,COMPLETION,COMMIT shared
  class DYNAMIC,DISCARD unsupported
