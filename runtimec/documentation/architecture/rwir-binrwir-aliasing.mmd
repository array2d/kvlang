flowchart LR
  subgraph Specification["Specification identity"]
    CAPABILITY["one myrwircap record"]
    RWIR_IDENTIFIER["explicit stable RWIR operation identifier"]
    CANONICAL_IDENTIFIER["one canonical BinRWIR operation identifier"]
    SIGNATURE["Read and Write signature plus alias policy"]
    CAPABILITY --> RWIR_IDENTIFIER
    CAPABILITY --> CANONICAL_IDENTIFIER
    CAPABILITY --> SIGNATURE
  end

  VMKV["vmkv equivalent emission"]

  subgraph Canonical["Top-level canonical BinRWIR"]
    INSTRUCTION["instruction operation_code<br/>stable canonical identifier"]
    READ_REFERENCE["Read reference"]
    WRITE_REFERENCE["Write reference"]
  end

  subgraph Binding["Execution binding"]
    READ_BINDING["Read Binding"]
    WRITE_BINDING["Write Binding"]
    CELL["Canonical Cell<br/>value and mutation version"]
  end

  COMPILER["BinRWIR Compiler<br/>plan preserves dependencies"]
  EXECUTION["vmjit_execute or vmbin_execute<br/>same observable ordering"]

  RWIR_IDENTIFIER --> VMKV
  CANONICAL_IDENTIFIER --> VMKV
  SIGNATURE --> VMKV
  VMKV --> INSTRUCTION
  VMKV --> READ_REFERENCE
  VMKV --> WRITE_REFERENCE
  READ_REFERENCE --> READ_BINDING --> CELL
  WRITE_REFERENCE --> WRITE_BINDING --> CELL
  SIGNATURE -. "explicit alias permission" .-> READ_BINDING
  SIGNATURE -. "explicit alias permission" .-> WRITE_BINDING
  INSTRUCTION --> COMPILER
  READ_REFERENCE --> COMPILER
  WRITE_REFERENCE --> COMPILER
  COMPILER --> EXECUTION
  CELL -. "later Read observes ordered Write" .-> EXECUTION

  classDef specification fill:#fef3c7,stroke:#d97706,color:#451a03
  classDef read fill:#dbeafe,stroke:#2563eb,color:#172554
  classDef write fill:#fee2e2,stroke:#dc2626,color:#450a0a
  classDef shared fill:#dcfce7,stroke:#16a34a,color:#052e16
  class CAPABILITY,RWIR_IDENTIFIER,CANONICAL_IDENTIFIER,SIGNATURE specification
  class READ_REFERENCE,READ_BINDING read
  class WRITE_REFERENCE,WRITE_BINDING write
  class CELL shared
