flowchart LR
  SPECIFICATION["specification<br/>operation name, opid, argidx, signature"]
  INTERFACE["public interface"]
  ROUTE["engine route"]
  REPOSITORY["compilation repository<br/>address-qualified lease"]
  HOST["host services<br/>RWIR load and static key dereference<br/>return XValue base only; no body offset choice"]
  KVSPACE["external kvspace<br/>RWIR and XValue base<br/>fixed 8-byte head then authoritative V.body"]
  VMKV["vmkv<br/>only owner of checked xvalue_address + 8<br/>addressed BinRWIR emission or fail closed"]
  BINRWIR["top-level process-local BinRWIR<br/>opid plus argidx and uint64 argaddr"]
  VMBIN["vmbin<br/>address-driven memory executor"]

  subgraph BINRWIR_COMPILER["binrwir_compiler"]
    COMPILER["compiler and address-preserving optimization"]
    subgraph JIT["internal JIT"]
      JIT_COMPILER["verifier, lowering, and register allocation"]
      BACKENDS["x86_64 and AArch64 backends"]
      JIT_SAFEPOINT["mandatory instruction-completion boundary<br/>commit completed or discard incomplete"]
      JIT_EXECUTOR["machine-code executor<br/>speculative register and spill state"]
      DISCARDED["discarded incomplete state<br/>no argaddr write and no checkpoint advance"]
      JIT_COMPILER --> BACKENDS
      JIT_EXECUTOR --> JIT_SAFEPOINT
      JIT_SAFEPOINT -->|"DISCARD_INCOMPLETE_STATE"| DISCARDED
    end
    COMPILER --> JIT_COMPILER
  end

  INTERFACE --> ROUTE
  ROUTE --> HOST
  ROUTE --> REPOSITORY
  ROUTE --> VMKV
  ROUTE --> COMPILER
  ROUTE --> BINRWIR
  ROUTE --> JIT_EXECUTOR
  ROUTE --> VMBIN
  HOST --> KVSPACE
  VMKV --> SPECIFICATION
  VMKV -->|"request static key dereference"| HOST
  HOST -->|"nonzero uint64 xvalue_address"| VMKV
  VMKV --> BINRWIR
  COMPILER --> BINRWIR
  REPOSITORY --> COMPILER
  VMBIN --> BINRWIR
  JIT_COMPILER --> BINRWIR
  JIT_EXECUTOR --> BINRWIR
  VMBIN -. "direct final argaddr load and store; no XValue or body cache" .-> KVSPACE
  JIT_SAFEPOINT -. "COMMIT_COMPLETED_STATE only after full instruction completion" .-> KVSPACE

  BINRWIR -. "forbidden ownership dependency" .-> VMBIN
  BINRWIR -. "forbidden ownership dependency" .-> JIT
  VMKV -. "forbidden execution dependency" .-> VMBIN
  VMKV -. "forbidden execution dependency" .-> JIT
  VMBIN -. "forbidden peer dependency" .-> JIT
  JIT -. "forbidden peer dependency" .-> VMBIN
  REPOSITORY -. "forbidden execution dependency" .-> VMBIN
  REPOSITORY -. "forbidden execution dependency" .-> JIT_EXECUTOR

  classDef specification fill:#fff3cd,stroke:#9a6700,color:#3d2e00
  classDef neutral fill:#ede9fe,stroke:#7c3aed,color:#2e1065
  classDef compiler fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
  classDef executor fill:#ecfdf5,stroke:#059669,color:#052e16
  class SPECIFICATION,KVSPACE specification
  class BINRWIR neutral
  class VMKV,COMPILER,REPOSITORY,JIT_COMPILER,BACKENDS compiler
  class VMBIN,JIT_EXECUTOR,JIT_SAFEPOINT executor
  class DISCARDED neutral
