// 判据：非指针类型也能判空——`None` 在 kvspace 即「无值」，键不存在就读回 None，
// 与值的类型无关。依据：03-类型系统/16-ptr 的「None 判据」条款。
//
// 本条只验**非指针判空**这一个缺口。同文件里的动态键语义拆到 dynamic_key.kv：
// 两者彼此独立，混在一条里，谁修好了都看不出来。
//
// 期望阻塞: 非指针判空需要 nonnull 能力（尚未实现）
rwfunc test() -> () {
	m:[]char/utf8·int64 = {}
	k = "a"
	10 -> m·*k
	println(m·k == None)
}
