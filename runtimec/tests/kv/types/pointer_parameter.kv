// 判据：issue #286 的当前形态——地址形参体内不可再解引用。
// p:*int64 在体内是地址值；先 p -> local 再 *local 才取到目标。
// 若 #286 定稿为允许体内直接 *p，本用例的期望需重写。
// 依据：03-类型系统/16-ptr.kv、指令布局格式（地址形参两层路径）。
// 期望输出:
//   41
rwfunc read_target(p:*int64) -> (r:int64) {
	p -> local
	*local -> r
}

rwfunc test() -> () {
	x = 41
	read_target(&x) -> v
	println(v)
}
