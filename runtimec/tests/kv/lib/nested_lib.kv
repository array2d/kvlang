// 判据：嵌套 lib 的 pkg 以 / 累积，函数名以 · 附在末段；
// 调用名给出 /lib 之后的完整 key：outer/inner·add1。
// 若只取末段 lib 名，调用会找不到 /lib/outer/inner·add1。
// 依据：04-layout语义/11-lib与rwir数据.kv。
// 期望输出:
//   42
lib outer {
	lib inner {
		rwfunc add1(x:int64) -> (r:int64) {
			x + 1 -> r
		}
	}
}

rwfunc test() -> () {
	println(outer/inner·add1(41))
}
