// 组件：specification/native_rwir_decls.kv
// 作用：native rwir 的签名声明，供 layout 在**构建期**编进二进制。
// 联系：真源是 specification/myrwircaps.c 的名字表 + five-language-behavior-matrix.md
//       的裁决；二者生成 rwir_catalog.def 的能力行，再由能力行生成本文件。
//       改签名要改真源，不改任何一份产物。本文件由
//       tools/architecture/generate_rwir_catalog.py 生成并由同一脚本校验。
// 约束：不让 layout 运行期访问 kvspace 读 /lib/<op>；也不在 layout 里手写第二份。
// 语法：与 rwfunc 同形的 rwir 声明，只差函数体——兑现方是 runtime。
//       每个参数/返回值必须带类型；裸 `#name`、`$name` 与旧写法 `name:` 都被拒绝。
// 统计：28 条声明（其余行的签名由 TypeSet 位或安装签名给出）。

rwir time·now() -> (*time #result0)
rwir time·sub(*time #argument0, *time #argument1) -> (*time/duration #result0)
rwir time·add(*time #argument0, *time/duration #argument1) -> (*time #result0)
rwir time·before(*time #argument0, *time #argument1) -> (*bool #result0)
rwir time·after(*time #argument0, *time #argument1) -> (*bool #result0)
rwir time/duration·nanos(*int64 #argument0) -> (*time/duration #result0)
rwir time/duration·millis(*int64 #argument0) -> (*time/duration #result0)
rwir time/duration·seconds(*int64 #argument0) -> (*time/duration #result0)
rwir time/duration·minutes(*int64 #argument0) -> (*time/duration #result0)
rwir time/duration·hours(*int64 #argument0) -> (*time/duration #result0)
rwir time/duration·as_nanos(*time/duration #argument0) -> (*int64 #result0)
rwir time/duration·as_millis(*time/duration #argument0) -> (*int64 #result0)
rwir time/duration·as_seconds(*time/duration #argument0) -> (*int64 #result0)
rwir time/duration·as_minutes(*time/duration #argument0) -> (*int64 #result0)
rwir time/duration·as_hours(*time/duration #argument0) -> (*int64 #result0)
rwir time/duration·add(*time/duration #argument0, *time/duration #argument1) -> (*time/duration #result0)
rwir time/duration·sub(*time/duration #argument0, *time/duration #argument1) -> (*time/duration #result0)
rwir time/duration·before(*time/duration #argument0, *time/duration #argument1) -> (*bool #result0)
rwir time/duration·after(*time/duration #argument0, *time/duration #argument1) -> (*bool #result0)
rwir vthread·create(*char/utf8 #argument0) -> (*char/utf8 #result0)
rwir vthread·run(*char/utf8 #argument0) -> ()
rwir vthread·call(*char/utf8 #argument0) -> ()
rwir vthread·sleep(*time/duration #argument0) -> ()
rwir vthread·setstatus(*char/utf8 #argument0) -> ()
rwir vthread·pc() -> (*int32 #result0, *[2]int32 #result1)
rwir random·uint64() -> (*uint64 #result0)
rwir random·int63() -> (*int64 #result0)
rwir random·intn(*int64 #argument0) -> (*uint64 #result0)
