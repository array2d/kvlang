/*
 * 组件：specification/rwir_catalog.def
 * 作用：myrwircap 的唯一 capability manifest —— 一行一个语义算子。
 * 联系：surface 名字到本表行的映射在 rwir_alias_table.def；两表都由
 *       tools/architecture/generate_rwir_catalog.py 生成并校验。
 * 约束：opid 与 identifier 显式分配，不来自数组下标、文件顺序或声明顺序；
 *       读写掩码是 TypeSet 位集，不是占位串，不含 wildcard；未获得矩阵决策的
 *       能力不进入本文件，记录在 rwir_catalog_gaps.md。
 * 掩码位：0 int8，1 int16，2 int32，3 int64，4 uint8，5 uint16，6 uint32，
 *       7 uint64，8 float32，9 float64，10 bool，11 char/utf8，12 char/utf32，
 *       13 char/ascii，14 array，15 stringkeymap，16 structref，17 ext，
 *       18 pointer；19 位以上保留且必须为零。
 * 掩码零：该行不在标量 union 通道。parameterized 行的参数与结果类型由
 *       /lib/<operator> 的 def rwir 槽在安装时声明（唯一签名来源，禁止在本表
 *       复制第二张签名表）；ResultRule IDENTITY 表示结果类型取安装签名，
 *       不是 wildcard。control 行不产生值。
 * 统计：注册表 316 个 surface 名字 → 315 条别名映射；
 *       120 条同名映射，195 条别名；能力行 130 条，待裁 0 条。
 *
 * 已退役（编号永久保留，不复用、不重编号）：
 *   0x0028 OBJECT_LITERAL —— 具名容器字面量统一走 map·new（map/struct/scatterarray 本质是键值组）；obj 为其别名，一并退役
 */
#ifndef RUNTIMEC_RWIR_OPERATION
#error "Define RUNTIMEC_RWIR_OPERATION before including rwir_catalog.def"
#endif

/* RUNTIMEC_RWIR_OPERATION(identifier, operator, opid,
 *                        read_union_mask, write_union_mask,
 *                        constraint, result_rule, alias_policy, behavior_decisions)
 *
 * Constraint    : RUNTIMEC_RWIR_CONSTRAINT_{NONE,SAME_CLASS,NUMERIC_COMPATIBLE,
 *                 NUMERIC_COMPARE}
 * ResultRule    : RUNTIMEC_RWIR_RESULT_{NONE,SAME_FIRST,SAME_SECOND,WIDEN,
 *                 WIDEN_INTEGER,BOOLEAN,FLOAT64,TARGET_TYPE,IDENTITY,CHARACTER_UTF8}
 * AliasPolicy   : RUNTIMEC_RWIR_ALIAS_{FORBIDDEN,DECLARED}
 * behavior_decisions: 一个或多个逗号分隔的矩阵决策；第一个是该行的主决策。
 */
/* behavior-decision: read-write-alias */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_COPY, "copy", 0x0001,
                        0x00000000, 0x00000000,
                        RUNTIMEC_RWIR_CONSTRAINT_NONE,
                        RUNTIMEC_RWIR_RESULT_IDENTITY,
                        RUNTIMEC_RWIR_ALIAS_DECLARED,
                        "read-write-alias")  /* install signature -> install signature */
/* behavior-decision: mixed-precision-promotion-order-independent */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_ADD, "add", 0x0002,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent")  /* number -> number */
/* behavior-decision: mixed-precision-promotion-order-independent */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_SUB, "sub", 0x0003,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent")  /* number -> number */
/* behavior-decision: mixed-precision-promotion-order-independent */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_MUL, "mul", 0x0004,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent")  /* number -> number */
/* behavior-decision: mixed-precision-promotion-order-independent */
/* behavior-decision: signed-integer-division */
/* behavior-decision: float-division-by-zero */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_DIV, "div", 0x0005,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent,signed-integer-division,float-division-by-zero")  /* number -> number */
/* behavior-decision: mixed-precision-promotion-order-independent */
/* behavior-decision: integer-remainder-sign */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_MOD, "mod", 0x0006,
                        0x000000FF, 0x000000FF,
                        RUNTIMEC_RWIR_CONSTRAINT_SAME_CLASS,
                        RUNTIMEC_RWIR_RESULT_WIDEN_INTEGER,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent,integer-remainder-sign")  /* integer -> integer */
/* behavior-decision: mixed-precision-promotion-order-independent */
/* behavior-decision: floating-min-max-nan */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_MAX, "max", 0x0007,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent,floating-min-max-nan")  /* number -> number */
/* behavior-decision: mixed-precision-promotion-order-independent */
/* behavior-decision: floating-min-max-nan */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_MIN, "min", 0x0008,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NUMERIC_COMPATIBLE,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-precision-promotion-order-independent,floating-min-max-nan")  /* number -> number */
/* behavior-decision: signed-neg-abs-sign */
/* behavior-decision: unsigned-neg-abs-sign */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_ABSOLUTE, "abs", 0x0009,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NONE,
                        RUNTIMEC_RWIR_RESULT_SAME_FIRST,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "signed-neg-abs-sign,unsigned-neg-abs-sign")  /* number -> number */
/* behavior-decision: signed-neg-abs-sign */
/* behavior-decision: unsigned-neg-abs-sign */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_NEGATION, "neg", 0x000A,
                        0x000003FF, 0x000003FF,
                        RUNTIMEC_RWIR_CONSTRAINT_NONE,
                        RUNTIMEC_RWIR_RESULT_SAME_FIRST,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "signed-neg-abs-sign,unsigned-neg-abs-sign")  /* number -> number */
/* behavior-decision: signed-neg-abs-sign */
/* behavior-decision: unsigned-neg-abs-sign */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_SIGN, "sign", 0x000B,
