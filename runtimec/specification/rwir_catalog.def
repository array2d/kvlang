                        RUNTIMEC_RWIR_CONSTRAINT_SAME_CLASS,
                        RUNTIMEC_RWIR_RESULT_WIDEN,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "mixed-signed-unsigned-arithmetic")  /* integer -> integer */
/* behavior-decision: mixed-signed-unsigned-arithmetic */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_BITWISE_OR, "bitor", 0x000D,
                        0x000000FF, 0x000000FF,
                        RUNTIMEC_RWIR_CONSTRAINT_SAME_CLASS,
