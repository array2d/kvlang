                        RUNTIMEC_RWIR_RESULT_FLOAT64,
                        RUNTIMEC_RWIR_ALIAS_FORBIDDEN,
                        "float-transcendental-result-kind")  /* number -> float64 */
/* behavior-decision: mixed-numeric-equality */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_EQUAL, "eq", 0x0015,
                        0x000003FF, 0x00000400,
                        RUNTIMEC_RWIR_CONSTRAINT_NONE,
                        RUNTIMEC_RWIR_RESULT_BOOLEAN,
