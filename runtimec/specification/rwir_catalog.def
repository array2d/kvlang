/* behavior-decision: shift-count-masking */
/* behavior-decision: mixed-signed-unsigned-arithmetic */
RUNTIMEC_RWIR_OPERATION(RUNTIMEC_RWIR_SHIFT_LEFT, "shl", 0x000F,
