/*
 * 组件：specification/rwir_alias_table.def
 * 作用：surface 名字 -> capability row 的唯一映射（数据，不是能力行）。
 * 约束：每个注册名恰好一条记录；名字相同不代表语义相同，语义只由 rwir_catalog.def
 *       的行定义。rwir_catalog.def 是唯一签名来源，本表不携带类型。
 * 特化：RUNTIMEC_RWIR_SPECIALIZATION 声明编译器按操作数静态类型改选的行；
 *       invert 为真时结果取反（`!=` 的字符/指针/布尔比较）。
 * 统计：319 个注册 surface 名字，318 条别名映射，7 条特化。
 */
#ifndef RUNTIMEC_RWIR_ALIAS
#error "Define RUNTIMEC_RWIR_ALIAS before including rwir_alias_table.def"
#endif
#ifndef RUNTIMEC_RWIR_SPECIALIZATION
#error "Define RUNTIMEC_RWIR_SPECIALIZATION before including rwir_alias_table.def"
#endif

/* RUNTIMEC_RWIR_ALIAS(surface_name, capability_identifier) */
RUNTIMEC_RWIR_ALIAS("!", RUNTIMEC_RWIR_LOGICAL_NOT)
RUNTIMEC_RWIR_ALIAS("!=", RUNTIMEC_RWIR_NOT_EQUAL)
RUNTIMEC_RWIR_ALIAS("%", RUNTIMEC_RWIR_MOD)
RUNTIMEC_RWIR_ALIAS("&", RUNTIMEC_RWIR_BITWISE_AND)
RUNTIMEC_RWIR_ALIAS("&&", RUNTIMEC_RWIR_LOGICAL_AND)
RUNTIMEC_RWIR_ALIAS("+", RUNTIMEC_RWIR_ADD)
RUNTIMEC_RWIR_ALIAS("-", RUNTIMEC_RWIR_SUB)
RUNTIMEC_RWIR_ALIAS("<", RUNTIMEC_RWIR_LESS)
RUNTIMEC_RWIR_ALIAS("<<", RUNTIMEC_RWIR_SHIFT_LEFT)
RUNTIMEC_RWIR_ALIAS("<=", RUNTIMEC_RWIR_LESS_EQUAL)
RUNTIMEC_RWIR_ALIAS("=", RUNTIMEC_RWIR_COPY)
RUNTIMEC_RWIR_ALIAS("==", RUNTIMEC_RWIR_EQUAL)
RUNTIMEC_RWIR_ALIAS(">", RUNTIMEC_RWIR_GREATER)
RUNTIMEC_RWIR_ALIAS(">=", RUNTIMEC_RWIR_GREATER_EQUAL)
RUNTIMEC_RWIR_ALIAS(">>", RUNTIMEC_RWIR_SHIFT_RIGHT)
RUNTIMEC_RWIR_ALIAS("^", RUNTIMEC_RWIR_BITWISE_XOR)
RUNTIMEC_RWIR_ALIAS("abs", RUNTIMEC_RWIR_ABSOLUTE)
