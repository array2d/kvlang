// 组件：binir/runtimec_v9_binir_string
// 作用：v9 的 binir 指令——字符串，一行一条。
// 生成：由 generate_v9_binir.py 从 ../rwir/runtimec_rwircap.kv 展开，勿手改。
// 操作数：二进制指针，按所指值的宽度写 uint8（1 字节）/ [N]uint8（N=2、4、8）/
//       []uint8（变长字节）；不写 *，binir 没有 langtype。
// 命名：<算子>_<payload 类型序列>，同型也写全；payload 顺序 = 声明顺序（读在前、写在后），
//       bin 层不再区分读写；opid 见 runtimec_v9_binir_opids.yml。
//       opid 是 runtimec 私有编号，从 1 按产物顺序递增。
// 规模：10 条。
binir string·set([8]uint8 #index, []uint8 #value, []uint8 #text)
binir string·char([]uint8 #text, [8]uint8 #index, []uint8 #character)
binir string·ord([]uint8 #text, [8]uint8 #code)
binir string·find([]uint8 #text, []uint8 #pattern, [8]uint8 #position)
binir string·len([]uint8 #text, [8]uint8 #length)
binir string·formatint([8]uint8 #value, [8]uint8 #base, []uint8 #text)
binir string·formatuint([8]uint8 #value, [8]uint8 #base, []uint8 #text)
binir string·parseint([]uint8 #text, [8]uint8 #value)
binir string·parseuint([]uint8 #text, [8]uint8 #value)
binir string·parsefloat([]uint8 #text, [8]uint8 #value)
