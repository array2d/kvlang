// 组件：binir/runtimec_v9_binir_unary
// 作用：v9 的 binir 指令——绝对值、取反、符号、平方根、指数、对数、幂，一行一条。
// 生成：由 generate_v9_binir.py 从 ../rwir/runtimec_rwircap.kv 展开，勿手改。
// 操作数：二进制指针，按所指值的宽度写 uint8（1 字节）/ [N]uint8（N=2、4、8）/
//       []uint8（变长字节）；不写 *，binir 没有 langtype。
// 命名：<算子>_<payload 类型序列>，同型也写全；payload 顺序 = 声明顺序（读在前、写在后），
//       bin 层不再区分读写；opid 见 runtimec_v9_binir_opids.yml。
//       opid 是 runtimec 私有编号，从 1 按产物顺序递增。
// 规模：160 条。
binir abs_float32_float32([4]uint8 #value, [4]uint8 #result)
binir abs_float64_float64([8]uint8 #value, [8]uint8 #result)
binir abs_int16_int16([2]uint8 #value, [2]uint8 #result)
binir abs_int32_int32([4]uint8 #value, [4]uint8 #result)
binir abs_int64_int64([8]uint8 #value, [8]uint8 #result)
binir abs_int8_int8(uint8 #value, uint8 #result)
binir abs_uint16_uint16([2]uint8 #value, [2]uint8 #result)
binir abs_uint32_uint32([4]uint8 #value, [4]uint8 #result)
binir abs_uint64_uint64([8]uint8 #value, [8]uint8 #result)
binir abs_uint8_uint8(uint8 #value, uint8 #result)

