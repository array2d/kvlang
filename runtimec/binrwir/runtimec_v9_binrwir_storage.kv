// 组件：binrwir/runtimec_v9_binrwir_storage
// 作用：v9 的 binrwir 指令——存储，一行一条。
// 生成：由 generate_v9_binrwir.py 从 ../rwir/runtimec_rwircap.kv 展开，勿手改。
// 操作数：二进制指针，按所指值的宽度写 uint8（1 字节）/ [N]uint8（N=2、4、8）/
//       []uint8（变长字节）；不写 *，binrwir 没有 langtype。
// 命名：<算子>_<读参类型>_<写参类型>，同型也写全；opid 见 runtimec_v9_binrwir_opids.yml。
//       opid 是 runtimec 私有编号，从 1 按产物顺序递增。
// 规模：10 条。
rwir kvspace·del([]uint8 #key) -> ()
rwir kvspace·deltree([]uint8 #key) -> ()
rwir kvspace·cp([]uint8 #key) -> ([]uint8 #target)
rwir kvspace·cpdir([]uint8 #key) -> ([]uint8 #target)
rwir kvspace·cplist([]uint8 #key, []uint8 #other) -> ()
rwir kvspace·listlen([]uint8 #key) -> ([8]uint8 #count)
rwir kvspace·listat([]uint8 #key, [8]uint8 #index) -> ([]uint8 #value)
rwir kvspace·mkindex([]uint8 #key) -> ()
rwir kvspace·delextindex([]uint8 #key) -> ()
rwir kvspace·watch([]uint8 #key) -> ()
