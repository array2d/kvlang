prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@/pathspace
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: pathspace
Description: PathSpace storage ABI (single library: shm engine + XValue byte layer; see pathlang for language layer)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lpathspace
Cflags: -I${includedir}
