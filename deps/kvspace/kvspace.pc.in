prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@/kvspace
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: kvspace
Description: KVSpace 存储 ABI（单库：shm 引擎 + XValue 字节层；语言层见 kvlang）
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkvspace
Cflags: -I${includedir}
