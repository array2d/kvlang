
rwfunc test() -> () {
	"GGTATTGAGCACTGGCAATTGACGTCAGGTATCCGAATTGCACGTTAGCATGCATGCATGCACGT" -> base:[]char/utf32
	"" -> s:[]char/utf32
	0 -> r:int64
	while (r < __SCALE__) {
		s + base -> s:[]char/utf32
		r + 1 -> r:int64
	}
	string·len(s) -> n:int64
	h:'int64'int64 = {}
	t0:time = time·now()
	0 -> i:int64
	while (i < n) {
		string·char(s, i) -> ch:char/utf32
		string·ord(ch) -> c:int64
		if (h·*c != None) {
			h·*c -> cur:int64
		} else {
			0 -> cur:int64
		}
		cur + 1 -> cnt:int64
		cnt -> h·*c
		i + 1 -> i:int64
	}
	t1:time = time·now()
	h·65 -> a:int64
	h·67 -> cc:int64
	h·71 -> g:int64
	h·84 -> t:int64
	println("knuc: A =", a, "C =", cc, "G =", g, "T =", t)
	delta:time/duration = time·sub(t1, t0)
	ns:int64 = time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
	println("__bench_input: rep=__SCALE__")
}
