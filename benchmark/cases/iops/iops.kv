
rwfunc iops(*int64 #n) -> (*int64 #a) {
	*a = 0
	1 -> i:int64
	while (i <= *n) {
		*a = *a + 1
		i = i + 1
	}
}

rwfunc test() -> () {
	t0:time = time·now()
	iops(__SCALE__) -> ans:int64
	t1:time = time·now()
	println("iops a =", ans)
	delta:time/duration = time·sub(t1, t0)
	ns:int64 = time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
	println("__bench_input: N=__SCALE__")
}
