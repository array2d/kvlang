
rwfunc test() -> () {
	__SCALE__ -> n:int64
	h:'[int64]'int64 = {}
	t0:time = time·now()
	0 -> i:int64
	while (i < n) {
		i × 2654435761 -> k0:int64
		k0 % 100003 -> key:int64
		i -> h·*key
		i + 1 -> i
	}
	0 -> sum:int64
	0 -> hits:int64
	0 -> i:int64
	while (i < n) {
		i × 2654435761 -> k0:int64
		k0 % 100003 -> key:int64
		h·*key != None -> ex:bool
		if (ex) {
			hits + 1 -> hits
			h·*key -> v:int64
			sum + v -> sum
		}
		i + 1 -> i
	}
	t1:time = time·now()
	println("hash: hits =", hits, "sum =", sum)
	delta:time/duration = time·sub(t1, t0)
	ns:int64 = time/duration·as_nanos(delta)
	println("__bench_ns:", ns)
	println("__bench_input: N=__SCALE__")
}
