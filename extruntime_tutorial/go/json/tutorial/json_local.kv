
struct Profile {
	name:[]char/utf32=""
	age:int64=0
	active:bool=false
	score:float64=0.0
	nums:[3]int64=[0, 0, 0]
}

rwfunc test() -> () {
	profile:Profile = {name="alice" age=42 active=true score=3.14 nums=[1, 2, 3]}
	json·to(profile) -> j1
	println("profile =", j1)

	a:'[int64]'int64 = {10, 20, 30}
	json·to(a) -> j2
	println("map =", j2)

	tags:'[int64]'[]char/utf32 = {"a", "b", "c"}
	json·to(tags) -> j3
	println("tags =", j3)
}
