
rwfunc test() -> () {
	/data:'[]char/utf8'int64 = {}
	/data·grp:'[]char/utf8'int64 = {}
	/data·nested:'[]char/utf8'int64 = {}
	/data·nested·level1:'[]char/utf8'int64 = {}
	42 -> /data·age
	"alice" -> /data·name
	3.14 -> /data·score
	true -> /data·active
	1 -> /data·grp·c
	2 -> /data·grp·d
	"deep" -> /data·nested·level1·level2
	3 -> /data·nested·level1·count
	[true, false, true] -> /data·nested·level1·flags
	[1, 2, 3] -> /data·nested·list
	a:[]int64 = [10, 20, 30]
	[10, 20, 30] -> /data·cont
	scatterarray·newscatter(a) -> /data·scat
	json·to(/data) -> j
	println("j =", j)
	json·from(j) -> /data2
	println("name =", /data2·name)
	println("c =", /data2·grp·c)
	println("cont =", /data2·cont·[0], /data2·cont·[1], /data2·cont·[2])
	println("scat =", /data2·scat·[0], /data2·scat·[1], /data2·scat·[2])
	compactarray·numel(/data2·cont) -> n1:int64
	compactarray·numel(/data2·scat) -> n2:int64
	println("len =", n1, n2)
	println("level2 =", /data2·nested·level1·level2)
	println("count =", /data2·nested·level1·count)
	println("flags =", /data2·nested·level1·flags·[0], /data2·nested·level1·flags·[1], /data2·nested·level1·flags·[2])
	println("list =", /data2·nested·list·[0], /data2·nested·list·[1], /data2·nested·list·[2])
}
