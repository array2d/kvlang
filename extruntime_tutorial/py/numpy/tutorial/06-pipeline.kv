
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> a
		numpy.reshape(a, [2, 3]) -> w
		numpy.print("W:", w)
		numpy.arange(3) -> x
		numpy.print("x:", x)
		numpy.matmul(w, x) -> wx
		numpy.print("W.x:", wx)
		numpy.ones([2]) -> b
		numpy.add(wx, b) -> z
		numpy.print("z = W.x + b:", z)
		numpy.zeros([2]) -> zero
		numpy.maximum(z, zero) -> y
		numpy.print("y = relu(z):", y)
		numpy.sum(y) -> total
		numpy.print("sum(y):", total)
		numpy.mean(y) -> avg
		numpy.print("mean(y):", avg)
	}
}
demo.main()
