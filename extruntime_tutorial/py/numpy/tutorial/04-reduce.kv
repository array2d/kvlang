
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> r
		numpy.reshape(r, [2, 3]) -> m
		numpy.print("m:", m)
		numpy.sum(m) -> s
		numpy.print("sum:", s)
		numpy.prod(m) -> p
		numpy.print("prod:", p)
		numpy.max(m) -> mx
		numpy.print("max:", mx)
		numpy.min(m) -> mn
		numpy.print("min:", mn)
		a:[]float64 = [1.0, 2.0, 3.0, 4.0]
		numpy.mean(a) -> me
		numpy.print("mean:", me)
	}
}
demo.main()
