
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> r
		numpy.reshape(r, [2, 3]) -> m
		numpy.print("m:", m)
		numpy.transpose(m) -> t
		numpy.print("transpose:", t)
		numpy.ravel(t) -> f
		numpy.print("ravel:", f)
		a:[]int64 = [1, 2, 3]
		b:[]int64 = [4, 5, 6]
		numpy.concatenate(a, b) -> c
		numpy.print("concatenate:", c)
		numpy.stack(a, b) -> s
		numpy.print("stack:", s)
	}
}
demo.main()
