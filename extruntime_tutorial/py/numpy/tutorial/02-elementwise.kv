
lib demo {
	rwfunc main() -> () {
		a:[]float64 = [1.0, 2.0, 3.0, 4.0]
		b:[]float64 = [4.0, 3.0, 2.0, 1.0]
		numpy.add(a, b) -> s
		numpy.print("add:", s)
		numpy.sub(a, b) -> d
		numpy.print("sub:", d)
		numpy.mul(a, b) -> p
		numpy.print("mul:", p)
		numpy.div(a, b) -> q
		numpy.print("div:", q)
		numpy.maximum(a, b) -> mx
		numpy.print("maximum:", mx)
		numpy.neg(a) -> n
		numpy.print("neg:", n)
		numpy.sqrt(a) -> r
		numpy.print("sqrt:", r)
		numpy.pow(a, 2.0) -> sq
		numpy.print("pow2:", sq)
	}
}
demo.main()
