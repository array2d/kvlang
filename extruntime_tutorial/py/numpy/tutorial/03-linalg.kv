
lib demo {
	rwfunc main() -> () {
		numpy.arange(6) -> r
		numpy.reshape(r, [2, 3]) -> a
		numpy.print("a:", a)
		numpy.reshape(r, [3, 2]) -> b
		numpy.print("b:", b)
		numpy.matmul(a, b) -> c
		numpy.print("matmul:", c)
		u:[]float64 = [1.0, 2.0, 3.0]
		v:[]float64 = [4.0, 5.0, 6.0]
		numpy.dot(u, v) -> d
		numpy.print("dot:", d)
	}
}
demo.main()
