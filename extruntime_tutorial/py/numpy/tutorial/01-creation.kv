
lib demo {
	rwfunc main() -> () {
		numpy.zeros([2, 3]) -> z
		numpy.print("zeros:", z)
		numpy.ones([3]) -> o
		numpy.print("ones:", o)
		numpy.full([2, 2], 5.0) -> f
		numpy.print("full:", f)
		numpy.eye(3) -> i
		numpy.print("eye:", i)
		numpy.arange(5) -> r
		numpy.print("arange:", r)
		numpy.linspace(0.0, 1.0, 5) -> l
		numpy.print("linspace:", l)
	}
}
demo.main()
